<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Kom2go.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Kom2go.Views"
    Title="Kom2go">

    <TabBar>
        <ShellContent
            Title="Library"
            Icon="{OnPlatform Android=library.png, Default=''}"
            ContentTemplate="{DataTemplate views:LibraryPage}"
            Route="library" />
        
        <ShellContent
            Title="Komga"
            Icon="{OnPlatform Android=cloud.png, Default=''}"
            ContentTemplate="{DataTemplate views:KomgaPage}"
            Route="komga" />
    </TabBar>

</Shell>
