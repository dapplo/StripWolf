<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Kom2go.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Kom2go.Views.ReaderView"
             x:DataType="vm:ReaderViewModel"
             Background="Black"
             x:Name="Root"
             Focusable="True">
  
  <Grid>
    <!-- Main Image View with scroll support -->
    <ScrollViewer x:Name="ImageScroller" 
                  HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Auto"
                  PointerWheelChanged="OnPointerWheelChanged"
                  PointerPressed="OnZoomPointerPressed"
                  PointerMoved="OnZoomPointerMoved"
                  PointerReleased="OnZoomPointerReleased">
      <!-- Container for zoomed content - allows full screen viewing -->
      <Canvas x:Name="ZoomCanvas" ClipToBounds="False">
        <Grid x:Name="ImageContainer" Canvas.Left="0" Canvas.Top="0">
          <!-- Two-page mode: shows two pages side by side when enabled -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="{Binding IsTwoPageMode}">
            <Image x:Name="LeftPageImage"
                   Source="{Binding LeftPageImage}"
                   Stretch="Uniform"/>
            <Image x:Name="RightPageImage"
                   Source="{Binding RightPageImage}"
                   Stretch="Uniform"
                   Margin="4,0,0,0"/>
          </StackPanel>
          
          <!-- Single-page mode -->
          <Image x:Name="PageImage"
                 Source="{Binding CurrentPageImage}" 
                 Stretch="Uniform"
                 IsVisible="{Binding !IsTwoPageMode}"/>
        </Grid>
      </Canvas>
    </ScrollViewer>

    <!-- Overlay for tap/swipe/pinch zones - handles both gestures and taps -->
    <Grid x:Name="TapZoneGrid" ColumnDefinitions="*,2*,*" Background="Transparent"
          PointerWheelChanged="OnPointerWheelChanged"
          PointerPressed="OnGesturePointerPressed"
          PointerMoved="OnGesturePointerMoved"
          PointerReleased="OnGesturePointerReleased">
      <!-- Left tap zone (25% width) - previous page (handled via swipe or press detection in code) -->
      <Border Grid.Column="0" x:Name="LeftZone" Background="Transparent" Cursor="Hand"/>
      
      <!-- Center tap zone (50% width) - toggle controls -->
      <Border Grid.Column="1" x:Name="CenterZone" Background="Transparent" Cursor="Hand"/>
      
      <!-- Right tap zone (25% width) - next page -->
      <Border Grid.Column="2" x:Name="RightZone" Background="Transparent" Cursor="Hand"/>
    </Grid>

    <!-- Loading Indicator -->
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"/>

    <!-- Error Message -->
    <Border Background="#FFEBEE" CornerRadius="8" Padding="12"
            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"/>
    </Border>

    <!-- Top Controls - animated visibility -->
    <Border VerticalAlignment="Top" Background="#E0000000" Padding="16"
            IsVisible="{Binding IsControlsVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <Button Grid.Column="0" Content="← Back" Command="{Binding GoBackCommand}" 
                Background="Transparent" Foreground="White"/>
        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="18" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="16,0"/>
        <!-- Info button -->
        <Button Grid.Column="2" Command="{Binding ToggleInfoPanelCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" 
                ToolTip.Tip="Show comic info (I)">
          <TextBlock Text="ℹ"/>
        </Button>
        <!-- Two-page mode toggle -->
        <Button Grid.Column="3" Command="{Binding ToggleTwoPageModeCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" 
                ToolTip.Tip="Toggle two-page mode (2)">
          <TextBlock Text="{Binding TwoPageModeIcon}"/>
        </Button>
        <!-- Stretch mode button -->
        <Button Grid.Column="4" Command="{Binding CycleStretchModeCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Change fit mode">
          <TextBlock Text="{Binding StretchModeIcon}"/>
        </Button>
        <!-- Fullscreen button -->
        <Button Grid.Column="5" Command="{Binding ToggleFullScreenCommand}"
                Background="Transparent" Foreground="White" FontSize="18" ToolTip.Tip="Toggle fullscreen (F)">
          <TextBlock Text="⛶"/>
        </Button>
      </Grid>
    </Border>

    <!-- Bottom Controls -->
    <Border VerticalAlignment="Bottom" Background="#E0000000" Padding="16"
            IsVisible="{Binding IsControlsVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto">
        <!-- Previous Button -->
        <Button Grid.Column="0" Content="◀" Command="{Binding GoToPreviousPageCommand}"
                IsEnabled="{Binding HasPreviousPage}" Background="Transparent" Foreground="White" FontSize="20"/>
        
        <!-- Page Slider -->
        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MaxSliderValue, FallbackValue=0}"
                Value="{Binding CurrentPage}" Margin="8,0"/>
        
        <!-- Next Button -->
        <Button Grid.Column="2" Content="▶" Command="{Binding GoToNextPageCommand}"
                IsEnabled="{Binding HasNextPage}" Background="Transparent" Foreground="White" FontSize="20"/>

        <!-- Page Display -->
        <TextBlock Grid.Column="3" Text="{Binding PageDisplay}" Foreground="White"
                   VerticalAlignment="Center" Margin="16,0"/>

        <!-- Zoom Controls -->
        <Button Grid.Column="4" Content="−" Command="{Binding ZoomOutCommand}"
                Background="Transparent" Foreground="White" FontSize="20" Width="40"/>
        
        <TextBlock Grid.Column="5" Text="{Binding ZoomDisplay}" Foreground="White"
                   VerticalAlignment="Center" Width="60" TextAlignment="Center"/>
        
        <Button Grid.Column="6" Content="+" Command="{Binding ZoomInCommand}"
                Background="Transparent" Foreground="White" FontSize="20" Width="40"/>

        <Button Grid.Column="7" Content="⟲" Command="{Binding ResetZoomCommand}"
                Background="Transparent" Foreground="White" FontSize="16" Width="40"
                ToolTip.Tip="Reset zoom"/>
      </Grid>
    </Border>

    <!-- Comic Info Panel - slides in from right -->
    <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="350"
            Background="#F0202020" Padding="16"
            IsVisible="{Binding IsInfoPanelVisible}">
      <Grid RowDefinitions="Auto,*">
        <!-- Header with close button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <TextBlock Text="Comic Information" Foreground="White" FontSize="18" FontWeight="Bold"
                     VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="White"
                  Command="{Binding ToggleInfoPanelCommand}" Padding="8,4"/>
        </Grid>
        
        <!-- Info Content -->
        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="12">
            <!-- Basic Info from Comic model -->
            <StackPanel Spacing="4">
              <TextBlock Text="Title" Foreground="Gray" FontSize="12"/>
              <TextBlock Text="{Binding Comic.Title}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            
            <StackPanel Spacing="4" IsVisible="{Binding Comic.SeriesName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="Series" Foreground="Gray" FontSize="12"/>
              <TextBlock Text="{Binding Comic.SeriesName}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            
            <StackPanel Spacing="4" IsVisible="{Binding Comic.Number, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="Issue Number" Foreground="Gray" FontSize="12"/>
              <TextBlock Text="{Binding Comic.Number}" Foreground="White" FontSize="14"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Pages" Foreground="Gray" FontSize="12"/>
              <TextBlock Text="{Binding Comic.PageCount}" Foreground="White" FontSize="14"/>
            </StackPanel>
            
            <StackPanel Spacing="4" IsVisible="{Binding Comic.Authors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="Authors" Foreground="Gray" FontSize="12"/>
              <TextBlock Text="{Binding Comic.Authors}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            
            <StackPanel Spacing="4" IsVisible="{Binding Comic.Publisher, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="Publisher" Foreground="Gray" FontSize="12"/>
              <TextBlock Text="{Binding Comic.Publisher}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            
            <StackPanel Spacing="4" IsVisible="{Binding Comic.ReleaseDate, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="Release Date" Foreground="Gray" FontSize="12"/>
              <TextBlock Text="{Binding Comic.ReleaseDate, StringFormat='{}{0:yyyy-MM-dd}'}" Foreground="White" FontSize="14"/>
            </StackPanel>
            
            <StackPanel Spacing="4" IsVisible="{Binding Comic.Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="Summary" Foreground="Gray" FontSize="12"/>
              <TextBlock Text="{Binding Comic.Summary}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- Extended ComicInfo.xml data -->
            <Border BorderThickness="0,1,0,0" BorderBrush="Gray" Margin="0,8,0,0" Padding="0,8,0,0"
                    IsVisible="{Binding ComicInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="12">
                <TextBlock Text="Extended Metadata (ComicInfo.xml)" Foreground="LightGray" FontSize="12" FontWeight="Bold"/>
                
                <StackPanel Spacing="4" IsVisible="{Binding ComicInfo.Volume, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="Volume" Foreground="Gray" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.Volume}" Foreground="White" FontSize="14"/>
                </StackPanel>
                
                <StackPanel Spacing="4" IsVisible="{Binding ComicInfo.Genre, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Genre" Foreground="Gray" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.Genre}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
                
                <StackPanel Spacing="4" IsVisible="{Binding ComicInfo.Characters, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Characters" Foreground="Gray" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.Characters}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
                
                <StackPanel Spacing="4" IsVisible="{Binding ComicInfo.Teams, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Teams" Foreground="Gray" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.Teams}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
                
                <StackPanel Spacing="4" IsVisible="{Binding ComicInfo.StoryArc, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Story Arc" Foreground="Gray" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.StoryArc}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
                
                <StackPanel Spacing="4" IsVisible="{Binding ComicInfo.LanguageISO, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Language" Foreground="Gray" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.LanguageISO}" Foreground="White" FontSize="14"/>
                </StackPanel>
                
                <StackPanel Spacing="4" IsVisible="{Binding ComicInfo.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Notes" Foreground="Gray" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.Notes}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
                
                <StackPanel Spacing="4" IsVisible="{Binding ComicInfo.Web, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Web" Foreground="Gray" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.Web}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>
            
            <!-- No ComicInfo.xml message -->
            <TextBlock Text="No extended metadata (ComicInfo.xml) available" Foreground="Gray" FontSize="12"
                       IsVisible="{Binding ComicInfo, Converter={x:Static ObjectConverters.IsNull}}"
                       Margin="0,16,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
