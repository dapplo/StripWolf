<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Kom2go.ViewModels"
             xmlns:models="using:Kom2go.Models"
             xmlns:converters="using:Kom2go.Converters"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Kom2go.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             x:Name="Root">
  
  <UserControl.Resources>
    <converters:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter"/>
  </UserControl.Resources>
  
  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="Library" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="📁 Open Folder" Command="{Binding OpenComicsDirectoryCommand}" 
                Padding="16,8" Margin="0,0,8,0" IsVisible="{Binding IsDesktop}"/>
        <Button Grid.Column="2" Content="Import" Click="OnImportClicked" Padding="16,8"/>
      </Grid>
    </Border>
    
    <!-- Content -->
    <ScrollViewer Grid.Row="1" Padding="16">
      <StackPanel Spacing="24">
        
        <!-- Search Box -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="🔍 Search comics..."
                   VerticalContentAlignment="Center"/>
          <Button Grid.Column="1" Content="✕" Command="{Binding ClearSearchCommand}" 
                  Padding="8,6" Margin="4,0,0,0"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>

        <!-- Search Results Section -->
        <StackPanel Spacing="8" IsVisible="{Binding IsSearching}">
          <TextBlock Text="Search Results" FontSize="18" FontWeight="Bold"/>
          
          <!-- No Results -->
          <TextBlock Text="No comics found" Foreground="Gray" 
                     IsVisible="{Binding !SearchResults.Count}" Margin="0,8"/>
          
          <!-- Results Grid -->
          <ItemsControl ItemsSource="{Binding SearchResults}" IsVisible="{Binding SearchResults.Count}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Comic">
                <Border Margin="0,0,12,12" CornerRadius="8" ClipToBounds="True" Width="150"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                  <Grid RowDefinitions="200,Auto,Auto,Auto">
                    <!-- Cover with click handler -->
                    <Button Grid.Row="0" Padding="0" Background="Transparent" Height="200"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).OpenComicCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <Border Background="Black" CornerRadius="8,8,0,0">
                        <Image Source="{Binding CoverPath, Converter={StaticResource FilePathToBitmapConverter}}" Stretch="Uniform"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Border>
                    </Button>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" Margin="8,4"/>
                    <TextBlock Grid.Row="2" Text="{Binding PageCount, StringFormat='{}{0} pages'}"
                               FontSize="10" Foreground="Gray" Margin="8,0,8,4"/>
                    <!-- Delete Button -->
                    <Button Grid.Row="3" Content="🗑️ Delete" FontSize="10" Padding="8,4" Margin="8,0,8,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).DeleteComicCommand, ElementName=Root}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        
        <!-- Error Message -->
        <Border Background="#FFEBEE" CornerRadius="8" Padding="12"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"/>
        </Border>

        <!-- Pending Imports Section -->
        <StackPanel Spacing="8" IsVisible="{Binding PendingImports.Count}">
          <TextBlock Text="Importing..." FontSize="18" FontWeight="Bold"/>
          <ItemsControl ItemsSource="{Binding PendingImports}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PendingImport">
                <Border Margin="0,0,0,8" CornerRadius="8" Padding="12"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <!-- Icon -->
                    <Border Grid.Column="0" Grid.RowSpan="3" Width="48" Height="48" 
                            CornerRadius="8" Background="Black" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                      <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- File name -->
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding FileName}" 
                               FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    
                    <!-- Status -->
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Status}" 
                               FontSize="12" Foreground="Gray"/>
                    
                    <!-- Progress bar -->
                    <ProgressBar Grid.Column="1" Grid.Row="2" Minimum="0" Maximum="1" 
                                 Value="{Binding Progress}" Height="6" Margin="0,4,0,0"
                                 IsVisible="{Binding IsProcessing}"/>
                    
                    <!-- Error message -->
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding ErrorMessage}" 
                               FontSize="10" Foreground="#C62828" Margin="0,4,0,0"
                               IsVisible="{Binding IsFailed}" TextWrapping="Wrap"/>
                    
                    <!-- Remove button (for failed items) -->
                    <Button Grid.Column="2" Grid.RowSpan="3" Content="✕" FontSize="12" Padding="8,4"
                            VerticalAlignment="Center" IsVisible="{Binding IsFailed}"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).RemovePendingImportCommand, ElementName=Root}"
                            CommandParameter="{Binding}"/>
                    
                    <!-- Completed checkmark -->
                    <TextBlock Grid.Column="2" Grid.RowSpan="3" Text="✓" FontSize="20" 
                               Foreground="Green" VerticalAlignment="Center"
                               IsVisible="{Binding IsCompleted}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Main Content (hidden when searching) -->
        <StackPanel Spacing="24" IsVisible="{Binding !IsSearching}">
          
        <!-- In Progress Section -->
        <StackPanel Spacing="8" IsVisible="{Binding InProgressComics.Count}">
          <TextBlock Text="Continue Reading" FontSize="18" FontWeight="Bold"/>
          <ItemsControl ItemsSource="{Binding InProgressComics}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Comic">
                <Border Margin="0,0,12,12" CornerRadius="8" ClipToBounds="True" Width="150"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                  <Grid RowDefinitions="200,Auto,Auto,Auto,Auto,Auto">
                    <!-- Cover with click handler -->
                    <Button Grid.Row="0" Padding="0" Background="Transparent" Height="200"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).OpenComicCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <Border Background="Black" CornerRadius="8,8,0,0">
                        <Image Source="{Binding CoverPath, Converter={StaticResource FilePathToBitmapConverter}}" Stretch="Uniform" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Border>
                    </Button>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" Margin="8,4"/>
                    <ProgressBar Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding ReadingProgress}"
                                 Height="4" Margin="8,2"/>
                    <TextBlock Grid.Row="3" FontSize="10" Foreground="Gray" Margin="8,2,8,4">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="Page {0} of {1}">
                          <Binding Path="CurrentPage"/>
                          <Binding Path="PageCount"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <!-- Mark as Read Button -->
                    <Button Grid.Row="4" Content="✓ Mark as Read" FontSize="10" Padding="8,4" Margin="8,0,8,4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).ToggleReadStatusCommand, ElementName=Root}"
                            CommandParameter="{Binding}"/>
                    <!-- Delete Button -->
                    <Button Grid.Row="5" Content="🗑️ Delete" FontSize="10" Padding="8,4" Margin="8,0,8,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).DeleteComicCommand, ElementName=Root}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Completed (Read) Section -->
        <StackPanel Spacing="8" IsVisible="{Binding CompletedComics.Count}">
          <TextBlock Text="Read" FontSize="18" FontWeight="Bold"/>
          <ItemsControl ItemsSource="{Binding CompletedComics}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Comic">
                <Border Margin="0,0,12,12" CornerRadius="8" ClipToBounds="True" Width="150"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                  <Grid RowDefinitions="200,Auto,Auto,Auto,Auto">
                    <!-- Cover with click handler -->
                    <Button Grid.Row="0" Padding="0" Background="Transparent" Height="200"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).OpenComicCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <Border Background="Black" CornerRadius="8,8,0,0">
                        <Image Source="{Binding CoverPath, Converter={StaticResource FilePathToBitmapConverter}}" Stretch="Uniform"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Border>
                    </Button>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" Margin="8,4"/>
                    <TextBlock Grid.Row="2" Text="{Binding PageCount, StringFormat='{}{0} pages'}"
                               FontSize="10" Foreground="Gray" Margin="8,0,8,4"/>
                    <!-- Mark as Unread Button -->
                    <Button Grid.Row="3" Content="↩ Mark as Unread" FontSize="10" Padding="8,4" Margin="8,0,8,4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).ToggleReadStatusCommand, ElementName=Root}"
                            CommandParameter="{Binding}"/>
                    <!-- Delete Button -->
                    <Button Grid.Row="4" Content="🗑️ Delete" FontSize="10" Padding="8,4" Margin="8,0,8,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).DeleteComicCommand, ElementName=Root}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- New Comics Section -->
        <StackPanel Spacing="8">
          <TextBlock Text="New Comics" FontSize="18" FontWeight="Bold"/>
          
          <!-- Empty State -->
          <StackPanel Spacing="16" HorizontalAlignment="Center" Margin="32"
                      IsVisible="{Binding !NewComics.Count}">
            <TextBlock Text="📚" FontSize="64" HorizontalAlignment="Center"/>
            <TextBlock Text="No new comics" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Import a comic file or download from Komga to get started"
                       Foreground="Gray" HorizontalAlignment="Center" TextAlignment="Center"/>
            <Button Content="Import Comic" Click="OnImportClicked" HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- Comics Grid -->
          <ItemsControl ItemsSource="{Binding NewComics}" IsVisible="{Binding NewComics.Count}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Comic">
                <Border Margin="0,0,12,12" CornerRadius="8" ClipToBounds="True" Width="150"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                  <Grid RowDefinitions="200,Auto,Auto,Auto">
                    <!-- Cover with click handler -->
                    <Button Grid.Row="0" Padding="0" Background="Transparent" Height="200"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).OpenComicCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <Border Background="Black" CornerRadius="8,8,0,0">
                        <Image Source="{Binding CoverPath, Converter={StaticResource FilePathToBitmapConverter}}" Stretch="Uniform"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Border>
                    </Button>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" Margin="8,4"/>
                    <TextBlock Grid.Row="2" Text="{Binding PageCount, StringFormat='{}{0} pages'}"
                               FontSize="10" Foreground="Gray" Margin="8,0,8,4"/>
                    <!-- Delete Button -->
                    <Button Grid.Row="3" Content="🗑️ Delete" FontSize="10" Padding="8,4" Margin="8,0,8,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ((vm:LibraryViewModel)DataContext).DeleteComicCommand, ElementName=Root}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        
        </StackPanel> <!-- End of Main Content (hidden when searching) -->
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
