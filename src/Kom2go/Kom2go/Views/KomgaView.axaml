<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Kom2go.ViewModels"
             xmlns:komga="using:Kom2go.Models.Komga"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Kom2go.Views.KomgaView"
             x:DataType="vm:KomgaViewModel"
             x:Name="Root">
  
  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Komga" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Padding="16,8"/>
      </Grid>
    </Border>
    
    <!-- Content -->
    <Grid Grid.Row="1">
      <!-- Not Connected State -->
      <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                  IsVisible="{Binding !IsConnected}">
        <TextBlock Text="🌐" FontSize="64" HorizontalAlignment="Center"/>
        <TextBlock Text="Not Connected" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Configure a Komga server in settings to browse and download comics"
                   Foreground="Gray" HorizontalAlignment="Center" TextAlignment="Center"/>
      </StackPanel>

      <!-- Connected Content -->
      <ScrollViewer IsVisible="{Binding IsConnected}" Padding="16">
        <StackPanel Spacing="16">
          <!-- Error Message -->
          <Border Background="#FFEBEE" CornerRadius="8" Padding="12"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"/>
          </Border>

          <!-- Breadcrumb Navigation -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Libraries" Command="{Binding GoBackToLibrariesCommand}"
                    Background="Transparent" Padding="0"
                    IsVisible="{Binding SelectedLibrary, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock Text="/" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedLibrary, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Button Content="{Binding SelectedLibrary.Name, FallbackValue=''}" Command="{Binding GoBackToSeriesCommand}"
                    Background="Transparent" Padding="0"
                    IsVisible="{Binding SelectedSeries, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock Text="/" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedSeries, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock Text="{Binding SelectedSeries.Name, FallbackValue=''}" FontWeight="Bold" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedSeries, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          </StackPanel>

          <!-- Libraries List -->
          <StackPanel Spacing="8" IsVisible="{Binding SelectedLibrary, Converter={x:Static ObjectConverters.IsNull}}">
            <TextBlock Text="Libraries" FontSize="18" FontWeight="Bold"/>
            <ItemsControl ItemsSource="{Binding Libraries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="komga:KomgaLibrary">
                  <Button Margin="0,0,0,8" Padding="16" HorizontalAlignment="Stretch"
                          Command="{Binding DataContext.SelectLibraryCommand, ElementName=Root}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Text="📚" FontSize="24" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Series Grid -->
          <StackPanel Spacing="8" 
                      IsVisible="{Binding SelectedLibrary, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel IsVisible="{Binding SelectedSeries, Converter={x:Static ObjectConverters.IsNull}}">
              <TextBlock Text="Series" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding Series}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="komga:KomgaSeriesDisplay">
                    <Button Margin="0,0,12,12" Padding="0" Background="Transparent"
                            Command="{Binding DataContext.SelectSeriesCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                              Width="150" ClipToBounds="True">
                        <!-- Use 3:4 aspect ratio typical for comic book covers (150 width = 200 height) -->
                        <Grid RowDefinitions="200,Auto,Auto">
                          <Border Grid.Row="0" Height="200" Background="LightGray" ClipToBounds="True">
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                     TextTrimming="CharacterEllipsis" Margin="8,4"/>
                          <TextBlock Grid.Row="2" Text="{Binding BooksCount, StringFormat='{}{0} books'}"
                                     FontSize="10" Foreground="Gray" Margin="8,0,8,8"/>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Load More" Command="{Binding LoadMoreSeriesCommand}" 
                      HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- Books Grid -->
          <StackPanel Spacing="8" IsVisible="{Binding SelectedSeries, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="Books" FontSize="18" FontWeight="Bold"/>
            <ItemsControl ItemsSource="{Binding Books}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="komga:KomgaBookDisplay">
                  <Border Margin="0,0,12,12" CornerRadius="8" Padding="0"
                          Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Width="150"
                          ClipToBounds="True">
                    <!-- Use 3:4 aspect ratio typical for comic book covers (150 width = 200 height) -->
                    <Grid RowDefinitions="200,Auto,Auto,Auto">
                      <Border Grid.Row="0" Height="200" Background="LightGray" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                 TextTrimming="CharacterEllipsis" Margin="8,4"/>
                      <TextBlock Grid.Row="2" Text="{Binding PagesCount, StringFormat='{}{0} pages', FallbackValue='? pages'}"
                                 FontSize="10" Foreground="Gray" Margin="8,0,8,4"/>
                      <Button Grid.Row="3" Content="Download" FontSize="10" Padding="8,4" Margin="8,0,8,8"
                              Command="{Binding DataContext.DownloadBookCommand, ElementName=Root}"
                              CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Load More" Command="{Binding LoadMoreBooksCommand}" 
                    HorizontalAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Download Progress Overlay -->
      <Border Background="#80000000" IsVisible="{Binding IsDownloading}">
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                CornerRadius="12" Padding="24" Width="300">
          <StackPanel Spacing="16">
            <TextBlock Text="Downloading..." FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding DownloadingBookName}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ProgressBar Value="{Binding DownloadProgress}" Maximum="1"/>
            <TextBlock Text="{Binding DownloadProgress, StringFormat='{}{0:P0}'}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Grid>
</UserControl>
