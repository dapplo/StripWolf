<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Kom2go.ViewModels"
             xmlns:komga="using:Kom2go.Models.Komga"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Kom2go.Views.KomgaView"
             x:DataType="vm:KomgaViewModel"
             x:Name="Root">
  
  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Komga" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="-" FontSize="24" VerticalAlignment="Center"
                     IsVisible="{Binding ActiveServerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock Text="{Binding ActiveServerName}" FontSize="18" VerticalAlignment="Center" Foreground="Gray"
                     IsVisible="{Binding ActiveServerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Padding="16,8"/>
      </Grid>
    </Border>
    
    <!-- Content -->
    <Grid Grid.Row="1">
      <!-- Not Connected State -->
      <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                  IsVisible="{Binding !IsConnected}">
        <TextBlock Text="🌐" FontSize="64" HorizontalAlignment="Center"/>
        <TextBlock Text="Not Connected" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Configure a Komga server in settings to browse and download comics"
                   Foreground="Gray" HorizontalAlignment="Center" TextAlignment="Center"/>
      </StackPanel>

      <!-- Connected Content -->
      <ScrollViewer IsVisible="{Binding IsConnected}" Padding="16">
        <StackPanel Spacing="16">
          <!-- Search Box -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="🔍 Search on Komga..."
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="✕" Command="{Binding ClearSearchCommand}" 
                    Padding="8,6" Margin="4,0,0,0"
                    IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </Grid>

          <!-- Search Results Section -->
          <StackPanel Spacing="16" IsVisible="{Binding IsSearching}">
            <!-- Series Search Results -->
            <StackPanel Spacing="8" IsVisible="{Binding SearchSeriesResults.Count}">
              <TextBlock Text="Series Results" FontSize="18" FontWeight="Bold"/>
              <ItemsControl ItemsSource="{Binding SearchSeriesResults}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="komga:KomgaSeriesDisplay">
                    <Button Margin="0,0,12,12" Padding="0" Background="Transparent"
                            Command="{Binding DataContext.SelectSeriesCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                              Width="150" ClipToBounds="True">
                        <Grid RowDefinitions="200,Auto,Auto">
                          <Border Grid.Row="0" Height="200" Background="Black" ClipToBounds="True">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                     TextTrimming="CharacterEllipsis" Margin="8,4"/>
                          <TextBlock Grid.Row="2" Text="{Binding BooksCount, StringFormat='{}{0} books'}"
                                     FontSize="10" Foreground="Gray" Margin="8,0,8,8"/>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Book Search Results -->
            <StackPanel Spacing="8" IsVisible="{Binding SearchBookResults.Count}">
              <TextBlock Text="Book Results" FontSize="18" FontWeight="Bold"/>
              <ItemsControl ItemsSource="{Binding SearchBookResults}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="komga:KomgaBookDisplay">
                    <Border Margin="0,0,12,12" CornerRadius="8" Padding="0"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Width="150"
                            ClipToBounds="True">
                      <Grid RowDefinitions="200,Auto,Auto,Auto">
                        <Border Grid.Row="0" Height="200" Background="Black" ClipToBounds="True">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" Margin="8,4"/>
                        <TextBlock Grid.Row="2" Text="{Binding PagesCount, StringFormat='{}{0} pages', FallbackValue='? pages'}"
                                   FontSize="10" Foreground="Gray" Margin="8,0,8,4"/>
                        <Button Grid.Row="3" Content="Download" FontSize="10" Padding="8,4" Margin="8,0,8,8"
                                Command="{Binding DataContext.DownloadBookCommand, ElementName=Root}"
                                CommandParameter="{Binding}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- No Results -->
            <TextBlock Text="No results found" Foreground="Gray" 
                       IsVisible="{Binding !SearchSeriesResults.Count}" Margin="0,8"/>
          </StackPanel>
          
          <!-- Error Message -->
          <Border Background="#FFEBEE" CornerRadius="8" Padding="12"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"/>
          </Border>

          <!-- Main Content (hidden when searching) -->
          <StackPanel Spacing="16" IsVisible="{Binding !IsSearching}">
            
          <!-- Breadcrumb Navigation -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Home" Command="{Binding GoBackToLibrariesCommand}"
                    Background="Transparent" Padding="0">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                  <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <TextBlock Text="/" VerticalAlignment="Center">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                  <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <!-- Read List breadcrumb -->
            <TextBlock Text="{Binding SelectedReadList.Name, FallbackValue=''}" FontWeight="Bold" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedReadList, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <!-- Library breadcrumb -->
            <Button Content="{Binding SelectedLibrary.Name, FallbackValue=''}" Command="{Binding GoBackToSeriesCommand}"
                    Background="Transparent" Padding="0"
                    IsVisible="{Binding SelectedSeries, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock Text="{Binding SelectedLibrary.Name, FallbackValue=''}" FontWeight="Bold" VerticalAlignment="Center">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                  <Binding Path="SelectedSeries" Converter="{x:Static ObjectConverters.IsNull}"/>
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <TextBlock Text="/" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedSeries, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock Text="{Binding SelectedSeries.Name, FallbackValue=''}" FontWeight="Bold" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedSeries, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          </StackPanel>

          <!-- Libraries and Read Lists (shown when nothing is selected) -->
          <StackPanel Spacing="16">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNull}"/>
                <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNull}"/>
              </MultiBinding>
            </StackPanel.IsVisible>
            
            <!-- Libraries List -->
            <StackPanel Spacing="8">
              <TextBlock Text="Libraries" FontSize="18" FontWeight="Bold"/>
              <ItemsControl ItemsSource="{Binding Libraries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="komga:KomgaLibrary">
                    <Button Margin="0,0,0,8" Padding="16" HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.SelectLibraryCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="📚" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            
            <!-- Read Lists -->
            <StackPanel Spacing="8">
              <TextBlock Text="Read Lists" FontSize="18" FontWeight="Bold"/>
              <ItemsControl ItemsSource="{Binding ReadLists}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="komga:KomgaReadListDisplay">
                    <Button Margin="0,0,12,12" Padding="0" Background="Transparent"
                            Command="{Binding DataContext.SelectReadListCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                              Width="150" ClipToBounds="True">
                        <Grid RowDefinitions="200,Auto,Auto">
                          <Border Grid.Row="0" Height="200" Background="Black" ClipToBounds="True">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                     TextTrimming="CharacterEllipsis" Margin="8,4"/>
                          <TextBlock Grid.Row="2" Text="{Binding BookCount, StringFormat='{}{0} books'}"
                                     FontSize="10" Foreground="Gray" Margin="8,0,8,8"/>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Load More Read Lists" Command="{Binding LoadMoreReadListsCommand}" 
                      HorizontalAlignment="Center" Margin="0,8,0,0"
                      IsVisible="{Binding HasMoreReadLists}"/>
            </StackPanel>
          </StackPanel>

          <!-- Read List Books Grid -->
          <StackPanel Spacing="8" IsVisible="{Binding SelectedReadList, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="Books" FontSize="18" FontWeight="Bold"/>
            <ItemsControl ItemsSource="{Binding Books}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="komga:KomgaBookDisplay">
                  <Border Margin="0,0,12,12" CornerRadius="8" Padding="0"
                          Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Width="150"
                          ClipToBounds="True">
                    <Grid RowDefinitions="200,Auto,Auto,Auto">
                      <Border Grid.Row="0" Height="200" Background="Black" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                 TextTrimming="CharacterEllipsis" Margin="8,4"/>
                      <TextBlock Grid.Row="2" Text="{Binding PagesCount, StringFormat='{}{0} pages', FallbackValue='? pages'}"
                                 FontSize="10" Foreground="Gray" Margin="8,0,8,4"/>
                      <Button Grid.Row="3" Content="Download" FontSize="10" Padding="8,4" Margin="8,0,8,8"
                              Command="{Binding DataContext.DownloadBookCommand, ElementName=Root}"
                              CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Load More" Command="{Binding LoadMoreBooksForReadListCommand}" 
                    HorizontalAlignment="Center" Margin="0,8,0,48"/>
          </StackPanel>

          <!-- Series Grid (only show when library is selected but no read list) -->
          <StackPanel Spacing="8">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNull}"/>
              </MultiBinding>
            </StackPanel.IsVisible>
            <StackPanel IsVisible="{Binding SelectedSeries, Converter={x:Static ObjectConverters.IsNull}}">
              <TextBlock Text="Series" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
              
              <!-- A-Z Letter Filter -->
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{x:Static vm:KomgaViewModel.LetterFilters}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}" MinWidth="36" Padding="8,6"
                              Command="{Binding DataContext.SelectLetterFilterCommand, ElementName=Root}"
                              CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              
              <!-- Selected Letter Filter Indicator -->
              <TextBlock Margin="0,0,0,8" FontSize="14" Foreground="Gray">
                <TextBlock.Text>
                  <MultiBinding StringFormat="Showing series starting with: {0}">
                    <Binding Path="SelectedLetterFilter" FallbackValue="All"/>
                  </MultiBinding>
                </TextBlock.Text>
                <TextBlock.IsVisible>
                  <Binding Path="SelectedLetterFilter" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                </TextBlock.IsVisible>
              </TextBlock>
              
              <ItemsControl ItemsSource="{Binding Series}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="komga:KomgaSeriesDisplay">
                    <Button Margin="0,0,12,12" Padding="0" Background="Transparent"
                            Command="{Binding DataContext.SelectSeriesCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                              Width="150" ClipToBounds="True">
                        <!-- Use 3:4 aspect ratio typical for comic book covers (150 width = 200 height) -->
                        <Grid RowDefinitions="200,Auto,Auto">
                          <Border Grid.Row="0" Height="200" Background="Black" ClipToBounds="True">
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                     TextTrimming="CharacterEllipsis" Margin="8,4"/>
                          <TextBlock Grid.Row="2" Text="{Binding BooksCount, StringFormat='{}{0} books'}"
                                     FontSize="10" Foreground="Gray" Margin="8,0,8,8"/>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Load More" Command="{Binding LoadMoreSeriesCommand}" 
                      HorizontalAlignment="Center" Margin="0,8,0,48"/>
            </StackPanel>
          </StackPanel>

          <!-- Books Grid (for series) -->
          <StackPanel Spacing="8">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="SelectedSeries" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNull}"/>
              </MultiBinding>
            </StackPanel.IsVisible>
            <TextBlock Text="Books" FontSize="18" FontWeight="Bold"/>
            <ItemsControl ItemsSource="{Binding Books}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="komga:KomgaBookDisplay">
                  <Border Margin="0,0,12,12" CornerRadius="8" Padding="0"
                          Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Width="150"
                          ClipToBounds="True">
                    <!-- Use 3:4 aspect ratio typical for comic book covers (150 width = 200 height) -->
                    <Grid RowDefinitions="200,Auto,Auto,Auto">
                      <Border Grid.Row="0" Height="200" Background="Black" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                 TextTrimming="CharacterEllipsis" Margin="8,4"/>
                      <TextBlock Grid.Row="2" Text="{Binding PagesCount, StringFormat='{}{0} pages', FallbackValue='? pages'}"
                                 FontSize="10" Foreground="Gray" Margin="8,0,8,4"/>
                      <Button Grid.Row="3" Content="Download" FontSize="10" Padding="8,4" Margin="8,0,8,8"
                              Command="{Binding DataContext.DownloadBookCommand, ElementName=Root}"
                              CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Load More" Command="{Binding LoadMoreBooksCommand}" 
                    HorizontalAlignment="Center" Margin="0,8,0,48"/>
          </StackPanel>
          
          </StackPanel> <!-- End of Main Content (hidden when searching) -->
        </StackPanel>
      </ScrollViewer>

      <!-- Floating Load More Button for Series - Always visible at the bottom when browsing series -->
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" 
              Margin="0,0,0,16" Padding="4" CornerRadius="20"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsConnected"/>
            <Binding Path="!IsSearching"/>
            <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNotNull}"/>
            <Binding Path="SelectedSeries" Converter="{x:Static ObjectConverters.IsNull}"/>
            <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNull}"/>
          </MultiBinding>
        </Border.IsVisible>
        <Button Content="📥 Load More Series" Padding="16,8"
                Command="{Binding LoadMoreSeriesCommand}"/>
      </Border>

      <!-- Floating Load More Button for Books (series) - Always visible at the bottom when browsing books in a series -->
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" 
              Margin="0,0,0,16" Padding="4" CornerRadius="20"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsConnected"/>
            <Binding Path="!IsSearching"/>
            <Binding Path="SelectedSeries" Converter="{x:Static ObjectConverters.IsNotNull}"/>
            <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNull}"/>
          </MultiBinding>
        </Border.IsVisible>
        <Button Content="📥 Load More Books" Padding="16,8"
                Command="{Binding LoadMoreBooksCommand}"/>
      </Border>

      <!-- Floating Load More Button for Books (read list) - Always visible at the bottom when browsing books in a read list -->
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" 
              Margin="0,0,0,16" Padding="4" CornerRadius="20"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsConnected"/>
            <Binding Path="!IsSearching"/>
            <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNotNull}"/>
          </MultiBinding>
        </Border.IsVisible>
        <Button Content="📥 Load More Books" Padding="16,8"
                Command="{Binding LoadMoreBooksForReadListCommand}"/>
      </Border>

      <!-- Download Progress Overlay -->
      <Border Background="#80000000" IsVisible="{Binding IsDownloading}">
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                CornerRadius="12" Padding="24" Width="300">
          <StackPanel Spacing="16">
            <TextBlock Text="Downloading..." FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding DownloadingBookName}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ProgressBar Value="{Binding DownloadProgress}" Maximum="1"/>
            <TextBlock Text="{Binding DownloadProgress, StringFormat='{}{0:P0}'}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Grid>
</UserControl>
