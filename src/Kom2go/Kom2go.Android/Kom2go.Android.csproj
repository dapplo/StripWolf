<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.dapplo.Kom2go</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Exclude PDFium from Android build to reduce APK size -->
    <ExcludePdfium>true</ExcludePdfium>
  </PropertyGroup>

  <!-- Release signing configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>kom2go.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>kom2go</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(ANDROID_SIGNING_KEY_PASS)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(ANDROID_SIGNING_STORE_PASS)</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.android-arm64" />
    <PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.android-x64" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kom2go\Kom2go.csproj" />
  </ItemGroup>
</Project>
