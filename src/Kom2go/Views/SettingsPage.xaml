<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kom2go.ViewModels"
             xmlns:models="clr-namespace:Kom2go.Models"
             
             x:Class="Kom2go.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}">

    <Grid>
        <ScrollView IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Spacing="16" Padding="16">
                
                <!-- Error Message -->
                <Frame BackgroundColor="#FFEBEE"
                       Padding="12"
                       CornerRadius="8"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
                    <Label Text="{Binding ErrorMessage}" TextColor="#C62828"/>
                </Frame>

                <!-- Komga Servers Section -->
                <Label Text="Komga Servers" FontSize="18" FontAttributes="Bold"/>
                
                <!-- Add Server Button -->
                <Button Text="Add Server"
                        Command="{Binding AddServerCommand}"
                        HorizontalOptions="Start"/>

                <!-- Servers List -->
                <CollectionView ItemsSource="{Binding Servers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:KomgaServer">
                            <Frame Padding="16" Margin="0,0,0,8" CornerRadius="8">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <VerticalStackLayout>
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Name}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold"/>
                                            <Frame BackgroundColor="{StaticResource Primary}"
                                                   Padding="6,2"
                                                   CornerRadius="4"
                                                   IsVisible="{Binding IsActive}">
                                                <Label Text="Active" 
                                                       TextColor="White" 
                                                       FontSize="10"/>
                                            </Frame>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding BaseUrl}" 
                                               TextColor="Gray"
                                               FontSize="12"/>
                                        <Label Text="{Binding Username, StringFormat='User: {0}'}" 
                                               TextColor="Gray"
                                               FontSize="12"/>
                                    </VerticalStackLayout>
                                    
                                    <Button Grid.Column="1"
                                            Text="✓"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=SetActiveServerCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Primary}"
                                            FontSize="20"
                                            WidthRequest="44"/>
                                    
                                    <Button Grid.Column="2"
                                            Text="✏️"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=EditServerCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            WidthRequest="44"/>
                                    
                                    <Button Grid.Column="3"
                                            Text="🗑️"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=DeleteServerCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            WidthRequest="44"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" 
                                             VerticalOptions="Center" 
                                             Spacing="8"
                                             Padding="32">
                            <Label Text="No servers configured" 
                                   TextColor="Gray"
                                   HorizontalOptions="Center"/>
                            <Label Text="Add a Komga server to browse and download comics"
                                   TextColor="Gray"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- About Section -->
                <Label Text="About" FontSize="18" FontAttributes="Bold" Margin="0,16,0,0"/>
                <Frame Padding="16" CornerRadius="8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Kom2go" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="A comic book reader with Komga integration" TextColor="Gray"/>
                        <Label Text="Version 1.0.0" TextColor="Gray" FontSize="12"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Edit Server Form -->
        <ScrollView IsVisible="{Binding IsEditing}">
            <VerticalStackLayout Spacing="16" Padding="16">
                <Label Text="Server Configuration" FontSize="18" FontAttributes="Bold"/>
                
                <VerticalStackLayout Spacing="4">
                    <Label Text="Name"/>
                    <Entry Text="{Binding ServerName}"
                           Placeholder="My Komga Server"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Server URL"/>
                    <Entry Text="{Binding ServerUrl}"
                           Placeholder="https://komga.example.com"
                           Keyboard="Url"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Username"/>
                    <Entry Text="{Binding Username}"
                           Placeholder="username"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Password"/>
                    <Entry Text="{Binding Password}"
                           Placeholder="password"
                           IsPassword="True"/>
                </VerticalStackLayout>

                <!-- Connection Status -->
                <Label Text="{Binding ConnectionStatus}"
                       IsVisible="{Binding ConnectionStatus, Converter={StaticResource IsNotNullConverter}}"
                       HorizontalOptions="Center"/>

                <!-- Action Buttons -->
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Button Text="Test Connection"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"/>
                    
                    <Button Text="Cancel"
                            Command="{Binding CancelEditCommand}"
                            BackgroundColor="Transparent"
                            TextColor="Gray"
                            BorderColor="Gray"
                            BorderWidth="1"/>
                    
                    <Button Text="Save"
                            Command="{Binding SaveServerCommand}"/>
                </HorizontalStackLayout>

                <!-- Testing Indicator -->
                <ActivityIndicator IsRunning="{Binding IsTestingConnection}"
                                   IsVisible="{Binding IsTestingConnection}"
                                   HorizontalOptions="Center"
                                   Color="{StaticResource Primary}"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
