<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>26.5</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <ProvisioningType>manual</ProvisioningType>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <ApplicationId>com.dapplo.StripWolf</ApplicationId>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CodesignKey>iPhone Developer</CodesignKey>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="SkiaSharp" />
    <TrimmerRootAssembly Include="HarfBuzzSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StripWolf.Core\StripWolf.Core.csproj" UndefineProperties="RuntimeIdentifier" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.plist">
      <LogicalName>Info.plist</LogicalName>
    </None>
    <None Include="Entitlements.plist" />
  </ItemGroup>
</Project>
