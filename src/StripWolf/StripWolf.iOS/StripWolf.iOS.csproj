<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <!-- Minimum iOS/iPadOS version (was 26.5). 16.0 covers all iPads from 2017 on; .NET 10 itself supports 12.2+. -->
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <ProvisioningType>manual</ProvisioningType>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <ApplicationId>com.dapplo.StripWolf</ApplicationId>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CodesignKey>iPhone Developer</CodesignKey>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="SkiaSharp" />
    <TrimmerRootAssembly Include="HarfBuzzSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" />
  </ItemGroup>

  <ItemGroup>
    <!-- No OpenCV native runtime for iOS: build Core with the no-op panel detection (guided reading hidden) -->
    <ProjectReference Include="..\StripWolf.Core\StripWolf.Core.csproj" AdditionalProperties="UseOpenCvPanelDetection=false" UndefineProperties="RuntimeIdentifier" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.plist">
      <LogicalName>Info.plist</LogicalName>
    </None>
    <None Include="Entitlements.plist" />
  </ItemGroup>
</Project>
