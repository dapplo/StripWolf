<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>StripWolf</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!--
    Target platform: taken from the RuntimeIdentifier when one is given (publish, possibly cross-platform),
    otherwise from the build machine. Before, the conditions below used IsOSPlatform (= the build machine) only.
  -->
  <PropertyGroup>
    <StripWolfTargetWindows Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">true</StripWolfTargetWindows>
    <StripWolfTargetLinux Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">true</StripWolfTargetLinux>
    <StripWolfTargetWindows Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</StripWolfTargetWindows>
    <StripWolfTargetLinux Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">true</StripWolfTargetLinux>
  </PropertyGroup>

  <!--
    Features which depend on the platform (both can still be forced with -p:UseOpenCvPanelDetection=... / -p:UseEpubSupport=...):
    - Panel detection (guided reading) needs the native OpenCV runtime, which is only shipped for Windows
      (Android has its own runtime in the Android head). Previously it was also switched off for every build with a
      RuntimeIdentifier, so the published Windows release had no guided reading.
      If OpenCV cannot be loaded at runtime, PanelDetectionService.IsAvailable returns false and guided reading is hidden.
    - EPUB conversion renders pages in an off-screen browser: WebView2 on Windows, WPE WebKit on Linux, nothing on macOS.
      The WebView2 .NET wrapper uses built-in COM interop, which Native AOT does not support, so it stays disabled for
      published (RuntimeIdentifier + PublishAot) Windows builds. The Linux WPE service has not been verified with
      Native AOT yet, so it is also kept for non-RID (dotnet run / debug) builds only, as before.
  -->
  <PropertyGroup>
    <UseOpenCvPanelDetection Condition="'$(UseOpenCvPanelDetection)' == '' and '$(StripWolfTargetWindows)' == 'true'">true</UseOpenCvPanelDetection>
    <UseOpenCvPanelDetection Condition="'$(UseOpenCvPanelDetection)' == ''">false</UseOpenCvPanelDetection>
    <UseEpubSupport Condition="'$(UseEpubSupport)' == '' and '$(RuntimeIdentifier)' != '' and '$(PublishAot)' == 'true'">false</UseEpubSupport>
    <UseEpubSupport Condition="'$(UseEpubSupport)' == '' and ('$(StripWolfTargetWindows)' == 'true' or '$(StripWolfTargetLinux)' == 'true')">true</UseEpubSupport>
    <UseEpubSupport Condition="'$(UseEpubSupport)' == ''">false</UseEpubSupport>
  </PropertyGroup>

  <PropertyGroup>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="SQLite-net" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseEpubSupport)' == 'true' and '$(StripWolfTargetWindows)' == 'true'">
    <TrimmerRootAssembly Include="Microsoft.Web.WebView2.Core" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseOpenCvPanelDetection)' == 'true'">
    <TrimmerRootAssembly Include="OpenCvSharp" />
  </ItemGroup>

  <PropertyGroup Condition="'$(StripWolfTargetWindows)' == 'true'">
    <DefineConstants>$(DefineConstants);Windows</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StripWolfTargetLinux)' == 'true'">
    <DefineConstants>$(DefineConstants);Linux</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseEpubSupport)' == 'false'">
    <DefineConstants>$(DefineConstants);DISABLE_EPUB_WEBVIEW</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Controls.WebView" Condition="'$(StripWolfTargetLinux)' == 'true' and '$(UseEpubSupport)' == 'true'" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="PDFiumCore" />
    <PackageReference Include="GitVersion.MsBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Icon.ico" Condition="Exists('Icon.ico')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(UseEpubSupport)' == 'true'">
    <PackageReference Include="Microsoft.Web.WebView2" GeneratePathProperty="true" ExcludeAssets="all" Condition="'$(StripWolfTargetWindows)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseOpenCvPanelDetection)' == 'true'">
    <PackageReference Include="OpenCvSharp4.runtime.win" Condition="'$(StripWolfTargetWindows)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StripWolf.Core\StripWolf.Core.csproj" AdditionalProperties="UseOpenCvPanelDetection=$(UseOpenCvPanelDetection);UseEpubSupport=$(UseEpubSupport)" UndefineProperties="RuntimeIdentifier" />
  </ItemGroup>

  <ItemGroup Condition="'$(StripWolfTargetWindows)' != 'true'">
    <Compile Remove="Services\Windows\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseEpubSupport)' == 'false'">
    <Compile Remove="Services\Windows\WindowsWebView2SnapshotService.cs" />
    <Compile Remove="Services\Linux\LinuxWpeWebViewSnapshotService.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(StripWolfTargetLinux)' != 'true'">
    <Compile Remove="Services\Linux\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(StripWolfTargetWindows)' == 'true' and '$(UseEpubSupport)' == 'true'">
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(StripWolfTargetWindows)' == 'true' and '$(UseEpubSupport)' == 'true'">
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll">
      <Link>runtimes\win-x86\native\WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll">
      <Link>runtimes\win-x64\native\WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll">
      <Link>runtimes\win-arm64\native\WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Aggressively remove all PDB files after publish, including native ones from SkiaSharp, etc. -->
  <Target Name="DeletePdbFilesAfterPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PdbFiles Include="$(PublishDir)\**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbFiles)" />
    <Message Text="Deleted PDB files from $(PublishDir)" Importance="high" />
  </Target>
</Project>
