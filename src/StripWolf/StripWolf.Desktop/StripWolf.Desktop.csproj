<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>StripWolf</AssemblyName>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <UseOpenCvPanelDetection Condition="'$(UseOpenCvPanelDetection)' == ''">true</UseOpenCvPanelDetection>
    <UseOpenCvPanelDetection Condition="$([MSBuild]::IsOSPlatform('Linux'))">false</UseOpenCvPanelDetection>
    <UseOpenCvPanelDetection Condition="$([MSBuild]::IsOSPlatform('OSX'))">false</UseOpenCvPanelDetection>
    <UseOpenCvPanelDetection Condition="'$(RuntimeIdentifier)' != ''">false</UseOpenCvPanelDetection>
    <UseEpubSupport Condition="'$(UseEpubSupport)' == ''">true</UseEpubSupport>
    <UseEpubSupport Condition="'$(RuntimeIdentifier)' != ''">false</UseEpubSupport>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="SQLite-net" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseEpubSupport)' == 'true'">
    <TrimmerRootAssembly Include="Microsoft.Web.WebView2.Core" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseOpenCvPanelDetection)' == 'true'">
    <TrimmerRootAssembly Include="OpenCvSharp" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);Windows</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>$(DefineConstants);Linux</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseEpubSupport)' == 'false'">
    <DefineConstants>$(DefineConstants);DISABLE_EPUB_WEBVIEW</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Controls.WebView" Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(UseEpubSupport)' == 'true'" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="PDFiumCore" />
    <PackageReference Include="GitVersion.MsBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Icon.ico" Condition="Exists('Icon.ico')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(UseEpubSupport)' == 'true'">
    <PackageReference Include="Microsoft.Web.WebView2" GeneratePathProperty="true" ExcludeAssets="all" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseOpenCvPanelDetection)' == 'true'">
    <PackageReference Include="OpenCvSharp4.runtime.win" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="OpenCvSharp4.runtime.ubuntu.22.04-x64" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="OpenCvSharp4.runtime.osx-arm64" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="OpenCvSharp4.runtime.osx-x64" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StripWolf.Core\StripWolf.Core.csproj" AdditionalProperties="UseOpenCvPanelDetection=$(UseOpenCvPanelDetection);UseEpubSupport=$(UseEpubSupport)" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Services\Windows\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseEpubSupport)' == 'false'">
    <Compile Remove="Services\Windows\WindowsWebView2SnapshotService.cs" />
    <Compile Remove="Services\Linux\LinuxWpeWebViewSnapshotService.cs" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Linux'))">
    <Compile Remove="Services\Linux\**" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(UseEpubSupport)' == 'true'">
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(UseEpubSupport)' == 'true'">
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll">
      <Link>runtimes\win-x86\native\WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll">
      <Link>runtimes\win-x64\native\WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll">
      <Link>runtimes\win-arm64\native\WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Aggressively remove all PDB files after publish, including native ones from SkiaSharp, etc. -->
  <Target Name="DeletePdbFilesAfterPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PdbFiles Include="$(PublishDir)\**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbFiles)" />
    <Message Text="Deleted PDB files from $(PublishDir)" Importance="high" />
  </Target>
</Project>
