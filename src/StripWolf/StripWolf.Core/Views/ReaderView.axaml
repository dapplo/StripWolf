<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StripWolf.Core.ViewModels"
             xmlns:views="using:StripWolf.Core.Views"
             xmlns:converters="using:StripWolf.Core.Converters"
             x:Class="StripWolf.Core.Views.ReaderView"
             x:DataType="vm:ReaderViewModel"
             Background="Black"
             Focusable="True">
  
  <UserControl.Styles>
    <Style Selector="Button.reading-mode">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.reading-mode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#44FFFFFF"/>
    </Style>
    <Style Selector="Button.reading-mode.active">
      <Setter Property="Background" Value="Red"/>
    </Style>
    <Style Selector="Button.reading-mode.active /template/ ContentPresenter">
      <Setter Property="Background" Value="Red"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Content Area: Swaps based on ReadingMode -->
    <Panel>
      <views:NormalReadingView IsVisible="{Binding IsNormalMode}"/>
      <views:ZoomedReadingView IsVisible="{Binding IsZoomedMode}"/>
      <views:GuidedReadingView IsVisible="{Binding IsGuidedMode}"/>
    </Panel>

    <!-- Shared UI Overlays -->
    
    <!-- Loading Indicator -->
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"/>
    <Border Background="#B0000000" CornerRadius="6" Padding="12,6"
            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,72,0,0"
            IsVisible="{Binding ReaderStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ReaderStatusMessage}" Foreground="White"/>
    </Border>

    <!-- Top Controls -->
    <Border VerticalAlignment="Top" Background="#E0000000" Padding="16"
            IsVisible="{Binding IsControlsVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <Button Grid.Column="0" Content="← Back" Command="{Binding GoBackCommand}" 
                Background="Transparent" Foreground="White"/>
        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="18" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="16,0"/>
        
        <!-- Save Page Button (Debug Only) -->
        <Button Grid.Column="2" Command="{Binding SaveCurrentPageCommand}"
                IsVisible="{Binding IsDebug}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Save Original Page (Debug)">
          <TextBlock Text="⇩" FontSize="24"/>
        </Button>
        
        <Button Grid.Column="3" Command="{Binding ToggleInfoPanelCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Info (I)">
          <TextBlock Text="ⓘ" FontSize="24"/>
        </Button>
        
        <!-- Reading Modes -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
          <Button Classes="reading-mode" 
                  Classes.active="{Binding IsNormalMode}"
                  Command="{Binding SetNormalModeCommand}"
                  ToolTip.Tip="Normal Mode">
            <TextBlock Text="▯" FontSize="20"/>
          </Button>
          <Button Classes="reading-mode" 
                  Classes.active="{Binding IsZoomedMode}"
                  Command="{Binding SetZoomedModeCommand}"
                  ToolTip.Tip="Zoomed Mode">
            <TextBlock Text="⊕" FontSize="20"/>
          </Button>
          <Button Classes="reading-mode" 
                  Classes.active="{Binding IsGuidedMode}"
                  Command="{Binding SetGuidedModeCommand}"
                  IsVisible="{Binding IsGuidedReadingAvailable}"
                  ToolTip.Tip="Guided Mode">
            <TextBlock Text="⊞" FontSize="20"/>
          </Button>
        </StackPanel>
        
        <Button Grid.Column="5" Command="{Binding ToggleHandednessCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Handedness"
                IsEnabled="{Binding !IsNormalMode}">
          <TextBlock Text="⇄" FontSize="24"/>
        </Button>
        
        <Button Grid.Column="6" Command="{Binding ToggleTwoPageModeCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Two-Page (2)"
                IsEnabled="{Binding CanUseTwoPageMode}">
          <TextBlock Text="{Binding TwoPageModeIcon}" FontSize="24"/>
        </Button>
        
        <Button Grid.Column="7" Command="{Binding CycleStretchModeCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Fit Mode"
                IsEnabled="{Binding IsNormalMode}">
          <TextBlock Text="{Binding StretchModeIcon}" FontSize="24"/>
        </Button>
        
        <Button Grid.Column="8" Command="{Binding ToggleFullScreenCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Full Screen (F)">
          <TextBlock Text="⛶" FontSize="24"/>
        </Button>
      </Grid>
    </Border>

    <!-- Bottom Controls -->
    <Border VerticalAlignment="Bottom" Background="#E0000000" Padding="16,8"
            IsVisible="{Binding IsControlsVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Command="{Binding GoToPreviousPageCommand}"
                Background="Transparent" Foreground="White" IsEnabled="{Binding HasPreviousPage}">
          <TextBlock Text="◀" FontSize="28"/>
        </Button>
        
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="16,0">
          <Slider Grid.Column="0" Minimum="0" Maximum="{Binding MaxSliderValue}" 
                  Value="{Binding CurrentPage}" 
                  Foreground="Red"/>
          <TextBlock Grid.Column="1" Text="{Binding PageDisplay}" Foreground="White" 
                     VerticalAlignment="Center" Margin="12,0,0,0" Width="100" TextAlignment="Right"
                     FontSize="16"/>
        </Grid>
        
        <Button Grid.Column="2" Command="{Binding GoToNextPageCommand}"
                Background="Transparent" Foreground="White" IsEnabled="{Binding CanAdvanceOrShowEndChoices}">
          <TextBlock Text="▶" FontSize="28"/>
        </Button>
      </Grid>
    </Border>

    <!-- End Of Comic Overlay -->
    <Panel IsVisible="{Binding IsEndOfComicOptionsVisible}" ZIndex="110">
      <Button Background="#F0000000" Command="{Binding DismissEndOfComicOptionsCommand}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" BorderThickness="0"/>

      <Border Background="#E0222222" CornerRadius="8" Padding="24" MaxWidth="520" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 4 20 0 #40000000">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="End of Comic" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <Button Grid.Column="1" Command="{Binding DismissEndOfComicOptionsCommand}"
                    Background="Transparent" Foreground="White">
              <TextBlock Text="✕" FontSize="24"/>
            </Button>
          </Grid>

          <TextBlock Text="What would you like to do next?" Foreground="White" Opacity="0.9" FontSize="16"/>

          <Button Command="{Binding OpenNextSeriesComicCommand}" IsEnabled="{Binding HasNextSeriesComic}"
                  Background="{DynamicResource SystemAccentColor}" Foreground="White"
                  HorizontalAlignment="Stretch" Padding="16,12" HorizontalContentAlignment="Center">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
              <TextBlock Text="Open Next in Series" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding NextSeriesComicTitle}" FontSize="12" Opacity="0.85"
                         HorizontalAlignment="Center" IsVisible="{Binding HasNextSeriesComic}"/>
            </StackPanel>
          </Button>

          <TextBlock Text="No next comic from this series is available locally."
                     Foreground="#CCCCCC" FontSize="12"
                     IsVisible="{Binding !HasNextSeriesComic}"/>

          <Button Content="🌐 View Series on Komga" Command="{Binding ViewSeriesOnKomgaCommand}"
                  Background="#444" Foreground="White"
                  HorizontalAlignment="Stretch" Padding="16,12" HorizontalContentAlignment="Center"
                  IsVisible="{Binding CanViewSeriesOnKomgaOption}"/>

          <Button Content="📚 Back to Library" Command="{Binding ReturnToLibraryCommand}"
                  Background="#444" Foreground="White"
                  HorizontalAlignment="Stretch" Padding="16,12" HorizontalContentAlignment="Center"/>
        </StackPanel>
      </Border>
    </Panel>

    <!-- Info Panel Overlay -->
    <Panel IsVisible="{Binding IsInfoPanelVisible}" ZIndex="100">
      <!-- Click background to close -->
      <Button Background="#F0000000" Command="{Binding ToggleInfoPanelCommand}" 
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" BorderThickness="0"/>

      <Border Background="#E0222222" CornerRadius="8" Padding="0" MaxWidth="600" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 4 20 0 #40000000">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16">
            <TextBlock Text="Comic Information" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <Button Grid.Column="1" Command="{Binding ToggleInfoPanelCommand}"
                    Background="Transparent" Foreground="White">
              <TextBlock Text="✕" FontSize="24"/>
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" Padding="24,0,24,24">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="150,*">
                <!-- Cover -->
                <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Background="Black" Height="200">
                  <Image Source="{Binding ComicCoverPath, Converter={x:Static converters:FilePathToBitmapConverter.Instance}}" Stretch="Uniform"/>
                </Border>
                
                <!-- Basic Meta -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="8">
                  <TextBlock Text="{Binding ComicTitleDisplay}" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                  
                  <StackPanel IsVisible="{Binding SeriesDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="Series" FontSize="12" Foreground="#888"/>
                    <TextBlock Text="{Binding SeriesDisplay}" FontSize="16" Foreground="White"/>
                  </StackPanel>
                  
                  <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0">
                       <TextBlock Text="Number" FontSize="12" Foreground="#888"/>
                       <TextBlock Text="{Binding ComicNumberDisplay}" FontSize="16" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                       <TextBlock Text="Pages" FontSize="12" Foreground="#888"/>
                       <TextBlock Text="{Binding ComicPageCountDisplay}" FontSize="16" Foreground="White"/>
                    </StackPanel>
                  </Grid>

                  <Button Content="🌐 View Series on Komga" 
                          Command="{Binding ViewSeriesOnKomgaCommand}"
                          Background="#444" Foreground="White"
                          HorizontalAlignment="Stretch" Padding="12,8" Margin="0,8,0,0">
                    <Button.IsVisible>
                       <Binding Path="HasKomgaSeriesLink"/>
                    </Button.IsVisible>
                  </Button>
                </StackPanel>
              </Grid>
              
              <Separator Background="#333" IsVisible="{Binding ComicInfo, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              
              <!-- Metadata from ComicInfo -->
              <StackPanel Spacing="8" IsVisible="{Binding ComicInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
                 <StackPanel IsVisible="{Binding AuthorsDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                   <TextBlock Text="Creators" Foreground="#888" FontSize="12"/>
                   <TextBlock Text="{Binding AuthorsDisplay}" Foreground="White" TextWrapping="Wrap"/>
                 </StackPanel>

                 <StackPanel IsVisible="{Binding ComicInfoPublisher, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="Publisher" Foreground="#888" FontSize="12"/>
                   <TextBlock Text="{Binding ComicInfoPublisher}" Foreground="White"/>
                 </StackPanel>
                  
                  <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                   <StackPanel Grid.Column="0" IsVisible="{Binding ComicInfoGenre, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                     <TextBlock Text="Genre" Foreground="#888" FontSize="12"/>
                     <TextBlock Text="{Binding ComicInfoGenre}" Foreground="White" TextWrapping="Wrap"/>
                    </StackPanel>
                   <StackPanel Grid.Column="1" IsVisible="{Binding ComicInfoLanguageIso, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                     <TextBlock Text="Language" Foreground="#888" FontSize="12"/>
                     <TextBlock Text="{Binding ComicInfoLanguageIso}" Foreground="White"/>
                    </StackPanel>
                  </Grid>

                 <StackPanel IsVisible="{Binding ComicInfoTags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="Tags" Foreground="#888" FontSize="12"/>
                    <TextBlock Text="{Binding ComicInfoTags}" Foreground="White" TextWrapping="Wrap"/>
                  </StackPanel>
               </StackPanel>

              <Separator Background="#333" IsVisible="{Binding ComicInfoSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
               
               <!-- Summary -->
               <StackPanel IsVisible="{Binding ComicInfoSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                 <TextBlock Text="Summary" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding ComicInfoSummary}" TextWrapping="Wrap" Foreground="White" FontSize="14" Opacity="0.9"/>
               </StackPanel>

              <!-- Actions -->
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <Button Content="📖 Continue Reading" Background="{DynamicResource SystemAccentColor}" Foreground="White"
                        Command="{Binding ToggleInfoPanelCommand}"
                        HorizontalAlignment="Stretch" Padding="16,12" HorizontalContentAlignment="Center"/>
                
                <Grid ColumnDefinitions="*,*">
                  <Button Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding ToggleFavoriteCommand}" Background="#444" Foreground="White">
                     <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⭐" IsVisible="{Binding IsFavorite}"/>
                        <TextBlock Text="☆" IsVisible="{Binding !IsFavorite}"/>
                        <TextBlock Text="Favorite" />
                     </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Margin="4,0,0,0" Content="✓ Mark Read" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding ToggleReadStatusCommand}" Background="#444" Foreground="White"/>
                </Grid>

                <Button Content="🗑️ Delete Comic" Background="#D32F2F" Foreground="White"
                        Command="{Binding DeleteComicCommand}"
                        HorizontalAlignment="Stretch" Padding="12,8" HorizontalContentAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Panel>
  </Grid>
</UserControl>
