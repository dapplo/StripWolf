<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StripWolf.Core.ViewModels"
             x:Class="StripWolf.Core.Views.GuidedReadingView"
             x:DataType="vm:ReaderViewModel">
    <!-- Rows and columns are set by ZoomViewBase: side by side in landscape, overview above the zoom in portrait -->
    <Grid x:Name="PaneLayoutRoot">

        <!-- Left Side -->

        <Grid x:Name="LeftPane">
            <!-- Overview if Right-Handed -->
            <Border IsVisible="{Binding IsOverviewOnLeft}" Background="#1A1A1A" Margin="4">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="OverviewContainerLeft">
                        <Image x:Name="OverviewImageLeft" 
                               Source="{Binding CurrentPageImage}" 
                               Stretch="None"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                        <Canvas x:Name="OverviewCanvasLeft" Background="Transparent"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <!-- Zoom Area if Left-Handed -->
            <Border IsVisible="{Binding !IsOverviewOnLeft}" Background="#0A0A0A" Margin="4" ClipToBounds="True">
                <Viewbox x:Name="ZoomedViewboxLeft" Stretch="Fill">
                    <Canvas x:Name="ZoomedCanvasLeft" Background="Transparent">
                        <Image x:Name="ZoomedAreaImageLeft" 
                               Source="{Binding CurrentPageImage}"
                               Stretch="Fill"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>

        <!-- Right Panel -->
        <Grid x:Name="RightPane">
            <!-- Zoom Area if Right-Handed -->
            <Border IsVisible="{Binding IsOverviewOnLeft}" Background="#0A0A0A" Margin="4" ClipToBounds="True">
                <Viewbox x:Name="ZoomedViewboxRight" Stretch="Fill">
                    <Canvas x:Name="ZoomedCanvasRight" Background="Transparent">
                        <Image x:Name="ZoomedAreaImageRight" 
                               Source="{Binding CurrentPageImage}"
                               Stretch="Fill"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <!-- Overview if Left-Handed -->
            <Border IsVisible="{Binding !IsOverviewOnLeft}" Background="#1A1A1A" Margin="4">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="OverviewContainerRight">
                        <Image x:Name="OverviewImageRight" 
                               Source="{Binding CurrentPageImage}" 
                               Stretch="None"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                        <Canvas x:Name="OverviewCanvasRight" Background="Transparent"/>
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</UserControl>
