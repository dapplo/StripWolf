<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StripWolf.Core.ViewModels"
             xmlns:views="using:StripWolf.Core.Views"
             xmlns:models="using:StripWolf.Core.Models"
             xmlns:komga="using:StripWolf.Core.Models.Komga"
             xmlns:converters="using:StripWolf.Core.Converters"
             xmlns:res="using:StripWolf.Core.Resources"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="StripWolf.Core.Views.KomgaView"
             x:DataType="vm:KomgaViewModel"
             x:Name="Root">
  <UserControl.Styles>
    <Style Selector="Button.icon-btn">
      <Setter Property="Padding" Value="4"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="SeriesCardTemplate" x:DataType="komga:KomgaSeriesDisplay">
      <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              Width="150" ClipToBounds="True">
        <Grid RowDefinitions="200,Auto,Auto,Auto">
          <Button Grid.Row="0" Grid.RowSpan="3" Padding="0" Background="Transparent"
                  Command="{Binding ((vm:KomgaViewModel)DataContext).SelectSeriesCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                  CommandParameter="{Binding}">
            <Grid RowDefinitions="200,Auto,Auto">
              <Border Grid.Row="0" Height="200" Background="Black" ClipToBounds="True">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Grid.Row="1" Height="34" Margin="8,4">
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2"
                           VerticalAlignment="Center" ToolTip.Tip="{Binding Summary}"/>
              </Border>
              <TextBlock Grid.Row="2" Text="{Binding BooksSummary}"
                          FontSize="10" Foreground="Gray" Margin="8,0,8,8"/>
            </Grid>
          </Button>
          <Panel Grid.Row="3" Margin="8,0,8,8">
            <Button Content="{Binding Download, Source={x:Static res:Loc.Instance}}" FontSize="10" Padding="8,4" HorizontalAlignment="Stretch"
                    Command="{Binding ((vm:KomgaViewModel)DataContext).DownloadSeriesCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                    CommandParameter="{Binding}">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!IsQueuedForDownload"/>
                  <Binding Path="!IsDownloading"/>
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsQueuedForDownload}">
              <TextBlock Text="{Binding Queued, Source={x:Static res:Loc.Instance}}" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
            </Border>
            <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsDownloading}">
              <TextBlock Text="{Binding Downloading, Source={x:Static res:Loc.Instance}}" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
            </Border>
          </Panel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="BookCardTemplate" x:DataType="komga:KomgaBookDisplay">
      <Border CornerRadius="8" Padding="0"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Width="150"
              ClipToBounds="True">
        <Grid RowDefinitions="200,Auto,Auto,Auto,Auto">
          <Button Grid.Row="0" Padding="0" Background="Transparent"
                  Command="{Binding ((vm:KomgaViewModel)DataContext).ShowBookInfoCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                  CommandParameter="{Binding}">
            <Border Height="200" Background="Black" ClipToBounds="True">
              <Panel>
                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Background="#80000000" IsVisible="{Binding IsRead}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4" CornerRadius="4" Padding="4,2">
                  <TextBlock Text="{Binding MarkRead, Source={x:Static res:Loc.Instance}, StringFormat='{}✓ {0}'}" Foreground="#4CAF50" FontSize="10" FontWeight="Bold"/>
                </Border>
                <Border Background="#80000000" IsVisible="{Binding IsReading}" VerticalAlignment="Bottom" Height="4">
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReadingProgress}" Height="4" Foreground="#2196F3" BorderThickness="0"/>
                </Border>
              </Panel>
            </Border>
          </Button>
          <Border Grid.Row="1" Height="44" Margin="8,4">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding SeriesTitle}" FontSize="10" Foreground="Gray"
                         TextTrimming="CharacterEllipsis" MaxLines="1"
                         IsVisible="{Binding SeriesTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                         TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Panel Grid.Row="2" Height="16" Margin="8,0,8,4">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReadingProgress}"
                         Height="4" VerticalAlignment="Center"
                         IsVisible="{Binding IsReading}"/>
            <TextBlock Text="{Binding PagesCount, StringFormat='{}{0} pages', FallbackValue='? pages'}"
                       FontSize="10" Foreground="Gray" VerticalAlignment="Center"
                       IsVisible="{Binding !IsReading}"/>
          </Panel>
          <Panel Grid.Row="3" Margin="8,0,8,4">
            <Button Content="{Binding Download, Source={x:Static res:Loc.Instance}}" FontSize="10" Padding="8,4" HorizontalAlignment="Stretch"
                    Command="{Binding ((vm:KomgaViewModel)DataContext).DownloadBookCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                    CommandParameter="{Binding}">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!IsQueued"/>
                  <Binding Path="!IsDownloading"/>
                  <Binding Path="!IsDownloaded"/>
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsQueued}">
              <TextBlock Text="{Binding Queued, Source={x:Static res:Loc.Instance}}" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel IsVisible="{Binding IsDownloading}" Spacing="2">
              <TextBlock Text="{Binding Downloading, Source={x:Static res:Loc.Instance}}" FontSize="10" HorizontalAlignment="Center"/>
              <ProgressBar Value="{Binding DownloadProgress}" Maximum="1" Height="4"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsCancelling}" Spacing="2">
              <TextBlock Text="{Binding Cancel, Source={x:Static res:Loc.Instance}, StringFormat='{}{0}...'}" FontSize="10" HorizontalAlignment="Center"/>
              <ProgressBar IsIndeterminate="True" Height="4"/>
            </StackPanel>
            <Border Background="Green" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsDownloaded}">
              <TextBlock Text="{Binding MarkRead, Source={x:Static res:Loc.Instance}, StringFormat='{}✓ {0}'}" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
            </Border>
          </Panel>
          <Grid Grid.Row="4" ColumnDefinitions="*,*,*" Margin="4,0,4,4" Height="32">
            <Button Grid.Column="0" Classes="icon-btn" Content="ⓘ"
                    Command="{Binding ((vm:KomgaViewModel)DataContext).ShowBookInfoCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                    CommandParameter="{Binding}" ToolTip.Tip="{Binding ComicInformation, Source={x:Static res:Loc.Instance}}"/>
            <Button Grid.Column="1" Classes="icon-btn" Content="≣"
                    Command="{Binding ((vm:KomgaViewModel)DataContext).ShowReadListPickerCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                    CommandParameter="{Binding}" ToolTip.Tip="{Binding AddToReadList, Source={x:Static res:Loc.Instance}}"/>
            <Button Grid.Column="2" Classes="icon-btn" Content="✓"
                    Command="{Binding ((vm:KomgaViewModel)DataContext).MarkBookAsReadCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                    CommandParameter="{Binding}" ToolTip.Tip="{Binding MarkRead, Source={x:Static res:Loc.Instance}}"
                    IsEnabled="{Binding !IsRead}"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Komga, Source={x:Static res:Loc.Instance}}" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="-" FontSize="24" VerticalAlignment="Center"
                     IsVisible="{Binding BrowsingServerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock Text="{Binding BrowsingServerName}" FontSize="18" VerticalAlignment="Center" Foreground="Gray"
                     IsVisible="{Binding BrowsingServerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
        <ComboBox Grid.Column="1" Width="220"
                  ItemsSource="{Binding ConfiguredServers}"
                  SelectedItem="{Binding SelectedServer}"
                  IsVisible="{Binding HasMultipleServers}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:KomgaServer">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Content="{Binding Refresh, Source={x:Static res:Loc.Instance}}" Command="{Binding RefreshCommand}" Padding="16,8"/>
      </Grid>
    </Border>
    
    <!-- Content -->
    <Grid Grid.Row="1">
      <!-- Not Connected State -->
      <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                  IsVisible="{Binding !IsConnected}">
        <TextBlock Text="🌐" FontSize="64" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding NotConnected, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding ConfigureServer, Source={x:Static res:Loc.Instance}}"
                   Foreground="Gray" HorizontalAlignment="Center" TextAlignment="Center"/>
      </StackPanel>

      <!-- Connected Content -->
      <ScrollViewer IsVisible="{Binding IsConnected}" Padding="16">
        <StackPanel Spacing="16" Margin="0,0,0,76">
          <!-- Search Box -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="{Binding SearchPlaceholder, Source={x:Static res:Loc.Instance}}"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="✕" Command="{Binding ClearSearchCommand}" 
                    Padding="8,6" Margin="4,0,0,0"
                    IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </Grid>

          <!-- Search Results Section -->
          <StackPanel Spacing="16" IsVisible="{Binding IsSearching}">
            <!-- Series Search Results -->
            <StackPanel Spacing="8" IsVisible="{Binding SearchSeriesResults.Count}">
              <TextBlock Text="{Binding SeriesResults, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
              <ListBox ItemsSource="{Binding SearchSeriesResults}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <StaticResource ResourceKey="SeriesCardTemplate"/>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <!-- Book Search Results -->
            <StackPanel Spacing="8" IsVisible="{Binding SearchBookResults.Count}">
              <TextBlock Text="{Binding BookResults, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
              <ListBox ItemsSource="{Binding SearchBookResults}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <StaticResource ResourceKey="BookCardTemplate"/>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <!-- No Results -->
            <TextBlock Text="{Binding NoResults, Source={x:Static res:Loc.Instance}}" Foreground="Gray" 
                       IsVisible="{Binding !SearchSeriesResults.Count}" Margin="0,8"/>
          </StackPanel>
          
          <!-- Error Message -->
          <Border Background="#FFEBEE" CornerRadius="8" Padding="12"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"/>
          </Border>

          <!-- Main Content (hidden when searching) -->
          <StackPanel Spacing="16" IsVisible="{Binding !IsSearching}">
            
          <!-- Breadcrumb Navigation -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Home" Command="{Binding GoBackToLibrariesCommand}"
                    Background="Transparent" Padding="0">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                  <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <TextBlock Text="/" VerticalAlignment="Center">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                  <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <!-- Read List breadcrumb -->
            <TextBlock x:DataType="komga:KomgaReadList" DataContext="{Binding SelectedReadList, ElementName=Root}" 
                       Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"
                       IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <!-- Library breadcrumb -->
            <Button x:DataType="komga:KomgaLibrary" DataContext="{Binding SelectedLibrary, ElementName=Root}"
                    Content="{Binding Name}" Command="{Binding GoBackToSeriesCommand, ElementName=Root}"
                    Background="Transparent" Padding="0"
                    IsVisible="{Binding SelectedSeries, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock x:DataType="komga:KomgaLibrary" DataContext="{Binding SelectedLibrary, ElementName=Root}"
                       Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="$self.DataContext" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                  <Binding Path="SelectedSeries" ElementName="Root" Converter="{x:Static ObjectConverters.IsNull}"/>
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <TextBlock Text="/" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedSeries, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock x:DataType="komga:KomgaSeries" DataContext="{Binding SelectedSeries, ElementName=Root}"
                       Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"
                       IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          </StackPanel>

          <!-- Libraries and Read Lists (shown when nothing is selected) -->
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
            <Grid.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNull}"/>
                <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNull}"/>
                <Binding Path="SelectedSeries" Converter="{x:Static ObjectConverters.IsNull}"/>
              </MultiBinding>
            </Grid.IsVisible>
            
            <!-- Keep Reading Section -->
            <Expander Grid.Row="{Binding KeepReadingSection.Order}" IsVisible="{Binding ShowKeepReadingSection}"
                      IsExpanded="{Binding KeepReadingSection.IsExpanded}">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding SectionKeepReading, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="↻" Command="{Binding RefreshSmartListsCommand}" 
                          Background="Transparent" FontSize="16" Padding="8,4" ToolTip.Tip="{Binding Refresh, Source={x:Static res:Loc.Instance}}"/>
                </Grid>
              </Expander.Header>
              <ListBox ItemsSource="{Binding KeepReadingBooks}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <StaticResource ResourceKey="BookCardTemplate"/>
                </ListBox.ItemTemplate>
              </ListBox>
            </Expander>
            
            <!-- On Deck Section -->
            <Expander Grid.Row="{Binding OnDeckSection.Order}" IsVisible="{Binding ShowOnDeckSection}"
                      IsExpanded="{Binding OnDeckSection.IsExpanded}">
              <Expander.Header>
                <TextBlock Text="{Binding SectionOnDeck, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
              </Expander.Header>
              <ListBox ItemsSource="{Binding OnDeckBooks}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <StaticResource ResourceKey="BookCardTemplate"/>
                </ListBox.ItemTemplate>
              </ListBox>
            </Expander>
            
            <!-- Recently Added Books Section -->
            <Expander Grid.Row="{Binding RecentBooksSection.Order}" IsVisible="{Binding ShowRecentBooksSection}"
                      IsExpanded="{Binding RecentBooksSection.IsExpanded}">
              <Expander.Header>
                <TextBlock Text="{Binding SectionRecentlyAddedBooks, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
              </Expander.Header>
              <ListBox ItemsSource="{Binding RecentlyAddedBooks}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <StaticResource ResourceKey="BookCardTemplate"/>
                </ListBox.ItemTemplate>
              </ListBox>
            </Expander>
            
            <!-- Recently Added Series Section -->
            <Expander Grid.Row="{Binding RecentSeriesSection.Order}" IsVisible="{Binding ShowRecentSeriesSection}"
                      IsExpanded="{Binding RecentSeriesSection.IsExpanded}">
              <Expander.Header>
                <TextBlock Text="{Binding SectionRecentlyAddedSeries, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
              </Expander.Header>
              <ListBox ItemsSource="{Binding RecentlyAddedSeries}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <StaticResource ResourceKey="SeriesCardTemplate"/>
                </ListBox.ItemTemplate>
              </ListBox>
            </Expander>
            
            <!-- Libraries List -->
            <Expander Grid.Row="{Binding LibrariesSection.Order}" IsVisible="{Binding ShowLibrariesSection}"
                      IsExpanded="{Binding LibrariesSection.IsExpanded}">
              <Expander.Header>
                <TextBlock Text="{Binding SectionLibraries, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
              </Expander.Header>
              <ListBox ItemsSource="{Binding Libraries}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="komga:KomgaLibrary">
                    <Button Padding="16" HorizontalAlignment="Stretch"
                            Command="{Binding ((vm:KomgaViewModel)DataContext).SelectLibraryCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="📚" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Expander>
            
            <!-- Read Lists -->
            <Expander Grid.Row="{Binding ReadListsSection.Order}" IsVisible="{Binding ShowReadListsSection}"
                      IsExpanded="{Binding ReadListsSection.IsExpanded}">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding SectionReadLists, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="↻" Command="{Binding RefreshReadListsCommand}" 
                          Background="Transparent" FontSize="16" Padding="8,4" ToolTip.Tip="{Binding Refresh, Source={x:Static res:Loc.Instance}}"/>
                </Grid>
              </Expander.Header>
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <ListBox ItemsSource="{Binding ReadLists}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="komga:KomgaReadListDisplay">
                      <Button Padding="0" Background="Transparent"
                              Command="{Binding ((vm:KomgaViewModel)DataContext).SelectReadListCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                              CommandParameter="{Binding}">
                        <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                                Width="150" ClipToBounds="True">
                          <Grid RowDefinitions="200,Auto,Auto">
                            <Border Grid.Row="0" Height="200" Background="Black" ClipToBounds="True">
                              <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="1" Height="34" Margin="8,4">
                              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                         TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="2" Text="{Binding BookCount, StringFormat='{}{0} books'}"
                                       FontSize="10" Foreground="Gray" Margin="8,0,8,8"/>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Load More Read Lists" Command="{Binding LoadMoreReadListsCommand}" 
                        HorizontalAlignment="Center" Margin="0,8,0,0"
                        IsVisible="{Binding HasMoreReadLists}"/>
              </StackPanel>
            </Expander>
          </Grid>

          <!-- Read List Books Grid -->
          <StackPanel Spacing="8" IsVisible="{Binding SelectedReadList, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*">
              <Button Grid.Column="0" Content="{Binding Back, Source={x:Static res:Loc.Instance}, StringFormat='{}← {0}'}" Command="{Binding GoBackToLibrariesCommand}"
                      Background="Transparent" Padding="0,4,12,4" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Books" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
            <ListBox ItemsSource="{Binding Books}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <StaticResource ResourceKey="BookCardTemplate"/>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <!-- Series Grid (only show when library is selected but no read list) -->
          <StackPanel Spacing="8">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNull}"/>
              </MultiBinding>
            </StackPanel.IsVisible>
            <StackPanel IsVisible="{Binding SelectedSeries, Converter={x:Static ObjectConverters.IsNull}}">
              <!-- Prefix Selector (A-Z) -->
              <ListBox ItemsSource="{Binding AvailablePrefixes}" 
                       SelectedItem="{Binding SelectedSeriesPrefix}"
                       Background="Transparent" 
                       Margin="0,0,0,16"
                       Padding="0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="8,4">
                      <TextBlock Text="{Binding}" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="2"/>
                    <Setter Property="Margin" Value="0,0,4,4"/>
                    <Setter Property="MinWidth" Value="36"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                  </Style>
                </ListBox.Styles>
              </ListBox>

              <TextBlock Text="{Binding SectionSeries, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
              
              <ListBox ItemsSource="{Binding Series}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <StaticResource ResourceKey="SeriesCardTemplate"/>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </StackPanel>

          <!-- Books Grid (for series) -->
          <StackPanel Spacing="8">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="SelectedSeries" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNull}"/>
              </MultiBinding>
            </StackPanel.IsVisible>
            
             <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
               <Button Grid.Column="0" Content="{Binding Back, Source={x:Static res:Loc.Instance}, StringFormat='{}← {0}'}" Command="{Binding GoBackToSeriesCommand}"
                       Background="Transparent" Padding="0,4,12,4" VerticalAlignment="Center"/>
               <TextBlock Grid.Column="1" Text="Books" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

               <Button Grid.Column="2" Content="{Binding Download, Source={x:Static res:Loc.Instance}, StringFormat='{}📥 {0}'}"
                       Command="{Binding DownloadSelectedSeriesCommand}"
                       Background="Transparent" Padding="8,4" VerticalAlignment="Center">
                 <Button.IsVisible>
                   <MultiBinding Converter="{x:Static BoolConverters.And}">
                     <Binding Path="SelectedSeries" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                     <Binding Path="!IsSelectedSeriesQueuedForDownload"/>
                     <Binding Path="!IsSelectedSeriesDownloading"/>
                   </MultiBinding>
                 </Button.IsVisible>
               </Button>
               <Border Grid.Column="2" Background="{DynamicResource SystemAccentColor}" CornerRadius="4" Padding="8,4"
                       VerticalAlignment="Center" IsVisible="{Binding IsSelectedSeriesQueuedForDownload}">
                 <TextBlock Text="{Binding Queued, Source={x:Static res:Loc.Instance}}" Foreground="White" FontSize="10"/>
               </Border>
               <Border Grid.Column="2" Background="{DynamicResource SystemAccentColor}" CornerRadius="4" Padding="8,4"
                       VerticalAlignment="Center" IsVisible="{Binding IsSelectedSeriesDownloading}">
                 <TextBlock Text="{Binding Downloading, Source={x:Static res:Loc.Instance}}" Foreground="White" FontSize="10"/>
               </Border>
               
               <!-- Sort Order Toggle -->
               <Button Grid.Column="3" Command="{Binding CycleSortOrderCommand}"
                       Background="Transparent" Padding="8,4" Margin="4,0" VerticalAlignment="Center">
                 <StackPanel Orientation="Horizontal" Spacing="4">
                   <TextBlock Text="{Binding Sort, Source={x:Static res:Loc.Instance}, StringFormat='{}{0}:'}"/>
                   <TextBlock Text="{Binding SelectedBookSortOrder}"/>
                 </StackPanel>
               </Button>
               
               <!-- Sort Direction Toggle -->
               <Button Grid.Column="4" Command="{Binding ToggleSortDirectionCommand}"
                       Background="Transparent" Padding="8,4" VerticalAlignment="Center">
                 <TextBlock Text="{Binding IsSortDescending, Converter={x:Static converters:FilePathToBitmapConverter.SortDirectionIconConverter}}"/>
               </Button>
             </Grid>

            <ListBox ItemsSource="{Binding Books}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <StaticResource ResourceKey="BookCardTemplate"/>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          
          </StackPanel> <!-- End of Main Content (hidden when searching) -->
        </StackPanel>
      </ScrollViewer>

      <!-- Floating Load More Button for Series - Always visible at the bottom when browsing series -->
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" 
              Margin="0,0,0,16" Padding="4" CornerRadius="20"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsConnected"/>
            <Binding Path="!IsSearching"/>
            <Binding Path="HasMoreSeries"/>
            <Binding Path="SelectedLibrary" Converter="{x:Static ObjectConverters.IsNotNull}"/>
            <Binding Path="SelectedSeries" Converter="{x:Static ObjectConverters.IsNull}"/>
            <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNull}"/>
          </MultiBinding>
        </Border.IsVisible>
        <Button Content="{Binding LoadMoreSeries, Source={x:Static res:Loc.Instance}, StringFormat='{}📥 {0}'}" Padding="16,8"
                Command="{Binding LoadMoreSeriesCommand}"/>
      </Border>

      <!-- Floating Load More Button for Books (series) - Always visible at the bottom when browsing books in a series -->
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" 
              Margin="0,0,0,16" Padding="4" CornerRadius="20"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsConnected"/>
            <Binding Path="!IsSearching"/>
            <Binding Path="HasMoreBooks"/>
            <Binding Path="SelectedSeries" Converter="{x:Static ObjectConverters.IsNotNull}"/>
            <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNull}"/>
          </MultiBinding>
        </Border.IsVisible>
        <Button Content="{Binding LoadMoreBooks, Source={x:Static res:Loc.Instance}, StringFormat='{}📥 {0}'}" Padding="16,8"
                Command="{Binding LoadMoreBooksCommand}"/>
      </Border>

      <!-- Floating Load More Button for Books (read list) - Always visible at the bottom when browsing books in a read list -->
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" 
              Margin="0,0,0,16" Padding="4" CornerRadius="20"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsConnected"/>
            <Binding Path="!IsSearching"/>
            <Binding Path="HasMoreBooks"/>
            <Binding Path="SelectedReadList" Converter="{x:Static ObjectConverters.IsNotNull}"/>
          </MultiBinding>
        </Border.IsVisible>
        <Button Content="{Binding LoadMoreBooks, Source={x:Static res:Loc.Instance}, StringFormat='{}📥 {0}'}" Padding="16,8"
                Command="{Binding LoadMoreBooksForReadListCommand}"/>
      </Border>

      <!-- Series Download Picker Overlay -->
      <Panel IsVisible="{Binding SeriesPendingDownloadSelection, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Button Background="#80000000" Command="{Binding CancelSeriesDownloadSelectionCommand}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Padding="0" BorderThickness="0"/>
        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                CornerRadius="8" Padding="24" Width="420"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 4 20 0 #40000000">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding DownloadSeries, Source={x:Static res:Loc.Instance}}" FontSize="20" FontWeight="Bold"/>
              <Button Grid.Column="1" Content="✕" Command="{Binding CancelSeriesDownloadSelectionCommand}"
                      Background="Transparent" Padding="8,4"/>
            </Grid>
            <TextBlock x:DataType="komga:KomgaSeriesDisplay" DataContext="{Binding SeriesPendingDownloadSelection, ElementName=Root}"
                       Text="{Binding Name, StringFormat='Choose what to download for {0}'}"
                       TextWrapping="Wrap" Foreground="Gray"
                       IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock Text="Already-downloaded books are skipped automatically." Foreground="Gray" FontSize="12"/>
            <Button Content="📥 All missing books" Command="{Binding ConfirmSeriesDownloadAllCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Button Content="📖 Unread missing books" Command="{Binding ConfirmSeriesDownloadUnreadCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Busy Overlay -->
      <Panel IsVisible="{Binding IsBusy}">
        <Border Background="#66000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                CornerRadius="8" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 4 20 0 #40000000">
          <StackPanel Spacing="12" Width="220">
            <TextBlock Text="Loading Komga..." FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" Height="6"/>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Floating back button – rendered above the busy overlay so it is always accessible -->
      <Button HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="16,16"
              Content="{Binding Back, Source={x:Static res:Loc.Instance}, StringFormat='{}← {0}'}"
              Command="{Binding GoBackToSeriesCommand}"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              Padding="12,6" CornerRadius="4">
        <Button.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsBusy"/>
            <Binding Path="SelectedSeries" Converter="{x:Static ObjectConverters.IsNotNull}"/>
          </MultiBinding>
        </Button.IsVisible>
      </Button>

      <!-- Read List Picker Overlay -->
      <Panel IsVisible="{Binding BookPendingReadListSelection, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Button Background="#80000000" Command="{Binding CancelReadListSelectionCommand}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Padding="0" BorderThickness="0"/>
        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                CornerRadius="8" Padding="24" Width="420" MaxHeight="600"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 4 20 0 #40000000">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Add to Read List" FontSize="20" FontWeight="Bold"/>
              <Button Grid.Column="1" Content="✕" Command="{Binding CancelReadListSelectionCommand}"
                      Background="Transparent" Padding="8,4"/>
            </Grid>
            <TextBlock x:DataType="komga:KomgaBookDisplay" DataContext="{Binding BookPendingReadListSelection}"
                       Text="{Binding Name, StringFormat='Choose a read list for {0}'}"
                       TextWrapping="Wrap" Foreground="Gray"
                       IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock Text="Loading read lists..." IsVisible="{Binding IsLoadingReadListSelection}" HorizontalAlignment="Center"/>
            <ScrollViewer MaxHeight="360" IsVisible="{Binding !IsLoadingReadListSelection}">
              <ItemsControl ItemsSource="{Binding AvailableReadLists}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="komga:KomgaReadList">
                    <Button Padding="12" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                            Command="{Binding ((vm:KomgaViewModel)DataContext).AddBookToReadListCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                          <TextBlock Text="{Binding Summary}" Foreground="Gray" FontSize="12"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding BookIds.Count, StringFormat='{}{0} books'}"
                                   Foreground="Gray" VerticalAlignment="Center"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Book Info Overlay -->
      <Panel IsVisible="{Binding SelectedInfoBookDisplay, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Button Background="#80000000" Command="{Binding CloseBookInfoCommand}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Padding="0" BorderThickness="0"/>
        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                CornerRadius="8" Padding="0" MaxWidth="560" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 4 20 0 #40000000">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource SystemAccentColor}" Padding="16" CornerRadius="8,8,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding ComicInformation, Source={x:Static res:Loc.Instance}}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Command="{Binding CloseBookInfoCommand}"
                        Background="Transparent" Foreground="White" Padding="8,4"/>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" MaxHeight="640">
              <Border Padding="24">
                <StackPanel Spacing="16" x:DataType="komga:KomgaBookDisplay"
                            DataContext="{Binding SelectedInfoBookDisplay}">
                  <Grid ColumnDefinitions="150,*">
                    <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Background="Black" Height="200">
                      <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                      <StackPanel IsVisible="{Binding SeriesTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding SectionSeries, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray"/>
                        <TextBlock Text="{Binding SeriesTitle}" FontSize="16"/>
                      </StackPanel>
                      <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding Number, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray"/>
                          <TextBlock Text="{Binding NumberLabel}" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Pages, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray"/>
                          <TextBlock Text="{Binding PagesCount}" FontSize="16"/>
                        </StackPanel>
                      </Grid>
                      <StackPanel IsVisible="{Binding AuthorsDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Creators, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray"/>
                        <TextBlock Text="{Binding AuthorsDisplay}" FontSize="14" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <StackPanel IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Summary, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="14"/>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Content="{Binding Download, Source={x:Static res:Loc.Instance}}"
                            Command="{Binding ((vm:KomgaViewModel)DataContext).DownloadBookCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                            CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="{Binding MarkRead, Source={x:Static res:Loc.Instance}, StringFormat='{}✓ {0}'}"
                            Command="{Binding ((vm:KomgaViewModel)DataContext).MarkBookAsReadCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                            CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            IsEnabled="{Binding !IsRead}"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Content="📝 Add to Read List"
                            Command="{Binding ((vm:KomgaViewModel)DataContext).ShowReadListPickerCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                            CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="{Binding SectionSeries, Source={x:Static res:Loc.Instance}, StringFormat='{}📚 {0}'}"
                            Command="{Binding ((vm:KomgaViewModel)DataContext).ViewSelectedBookSeriesCommand, RelativeSource={RelativeSource AncestorType=views:KomgaView}}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                  </Grid>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </Grid>
        </Border>
      </Panel>
    </Grid>
  </Grid>
</UserControl>
