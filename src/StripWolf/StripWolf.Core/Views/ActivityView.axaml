<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StripWolf.Core.ViewModels"
             xmlns:models="using:StripWolf.Core.Models"
             xmlns:komga="using:StripWolf.Core.Models.Komga"
             xmlns:repeater="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:res="using:StripWolf.Core.Resources"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="StripWolf.Core.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="16">
      <TextBlock Text="{Binding Activity, Source={x:Static res:Loc.Instance}}" FontSize="24" FontWeight="Bold"/>

      <Border Padding="12" CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Downloads, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
          <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
            <Button Grid.Column="0" Content="{Binding PauseAll, Source={x:Static res:Loc.Instance}}" Command="{Binding Komga.PauseAllDownloadsCommand}"/>
            <Button Grid.Column="1" Content="{Binding ResumeAll, Source={x:Static res:Loc.Instance}}" Command="{Binding Komga.ResumeAllDownloadsCommand}"/>
            <Button Grid.Column="2" Content="{Binding RetryFailed, Source={x:Static res:Loc.Instance}}" Command="{Binding Komga.RetryFailedDownloadsCommand}"/>
            <Button Grid.Column="3" Content="{Binding CancelAll, Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Right" Command="{Binding Komga.CancelAllDownloadsCommand}"/>
          </Grid>
          <TextBlock Text="{Binding Komga.DownloadingBookName}" IsVisible="{Binding Komga.IsDownloading}" FontSize="12"/>
          <ProgressBar Value="{Binding Komga.DownloadProgress}" Maximum="1" Height="6" IsVisible="{Binding Komga.IsDownloading}"/>
          <repeater:ItemsRepeater ItemsSource="{Binding DownloadQueueItems}">
            <repeater:ItemsRepeater.Layout>
              <layout:StackLayout Orientation="Vertical" Spacing="8"/>
            </repeater:ItemsRepeater.Layout>
            <repeater:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="komga:KomgaDownloadQueueItem">
                <Border Padding="8" CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundChromeHighBrush}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                    <StackPanel Grid.Row="0" Grid.Column="0">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding SeriesTitle}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.RowSpan="3" Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                      <Button Content="↻"
                              Command="{Binding ((vm:ActivityViewModel)DataContext).Komga.RetryDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" Padding="8,4"
                              ToolTip.Tip="{Binding RetryFailed, Source={x:Static res:Loc.Instance}}"
                              IsVisible="{Binding IsFailed}"/>
                      <Button Content="✕"
                              Command="{Binding ((vm:ActivityViewModel)DataContext).Komga.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" Padding="8,4"
                              IsEnabled="{Binding !IsCancelling}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Queued, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="Gray" IsVisible="{Binding IsQueued}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Downloading, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="Gray" IsVisible="{Binding IsDownloading}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Failed, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="#C62828" IsVisible="{Binding IsFailed}"/>
                    <ProgressBar Grid.Row="2" Grid.Column="0" Value="{Binding Progress}" Maximum="1" Height="4" IsVisible="{Binding IsDownloading}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ErrorMessage}" FontSize="10" Foreground="#C62828" TextWrapping="Wrap" IsVisible="{Binding IsFailed}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </repeater:ItemsRepeater.ItemTemplate>
          </repeater:ItemsRepeater>
        </StackPanel>
      </Border>

      <Border Padding="12" CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Imports, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
          <repeater:ItemsRepeater ItemsSource="{Binding PendingImports}">
            <repeater:ItemsRepeater.Layout>
              <layout:StackLayout Orientation="Vertical" Spacing="8"/>
            </repeater:ItemsRepeater.Layout>
            <repeater:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="models:PendingImport">
                <Border CornerRadius="8" Padding="12"
                        Background="{DynamicResource SystemControlBackgroundChromeHighBrush}">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Grid.RowSpan="3" Text="📄" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Status}" FontSize="12" Foreground="Gray"/>
                    <ProgressBar Grid.Column="1" Grid.Row="2" Value="{Binding Progress}" Maximum="1" Height="5" IsVisible="{Binding IsProcessing}"/>
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding ErrorMessage}" FontSize="10" Foreground="#C62828" IsVisible="{Binding IsFailed}" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Grid.RowSpan="3" Content="✕" FontSize="12" Padding="8,4"
                            IsVisible="{Binding IsFailed}"
                            Command="{Binding ((vm:ActivityViewModel)DataContext).Library.RemovePendingImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <TextBlock Grid.Column="2" Grid.RowSpan="3" Text="✓" FontSize="20" Foreground="Green" VerticalAlignment="Center" IsVisible="{Binding IsCompleted}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </repeater:ItemsRepeater.ItemTemplate>
          </repeater:ItemsRepeater>
        </StackPanel>
      </Border>

      <Border Padding="12" CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              IsVisible="{Binding EpubConversions.Count}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding EpubConversions, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
          <repeater:ItemsRepeater ItemsSource="{Binding EpubConversions}">
            <repeater:ItemsRepeater.Layout>
              <layout:StackLayout Orientation="Vertical" Spacing="8"/>
            </repeater:ItemsRepeater.Layout>
            <repeater:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="models:EpubConversionState">
                <Border CornerRadius="8" Padding="12"
                        Background="{DynamicResource SystemControlBackgroundChromeHighBrush}">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Grid.RowSpan="2" Text="📚" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding SourceEpubPath}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Status}" FontSize="12" Foreground="Gray"/>
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding ProducedPageCount}" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding PagesReady, Source={x:Static res:Loc.Instance}}" FontSize="10" Foreground="Gray" HorizontalAlignment="Right"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </repeater:ItemsRepeater.ItemTemplate>
          </repeater:ItemsRepeater>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
