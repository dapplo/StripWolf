<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StripWolf.Core.ViewModels"
             xmlns:models="using:StripWolf.Core.Models"
             xmlns:res="using:StripWolf.Core.Resources"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="StripWolf.Core.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  
  <Grid>
    <!-- Server List View -->
    <ScrollViewer IsVisible="{Binding !IsEditing}" Padding="16">
      <StackPanel Spacing="16" Margin="0,0,0,76">
        <!-- Header -->
        <TextBlock Text="{Binding Settings, Source={x:Static res:Loc.Instance}}" FontSize="24" FontWeight="Bold"/>
        
        <!-- About Section -->
        <TextBlock Text="{Binding About, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" Margin="0,16,0,0"/>
        <Border Padding="16" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="StripWolf" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding AppDescription, Source={x:Static res:Loc.Instance}}" Foreground="Gray"/>
            <TextBlock Text="{Binding AppVersion}" Foreground="Gray" FontSize="12"/>
            
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                <Button Content="{Binding ProjectOnGitHub, Source={x:Static res:Loc.Instance}}" Command="{Binding OpenGitHubCommand}"
                        Background="Transparent" Padding="0"/>
            </StackPanel>

            <Separator Margin="0,8"/>
            
            <Expander IsExpanded="{Binding IsSupportMeVisible}" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding SupportMe, Source={x:Static res:Loc.Instance}}"/>
                        <TextBlock Text="❤" Foreground="Red"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <Button Content="{Binding DonateWithPayPal, Source={x:Static res:Loc.Instance}}" Command="{Binding OpenPayPalCommand}" HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding DonateWithKoFi, Source={x:Static res:Loc.Instance}}" Command="{Binding OpenKoFiCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <!-- Error Message -->
        <Border Background="#FFEBEE" CornerRadius="8" Padding="12"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"/>
        </Border>

        <!-- Komga Servers Section -->
        <TextBlock Text="{Binding KomgaServers, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
        
        <!-- Add Server Button -->
        <Button Content="{Binding AddServer, Source={x:Static res:Loc.Instance}}" Command="{Binding AddServerCommand}" HorizontalAlignment="Left"/>

        <!-- Servers List -->
        <ItemsControl ItemsSource="{Binding Servers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:KomgaServer">
              <Border Padding="16" Margin="0,0,0,8" CornerRadius="8" 
                      Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                      <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                              Padding="6,2" CornerRadius="4" 
                              IsVisible="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ActiveServerId, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={Binding Id}}">
                        <TextBlock Text="{Binding Browsing, Source={x:Static res:Loc.Instance}}" Foreground="White" FontSize="10"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding BaseUrl}" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{Binding Username}" Foreground="Gray" FontSize="12"/>
                  </StackPanel>

                  <Button Grid.Column="1" Content="✓"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SetBrowsingServerCommand}"
                          CommandParameter="{Binding}"
                          IsVisible="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ActiveServerId, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={Binding Id}}"
                          Background="Transparent" FontSize="20" Width="44"
                          ToolTip.Tip="{Binding SetAsBrowsingServer, Source={x:Static res:Loc.Instance}}"/>                  
                  <Button Grid.Column="2" Content="✏️"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).EditServerCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent" FontSize="16" Width="44"/>
                  
                  <Button Grid.Column="3" Content="🗑️"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteServerCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent" FontSize="16" Width="44"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty State -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="32"
                    IsVisible="{Binding !Servers.Count}">
          <TextBlock Text="{Binding NoServersConfigured, Source={x:Static res:Loc.Instance}}" Foreground="Gray" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding AddServerHint, Source={x:Static res:Loc.Instance}}"
                     Foreground="Gray" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>

        <!-- Language Settings Section -->
        <TextBlock Text="{Binding LanguageSettings, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" Margin="0,16,0,0"/>
        <Border Padding="16" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Language, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding AvailableLanguages}" 
                      SelectedItem="{Binding SelectedLanguage}"
                      HorizontalAlignment="Stretch"
                      Width="300">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding LanguageDescription, Source={x:Static res:Loc.Instance}}"
                       Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding ReadingSettings, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" Margin="0,16,0,0"/>
        <Border Padding="16" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="16">
            <!-- Startup Behavior Selection -->
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding StartupBehavior, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding AvailableStartupBehaviors}" 
                        SelectedItem="{Binding SelectedStartupBehaviorOption}"
                        HorizontalAlignment="Stretch"
                        Width="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StartupBehaviorOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding StartupBehaviorHint, Source={x:Static res:Loc.Instance}}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <Separator/>

            <!-- Reading Mode Selection -->
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding DefaultReadingMode, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding AvailableReadingModes}" 
                        SelectedItem="{Binding SelectedReadingModeOption}"
                        HorizontalAlignment="Stretch"
                        Width="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReadingModeOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap">
                <Run Text="{Binding ReadingModeNormalDescription, Source={x:Static res:Loc.Instance}}"/>
                <LineBreak/>
                <Run Text="{Binding ReadingModeZoomedDescription, Source={x:Static res:Loc.Instance}}"/>
                <LineBreak/>
                <Run Text="{Binding ReadingModeGuidedDescription, Source={x:Static res:Loc.Instance}}"/>
              </TextBlock>
            </StackPanel>
            
            <!-- Handedness Selection -->
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Handedness, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding AvailableHandednessOptions}" 
                        SelectedItem="{Binding SelectedHandednessOption}"
                        HorizontalAlignment="Stretch"
                        Width="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HandednessOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding HandednessDescription, Source={x:Static res:Loc.Instance}}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <Separator/>

            <!-- Compact Overview Toggle -->
            <StackPanel Spacing="8">
              <ToggleSwitch IsChecked="{Binding CompactOverview}" 
                            OnContent="{Binding CompactOverviewEnabled, Source={x:Static res:Loc.Instance}}" 
                            OffContent="{Binding CompactOverviewDisabled, Source={x:Static res:Loc.Instance}}"/>
              <TextBlock Text="{Binding CompactOverviewDescription, Source={x:Static res:Loc.Instance}}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <Separator/>

            <StackPanel Spacing="8">
              <TextBlock Text="{Binding AppTheme, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding AvailableAppThemes}"
                        SelectedItem="{Binding SelectedAppThemeOption}"
                        HorizontalAlignment="Stretch"
                        Width="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AppThemeOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding AppThemeDescription, Source={x:Static res:Loc.Instance}}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding SupportsEpubFeatures}">
              <TextBlock Text="{Binding EpubConversionTheme, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding AvailableEpubConversionThemes}"
                        SelectedItem="{Binding SelectedEpubConversionThemeOption}"
                        HorizontalAlignment="Stretch"
                        Width="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EpubConversionThemeOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding EpubConversionThemeDescription, Source={x:Static res:Loc.Instance}}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding SupportsEpubFeatures}">
              <TextBlock Text="{Binding EpubOutputResolution, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding AvailableEpubOutputResolutions}"
                        SelectedItem="{Binding SelectedEpubOutputResolutionOption}"
                        HorizontalAlignment="Stretch"
                        Width="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EpubOutputResolutionOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding EpubOutputResolutionDescription, Source={x:Static res:Loc.Instance}}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{Binding UnsupportedFormatHandling, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding AvailableUnsupportedFormatHandlingModes}"
                        SelectedItem="{Binding SelectedUnsupportedFormatHandlingModeOption}"
                        HorizontalAlignment="Stretch"
                        Width="300">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:UnsupportedFormatHandlingModeOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding UnsupportedFormatHandlingDescription}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{Binding KomgaParallelDownloads, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding AvailableKomgaParallelDownloadOptions}"
                        SelectedItem="{Binding SelectedKomgaParallelDownloads}"
                        HorizontalAlignment="Stretch"
                        Width="300"/>
              <TextBlock Text="{Binding KomgaParallelDownloadsDescription, Source={x:Static res:Loc.Instance}}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <Separator/>

            <StackPanel Spacing="8">
              <ToggleSwitch IsChecked="{Binding SkipExternalDeleteConfirmation}"
                            OnContent="{Binding SkipExternalDeleteConfirmationEnabled, Source={x:Static res:Loc.Instance}}"
                            OffContent="{Binding SkipExternalDeleteConfirmationDisabled, Source={x:Static res:Loc.Instance}}"/>
              <TextBlock Text="{Binding SkipExternalDeleteConfirmationDescription, Source={x:Static res:Loc.Instance}}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <Separator/>

            <StackPanel Spacing="8">
              <ToggleSwitch IsChecked="{Binding SyncReadProgress}"
                            OnContent="{Binding SyncReadProgressEnabled, Source={x:Static res:Loc.Instance}}"
                            OffContent="{Binding SyncReadProgressDisabled, Source={x:Static res:Loc.Instance}}"/>
              <TextBlock Text="{Binding SyncReadProgressDescription, Source={x:Static res:Loc.Instance}}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Section Layout Settings -->
        <TextBlock Text="{Binding SectionLayout, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" Margin="0,16,0,0"/>
        <Border Padding="16" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="16">
            <TextBlock Text="{Binding SectionLayoutDescription, Source={x:Static res:Loc.Instance}}"
                       Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>

            <StackPanel Spacing="8">
              <TextBlock Text="{Binding KomgaHome, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding KomgaSections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:SectionLayoutPreference">
                    <Border Padding="12" Margin="0,0,0,8" CornerRadius="8"
                            Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsVisible}" 
                                      OnContent="{Binding Shown, Source={x:Static res:Loc.Instance}}" 
                                      OffContent="{Binding Hidden, Source={x:Static res:Loc.Instance}}"
                                      VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsExpanded}" 
                                      OnContent="{Binding Expanded, Source={x:Static res:Loc.Instance}}" 
                                      OffContent="{Binding Collapsed, Source={x:Static res:Loc.Instance}}"
                                      VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="↑"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveSectionUpCommand}"
                                CommandParameter="{Binding}" Width="36"/>
                        <Button Grid.Column="4" Content="↓"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveSectionDownCommand}"
                                CommandParameter="{Binding}" Width="36"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Library, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding LibrarySections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:SectionLayoutPreference">
                    <Border Padding="12" Margin="0,0,0,8" CornerRadius="8"
                            Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsVisible}" 
                                      OnContent="{Binding Shown, Source={x:Static res:Loc.Instance}}" 
                                      OffContent="{Binding Hidden, Source={x:Static res:Loc.Instance}}"
                                      VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsExpanded}" 
                                      OnContent="{Binding Expanded, Source={x:Static res:Loc.Instance}}" 
                                      OffContent="{Binding Collapsed, Source={x:Static res:Loc.Instance}}"
                                      VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="↑"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveSectionUpCommand}"
                                CommandParameter="{Binding}" Width="36"/>
                        <Button Grid.Column="4" Content="↓"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveSectionDownCommand}"
                                CommandParameter="{Binding}" Width="36"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Edit Server Form -->
    <ScrollViewer IsVisible="{Binding IsEditing}" Padding="16">
      <StackPanel Spacing="16" MaxWidth="400" Margin="0,0,0,76">
        <TextBlock Text="{Binding ServerConfiguration, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
        
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Name, Source={x:Static res:Loc.Instance}}"/>
          <TextBox Text="{Binding ServerName}" PlaceholderText="My Komga Server"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding ServerUrl, Source={x:Static res:Loc.Instance}}"/>
          <TextBox Text="{Binding ServerUrl}" PlaceholderText="https://komga.example.com"/>
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Text="{Binding AuthenticationTitle, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4"/>

          <!-- API Key Section (Preferred) -->
          <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="12" CornerRadius="4">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding ApiKeyTitle, Source={x:Static res:Loc.Instance}}" FontSize="12" FontWeight="Bold"/>
              <TextBox Text="{Binding ApiKey}" PlaceholderText="{Binding ApiKeyPlaceholder, Source={x:Static res:Loc.Instance}}"/>
              <TextBlock Text="{Binding ApiKeyHint, Source={x:Static res:Loc.Instance}}" FontSize="10" Foreground="Gray"/>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding Or, Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Center" FontSize="10" Foreground="Gray" FontWeight="Bold"/>

          <!-- Username/Password Section -->
          <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="12" CornerRadius="4">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding UsernamePasswordTitle, Source={x:Static res:Loc.Instance}}" FontSize="12" FontWeight="Bold"/>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Username, Source={x:Static res:Loc.Instance}}" FontSize="11"/>
                <TextBox Text="{Binding Username}" PlaceholderText="{Binding UsernamePlaceholder, Source={x:Static res:Loc.Instance}}"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Password, Source={x:Static res:Loc.Instance}}" FontSize="11"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding Password}" PlaceholderText="{Binding PasswordPlaceholder, Source={x:Static res:Loc.Instance}}" 
                           PasswordChar="•" RevealPassword="{Binding IsPasswordVisible}"/>
                  <Button Grid.Column="1" Command="{Binding TogglePasswordVisibilityCommand}" 
                          Margin="4,0,0,0" ToolTip.Tip="{Binding ShowHidePassword, Source={x:Static res:Loc.Instance}}" Padding="8,6">
                    <Panel>
                      <TextBlock Text="👁" FontSize="14" IsVisible="{Binding !IsPasswordVisible}"/>
                      <TextBlock Text="🙈" FontSize="14" IsVisible="{Binding IsPasswordVisible}"/>
                    </Panel>
                  </Button>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="{Binding CustomHttpHeaders, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding CustomHeadersHint, Source={x:Static res:Loc.Instance}}" FontSize="10" Foreground="Gray"/>

          <ItemsControl ItemsSource="{Binding CustomHeaders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:KomgaHeader">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                  <TextBox Text="{Binding Name}" PlaceholderText="{Binding HeaderName, Source={x:Static res:Loc.Instance}}"/>
                  <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="{Binding Value, Source={x:Static res:Loc.Instance}}"/>
                  <Button Grid.Column="2" Content="🗑️" 
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveHeaderCommand}"
                          CommandParameter="{Binding}" Background="Transparent"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="{Binding AddHeader, Source={x:Static res:Loc.Instance}}" Command="{Binding AddHeaderCommand}" HorizontalAlignment="Left" FontSize="12"/>
        </StackPanel>


        <!-- Connection Status -->
        <TextBlock Text="{Binding ConnectionStatus}" HorizontalAlignment="Center"
                   IsVisible="{Binding ConnectionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Content="{Binding TestConnection, Source={x:Static res:Loc.Instance}}" Command="{Binding TestConnectionCommand}"
                  IsEnabled="{Binding !IsTestingConnection}"/>
          
          <Button Content="{Binding Cancel, Source={x:Static res:Loc.Instance}}" Command="{Binding CancelEditCommand}"/>
          
          <Button Content="{Binding Save, Source={x:Static res:Loc.Instance}}" Command="{Binding SaveServerCommand}" Classes="accent"/>
        </StackPanel>

        <!-- Testing Indicator -->
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTestingConnection}"
                     HorizontalAlignment="Center" Width="100"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Server Delete Confirmation Overlay -->
    <Panel Background="#80000000" IsVisible="{Binding ShowServerDeleteConfirmation}">
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
              CornerRadius="8" Padding="24" MaxWidth="400"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding ConfirmDeleteServer, Source={x:Static res:Loc.Instance}}" 
                     FontSize="18" FontWeight="Bold"/>
          
          <TextBlock TextWrapping="Wrap">
            <Run Text="There are "/>
            <Run Text="{Binding LinkedComicsCount}" FontWeight="Bold"/>
            <Run Text=" comics linked to this server. If you delete it, their reading progress will no longer be synchronized. Do you want to proceed?"/>
          </TextBlock>

          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="{Binding Cancel, Source={x:Static res:Loc.Instance}}" 
                    Command="{Binding CancelDeleteServerCommand}"/>
            <Button Content="{Binding Delete, Source={x:Static res:Loc.Instance}}" 
                    Command="{Binding ConfirmDeleteServerCommand}" Classes="accent"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
