<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StripWolf.Core.ViewModels"
             xmlns:models="using:StripWolf.Core.Models"
             xmlns:res="using:StripWolf.Core.Resources"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="StripWolf.Core.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  
  <Grid>
    <!-- Server List View -->
    <ScrollViewer IsVisible="{Binding !IsEditing}" Padding="16">
      <Grid HorizontalAlignment="Center" MaxWidth="980">
        <StackPanel Spacing="20" Margin="0,0,0,76">
          <TextBlock Text="{Binding Settings, Source={x:Static res:Loc.Instance}}" FontSize="24" FontWeight="Bold"/>

          <Border Background="#FFEBEE" CornerRadius="8" Padding="12"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap"/>
          </Border>

          <TextBlock Text="{Binding About, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
          <Border Padding="16" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel Spacing="8">
              <TextBlock Text="StripWolf" FontSize="16" FontWeight="Bold"/>
              <TextBlock Text="{Binding AppDescription, Source={x:Static res:Loc.Instance}}" Foreground="Gray"/>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppVersion}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding UpdateService.IsNewerVersionAvailable}" VerticalAlignment="Center">
                  <TextBlock Text="•" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                  <Button Content="{Binding NewerVersionAvailable, Source={x:Static res:Loc.Instance}}"
                          Command="{Binding OpenGitHubReleasesCommand}"
                          Foreground="#E5A93C"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          FontSize="12"
                          Cursor="Hand"
                          VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !UpdateService.IsNewerVersionAvailable}" VerticalAlignment="Center">
                  <Button Command="{Binding CheckForUpdatesCommand}"
                          IsEnabled="{Binding !UpdateService.IsChecking}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="4,0"
                          ToolTip.Tip="{Binding CheckForUpdates, Source={x:Static res:Loc.Instance}}"
                          VerticalAlignment="Center">
                    <TextBlock Text="↻" FontSize="12"/>
                  </Button>
                  <TextBlock Text="{Binding UpdateService.UpdateStatus}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"
                             IsVisible="{Binding UpdateService.UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                <Button Content="{Binding ProjectOnGitHub, Source={x:Static res:Loc.Instance}}" Command="{Binding OpenGitHubCommand}"
                        Background="Transparent" Padding="0"/>
                <TextBlock Text="•" Foreground="Gray" VerticalAlignment="Center"/>
                <Button Content="Report an Issue" Command="{Binding ReportIssueCommand}"
                        Background="Transparent" Padding="0"/>
              </StackPanel>

              <Separator Margin="0,8" IsVisible="{Binding IsSupportMeAllowed}"/>

              <Expander IsExpanded="{Binding IsSupportMeVisible}" IsVisible="{Binding IsSupportMeAllowed}" HorizontalAlignment="Stretch">
                <Expander.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding SupportMe, Source={x:Static res:Loc.Instance}}"/>
                    <TextBlock Text="❤" Foreground="Red"/>
                  </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <Button Content="{Binding DonateWithPayPal, Source={x:Static res:Loc.Instance}}" Command="{Binding OpenPayPalCommand}" HorizontalAlignment="Stretch"/>
                  <Button Content="{Binding DonateWithKoFi, Source={x:Static res:Loc.Instance}}" Command="{Binding OpenKoFiCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <!-- Trial Limits & Statistics Card -->
          <TextBlock Text="{Binding LicenceSectionHeader}" FontSize="18" FontWeight="Bold"/>
          
          <!-- Locked Trial Panel (Play Store Only) -->
          <Border CornerRadius="10" Padding="16" IsVisible="{Binding IsPlayStoreBuildAndLocked}">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FF3A3A4A" Offset="0.0"/>
                <GradientStop Color="#FF20202A" Offset="1.0"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding TrialEdition, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                  <TextBlock Text="{Binding TrialUpgradeDesc, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="#FFAAAAAA" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#E5A93C" CornerRadius="4" Padding="6,3" VerticalAlignment="Top">
                  <TextBlock Text="{Binding TrialLocked, Source={x:Static res:Loc.Instance}}" FontSize="10" FontWeight="Bold" Foreground="Black"/>
                </Border>
              </Grid>
 
              <Separator Background="#33FFFFFF"/>
 
              <StackPanel Spacing="10">
                <!-- Komga limits -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding TrialKomgaServerIntegration, Source={x:Static res:Loc.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding TrialKomgaLimitsDesc, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="#FFAAAAAA"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="{Binding Downloads, Source={x:Static res:Loc.Instance}}" FontSize="9" Foreground="#FFAAAAAA" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding KomgaDownloadsDisplay}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="{Binding TrialViews, Source={x:Static res:Loc.Instance}}" FontSize="9" Foreground="#FFAAAAAA" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding KomgaViewsDisplay}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
 
                <Separator Background="#15FFFFFF"/>
 
                <!-- Local import/view limits per format -->
                <TextBlock Text="{Binding TrialLocalLimitsTitle, Source={x:Static res:Loc.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="#FFAAAAAA"/>
                
                <ItemsControl ItemsSource="{Binding LocalFormatStatuses}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" Rows="2"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FormatTrialStatus">
                      <Border Margin="4" Padding="8" Background="#15FFFFFF" CornerRadius="6">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Format}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                          <Grid ColumnDefinitions="*,*">
                            <StackPanel HorizontalAlignment="Center">
                              <TextBlock Text="{Binding Imports, Source={x:Static res:Loc.Instance}}" FontSize="8" Foreground="#FFAAAAAA" HorizontalAlignment="Center"/>
                              <TextBlock Text="{Binding ImportsDisplay}" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                              <TextBlock Text="{Binding TrialViews, Source={x:Static res:Loc.Instance}}" FontSize="8" Foreground="#FFAAAAAA" HorizontalAlignment="Center"/>
                              <TextBlock Text="{Binding ViewsDisplay}" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
 
              <Button Command="{Binding RequestUnlockCommand}" Classes="accent" HorizontalAlignment="Stretch" Height="40" Margin="0,8,0,0">
                <Button.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#FFE5A93C" Offset="0.0"/>
                    <GradientStop Color="#FFF39C12" Offset="1.0"/>
                  </LinearGradientBrush>
                </Button.Background>
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="⭐" FontSize="16" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding TrialUnlockButton, Source={x:Static res:Loc.Instance}}" FontSize="14" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </StackPanel>
          </Border>

          <!-- Unlocked Premium Panel (Play Store Only) -->
          <Border CornerRadius="10" Padding="16" IsVisible="{Binding IsPlayStoreBuildAndUnlocked}">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FF3F51B5" Offset="0.0"/>
                <GradientStop Color="#FF2196F3" Offset="1.0"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding TrialPremiumEdition, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                  <TextBlock Text="{Binding TrialAllFeaturesUnlocked, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="#FFE0E0E0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#4CAF50" CornerRadius="4" Padding="6,3" VerticalAlignment="Top">
                  <TextBlock Text="{Binding TrialUnlocked, Source={x:Static res:Loc.Instance}}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                </Border>
              </Grid>
 
              <Separator Background="#33FFFFFF"/>
 
              <TextBlock Text="{Binding TrialPersonalReadingStats, Source={x:Static res:Loc.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
 
              <!-- 2x2 Grid for statistics dashboard -->
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="8">
                <!-- Total Pages Read -->
                <Border Grid.Row="0" Grid.Column="0" Background="#22FFFFFF" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="📖" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPagesRead}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrialPagesRead, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="#FFE0E0E0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <!-- Comics Opened -->
                <Border Grid.Row="0" Grid.Column="1" Background="#22FFFFFF" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="📚" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalComicsOpened}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrialComicsOpened, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="#FFE0E0E0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <!-- Local Imports -->
                <Border Grid.Row="1" Grid.Column="0" Background="#22FFFFFF" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="📥" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalLocalImports}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrialLocalImports, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="#FFE0E0E0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <!-- Komga Downloads -->
                <Border Grid.Row="1" Grid.Column="1" Background="#22FFFFFF" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="☁" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalKomgaDownloads}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrialKomgaDownloads, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="#FFE0E0E0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Non-Store Standard Statistics Panel (Sideloaded/Desktop) -->
          <Border CornerRadius="10" Padding="16" 
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                  IsVisible="{Binding !IsPlayStoreBuild}">
            <StackPanel Spacing="16">
              <!-- 2x2 Grid for statistics dashboard -->
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="8">
                <!-- Total Pages Read -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="📖" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPagesRead}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrialPagesRead, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <!-- Comics Opened -->
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="📚" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalComicsOpened}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrialComicsOpened, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <!-- Local Imports -->
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="📥" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalLocalImports}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrialLocalImports, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <!-- Komga Downloads -->
                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="☁" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalKomgaDownloads}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrialKomgaDownloads, Source={x:Static res:Loc.Instance}}" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding UiSettings, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
          <Border Padding="16" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel Spacing="16">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Language, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          HorizontalAlignment="Stretch"
                          Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding LanguageDescription, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

              <Separator/>

              <StackPanel Spacing="8">
                <TextBlock Text="{Binding AppTheme, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableAppThemes}"
                          SelectedItem="{Binding SelectedAppThemeOption}"
                          HorizontalAlignment="Stretch"
                          Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppThemeOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding AppThemeDescription, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

              <Separator/>

              <StackPanel Spacing="8">
                <TextBlock Text="{Binding StartupBehavior, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableStartupBehaviors}"
                          SelectedItem="{Binding SelectedStartupBehaviorOption}"
                          HorizontalAlignment="Stretch"
                          Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:StartupBehaviorOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding StartupBehaviorHint, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <ToggleSwitch IsChecked="{Binding UseFullScreenWhenReading}"
                              OnContent="{Binding UseFullScreenWhenReadingEnabled, Source={x:Static res:Loc.Instance}}"
                              OffContent="{Binding UseFullScreenWhenReadingDisabled, Source={x:Static res:Loc.Instance}}"/>
                <TextBlock Text="{Binding UseFullScreenWhenReadingDescription, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding ReadingSettings, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
          <Border Padding="16" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel Spacing="16">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding DefaultReadingMode, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableReadingModes}"
                          SelectedItem="{Binding SelectedReadingModeOption}"
                          HorizontalAlignment="Stretch"
                          Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReadingModeOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap">
                  <Run Text="{Binding ReadingModeNormalDescription, Source={x:Static res:Loc.Instance}}"/>
                  <LineBreak/>
                  <Run Text="{Binding ReadingModeZoomedDescription, Source={x:Static res:Loc.Instance}}"/>
                  <LineBreak/>
                  <Run Text="{Binding ReadingModeGuidedDescription, Source={x:Static res:Loc.Instance}}"/>
                </TextBlock>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="{Binding DefaultReadingDirection, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableReadingDirectionModes}"
                          SelectedItem="{Binding SelectedReadingDirectionModeOption}"
                          HorizontalAlignment="Stretch"
                          Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReadingDirectionModeOption">
                      <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ReadingDirectionDescription, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Handedness, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableHandednessOptions}"
                          SelectedItem="{Binding SelectedHandednessOption}"
                          HorizontalAlignment="Stretch"
                          Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:HandednessOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding HandednessDescription, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

              <Separator/>

              <StackPanel Spacing="8">
                <ToggleSwitch IsChecked="{Binding CompactOverview}"
                              OnContent="{Binding CompactOverviewEnabled, Source={x:Static res:Loc.Instance}}"
                              OffContent="{Binding CompactOverviewDisabled, Source={x:Static res:Loc.Instance}}"/>
                <TextBlock Text="{Binding CompactOverviewDescription, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

            </StackPanel>
          </Border>

          <TextBlock Text="{Binding LibrarySettings, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
          <Border Padding="16" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel Spacing="16">
              <StackPanel Spacing="8">
                <ToggleSwitch IsChecked="{Binding SkipExternalDeleteConfirmation}"
                              OnContent="{Binding SkipExternalDeleteConfirmationEnabled, Source={x:Static res:Loc.Instance}}"
                              OffContent="{Binding SkipExternalDeleteConfirmationDisabled, Source={x:Static res:Loc.Instance}}"/>
                <TextBlock Text="{Binding SkipExternalDeleteConfirmationDescription, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="{Binding UnsupportedFormatHandling, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableUnsupportedFormatHandlingModes}"
                          SelectedItem="{Binding SelectedUnsupportedFormatHandlingModeOption}"
                          HorizontalAlignment="Stretch"
                          Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:UnsupportedFormatHandlingModeOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding UnsupportedFormatHandlingDescription, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding SupportsEpubFeatures}">
                <TextBlock Text="{Binding EpubConversionTheme, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableEpubConversionThemes}"
                          SelectedItem="{Binding SelectedEpubConversionThemeOption}"
                          HorizontalAlignment="Stretch"
                          Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EpubConversionThemeOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding EpubConversionThemeDescription, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding SupportsEpubFeatures}">
                <TextBlock Text="{Binding EpubOutputResolution, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableEpubOutputResolutions}"
                          SelectedItem="{Binding SelectedEpubOutputResolutionOption}"
                          HorizontalAlignment="Stretch"
                          Width="320">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EpubOutputResolutionOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding EpubOutputResolutionDescription, Source={x:Static res:Loc.Instance}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>

              <Separator/>

              <TextBlock Text="{Binding SectionLayoutDescription, Source={x:Static res:Loc.Instance}}"
                         Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Library, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="10,0,10,4">
                  <TextBlock Text="↕" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding SectionLayout, Source={x:Static res:Loc.Instance}}" Foreground="Gray" FontSize="12"/>
                  <TextBlock Grid.Column="2" Text="{Binding Shown, Source={x:Static res:Loc.Instance}}" Foreground="Gray" FontSize="12"/>
                  <TextBlock Grid.Column="3" Text="{Binding Expanded, Source={x:Static res:Loc.Instance}}" Foreground="Gray" FontSize="12"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding LibrarySections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SectionLayoutItemViewModel">
                      <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="8"
                              Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                              DragDrop.AllowDrop="True"
                              DragDrop.DragOver="OnSectionDragOver"
                              DragDrop.Drop="OnSectionDrop">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="⋮⋮" FontSize="16" Foreground="Gray" VerticalAlignment="Center" Cursor="SizeAll"
                                       PointerPressed="OnSectionDragHandlePointerPressed"/>
                            <StackPanel Orientation="Vertical" Spacing="1">
                              <Button Content="▲" FontSize="10" Padding="4,2" MinWidth="0" MinHeight="0" Background="Transparent"
                                      Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveSectionUpCommand}"
                                      CommandParameter="{Binding}"/>
                              <Button Content="▼" FontSize="10" Padding="4,2" MinWidth="0" MinHeight="0" Background="Transparent"
                                      Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveSectionDownCommand}"
                                      CommandParameter="{Binding}"/>
                            </StackPanel>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                          <CheckBox Grid.Column="2" IsChecked="{Binding IsVisible}" VerticalAlignment="Center"/>
                          <CheckBox Grid.Column="3" IsChecked="{Binding IsExpanded}" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <Expander>
            <Expander.Header>
              <TextBlock Text="{Binding KomgaSettings, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <Border Padding="16" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Margin="0,8,0,0">
              <StackPanel Spacing="16">
                <StackPanel Spacing="12">
                  <Button Content="{Binding AddServer, Source={x:Static res:Loc.Instance}}" Command="{Binding AddServerCommand}" HorizontalAlignment="Left"/>

                  <ItemsControl ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:KomgaServer">
                        <Border Padding="16" Margin="0,0,0,8" CornerRadius="8"
                                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Padding="6,2" CornerRadius="4"
                                        IsVisible="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ActiveServerId, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={Binding Id}}">
                                  <TextBlock Text="{Binding Browsing, Source={x:Static res:Loc.Instance}}" Foreground="White" FontSize="10"/>
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding BaseUrl}" Foreground="Gray" FontSize="12"/>
                              <TextBlock Text="{Binding Username}" Foreground="Gray" FontSize="12"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="{Binding SetAsBrowsingServer, Source={x:Static res:Loc.Instance}}"
                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SetBrowsingServerCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ActiveServerId, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={Binding Id}}"
                                    Background="Transparent" Padding="8,4"/>
                            <Button Grid.Column="2" Content="{Binding Edit, Source={x:Static res:Loc.Instance}}"
                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).EditServerCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" Padding="8,4"/>
                            <Button Grid.Column="3" Content="{Binding Delete, Source={x:Static res:Loc.Instance}}"
                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteServerCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" Padding="8,4"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="32"
                              IsVisible="{Binding !Servers.Count}">
                    <TextBlock Text="{Binding NoServersConfigured, Source={x:Static res:Loc.Instance}}" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AddServerHint, Source={x:Static res:Loc.Instance}}"
                               Foreground="Gray" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
                  </StackPanel>
                </StackPanel>

                <Separator IsVisible="{Binding Servers.Count}"/>

                <StackPanel IsVisible="{Binding Servers.Count}" Spacing="16">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding KomgaParallelDownloads, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                  <ComboBox ItemsSource="{Binding AvailableKomgaParallelDownloadOptions}"
                            SelectedItem="{Binding SelectedKomgaParallelDownloads}"
                            HorizontalAlignment="Stretch"
                            Width="320"/>
                  <TextBlock Text="{Binding KomgaParallelDownloadsDescription, Source={x:Static res:Loc.Instance}}"
                             Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding KomgaSeriesPageSize, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                  <ComboBox ItemsSource="{Binding AvailableKomgaSeriesPageSizeOptions}"
                            SelectedItem="{Binding SelectedKomgaSeriesPageSize}"
                            HorizontalAlignment="Stretch"
                            Width="320"/>
                  <TextBlock Text="{Binding KomgaSeriesPageSizeDescription, Source={x:Static res:Loc.Instance}}"
                             Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding KomgaSearchLimit, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                  <ComboBox ItemsSource="{Binding AvailableKomgaSearchLimitOptions}"
                            SelectedItem="{Binding SelectedKomgaSearchLimit}"
                            HorizontalAlignment="Stretch"
                            Width="320"/>
                  <TextBlock Text="{Binding KomgaSearchLimitDescription, Source={x:Static res:Loc.Instance}}"
                             Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding KomgaSmartListSize, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                  <ComboBox ItemsSource="{Binding AvailableKomgaSmartListSizeOptions}"
                            SelectedItem="{Binding SelectedKomgaSmartListSize}"
                            HorizontalAlignment="Stretch"
                            Width="320"/>
                  <TextBlock Text="{Binding KomgaSmartListSizeDescription, Source={x:Static res:Loc.Instance}}"
                             Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="8">
                  <ToggleSwitch IsChecked="{Binding AllowMeteredKomgaDownloads}"
                                OnContent="{Binding AllowMeteredKomgaDownloadsEnabled, Source={x:Static res:Loc.Instance}}"
                                OffContent="{Binding AllowMeteredKomgaDownloadsDisabled, Source={x:Static res:Loc.Instance}}"/>
                  <TextBlock Text="{Binding AllowMeteredKomgaDownloadsDescription, Source={x:Static res:Loc.Instance}}"
                             Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="8">
                  <ToggleSwitch IsChecked="{Binding SyncReadProgress}"
                                OnContent="{Binding SyncReadProgressEnabled, Source={x:Static res:Loc.Instance}}"
                                OffContent="{Binding SyncReadProgressDisabled, Source={x:Static res:Loc.Instance}}"/>
                  <TextBlock Text="{Binding SyncReadProgressDescription, Source={x:Static res:Loc.Instance}}"
                             Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding KomgaHome, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="10,0,10,4">
                    <TextBlock Text="↕" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding SectionLayout, Source={x:Static res:Loc.Instance}}" Foreground="Gray" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="{Binding Shown, Source={x:Static res:Loc.Instance}}" Foreground="Gray" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="{Binding Expanded, Source={x:Static res:Loc.Instance}}" Foreground="Gray" FontSize="12"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding KomgaSections}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SectionLayoutItemViewModel">
                        <Border Padding="10,8" Margin="0,0,0,4" CornerRadius="8"
                                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnSectionDragOver"
                                DragDrop.Drop="OnSectionDrop">
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                              <TextBlock Text="⋮⋮" FontSize="16" Foreground="Gray" VerticalAlignment="Center" Cursor="SizeAll"
                                         PointerPressed="OnSectionDragHandlePointerPressed"/>
                              <StackPanel Orientation="Vertical" Spacing="1">
                                <Button Content="▲" FontSize="10" Padding="4,2" MinWidth="0" MinHeight="0" Background="Transparent"
                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveSectionUpCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="▼" FontSize="10" Padding="4,2" MinWidth="0" MinHeight="0" Background="Transparent"
                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveSectionDownCommand}"
                                        CommandParameter="{Binding}"/>
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <CheckBox Grid.Column="2" IsChecked="{Binding IsVisible}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="3" IsChecked="{Binding IsExpanded}" VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

              </StackPanel>
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Edit Server Form -->
    <ScrollViewer IsVisible="{Binding IsEditing}" Padding="16">
      <StackPanel Spacing="16" MaxWidth="400" Margin="0,0,0,76">
        <TextBlock Text="{Binding ServerConfiguration, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
        
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Name, Source={x:Static res:Loc.Instance}}"/>
          <TextBox Text="{Binding ServerName}" PlaceholderText="My Komga Server"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding ServerUrl, Source={x:Static res:Loc.Instance}}"/>
          <TextBox Text="{Binding ServerUrl}" PlaceholderText="https://komga.example.com"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <ToggleSwitch IsChecked="{Binding BypassSslValidation}"
                        OnContent="{Binding BypassSslValidation, Source={x:Static res:Loc.Instance}}"
                        OffContent="{Binding BypassSslValidation, Source={x:Static res:Loc.Instance}}"/>
          <TextBlock Text="{Binding BypassSslValidationHint, Source={x:Static res:Loc.Instance}}"
                     Foreground="Gray" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Text="{Binding AuthenticationTitle, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4"/>

          <!-- API Key Section (Preferred) -->
          <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="12" CornerRadius="4">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding ApiKeyTitle, Source={x:Static res:Loc.Instance}}" FontSize="12" FontWeight="Bold"/>
              <TextBox Text="{Binding ApiKey}" PlaceholderText="{Binding ApiKeyPlaceholder, Source={x:Static res:Loc.Instance}}"/>
              <TextBlock Text="{Binding ApiKeyHint, Source={x:Static res:Loc.Instance}}" FontSize="10" Foreground="Gray"/>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding Or, Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Center" FontSize="10" Foreground="Gray" FontWeight="Bold"/>

          <!-- Username/Password Section -->
          <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="12" CornerRadius="4">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding UsernamePasswordTitle, Source={x:Static res:Loc.Instance}}" FontSize="12" FontWeight="Bold"/>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Username, Source={x:Static res:Loc.Instance}}" FontSize="11"/>
                <TextBox Text="{Binding Username}" PlaceholderText="{Binding UsernamePlaceholder, Source={x:Static res:Loc.Instance}}"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Password, Source={x:Static res:Loc.Instance}}" FontSize="11"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding Password}" PlaceholderText="{Binding PasswordPlaceholder, Source={x:Static res:Loc.Instance}}" 
                           PasswordChar="•" RevealPassword="{Binding IsPasswordVisible}"/>
                  <Button Grid.Column="1" Command="{Binding TogglePasswordVisibilityCommand}" 
                          Margin="4,0,0,0" ToolTip.Tip="{Binding ShowHidePassword, Source={x:Static res:Loc.Instance}}" Padding="8,6">
                    <Panel>
                      <TextBlock Text="{Binding Show, Source={x:Static res:Loc.Instance}}" FontSize="11" IsVisible="{Binding !IsPasswordVisible}"/>
                      <TextBlock Text="{Binding Hide, Source={x:Static res:Loc.Instance}}" FontSize="11" IsVisible="{Binding IsPasswordVisible}"/>
                    </Panel>
                  </Button>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="{Binding CustomHttpHeaders, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding CustomHeadersHint, Source={x:Static res:Loc.Instance}}" FontSize="10" Foreground="Gray"/>

          <ItemsControl ItemsSource="{Binding CustomHeaders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:KomgaHeader">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                  <TextBox Text="{Binding Name}" PlaceholderText="{Binding HeaderName, Source={x:Static res:Loc.Instance}}"/>
                  <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="{Binding Value, Source={x:Static res:Loc.Instance}}"/>
                  <Button Grid.Column="2" Content="🗑️" 
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveHeaderCommand}"
                          CommandParameter="{Binding}" Background="Transparent"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="{Binding AddHeader, Source={x:Static res:Loc.Instance}}" Command="{Binding AddHeaderCommand}" HorizontalAlignment="Left" FontSize="12"/>
        </StackPanel>


        <!-- Connection Status -->
        <TextBlock Text="{Binding ConnectionStatus}" HorizontalAlignment="Center" TextWrapping="Wrap"
                   IsVisible="{Binding ConnectionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Content="{Binding TestConnection, Source={x:Static res:Loc.Instance}}" Command="{Binding TestConnectionCommand}"
                  IsEnabled="{Binding !IsTestingConnection}"/>
          
          <Button Content="{Binding Cancel, Source={x:Static res:Loc.Instance}}" Command="{Binding CancelEditCommand}"/>
          
          <Button Content="{Binding Save, Source={x:Static res:Loc.Instance}}" Command="{Binding SaveServerCommand}" Classes="accent"/>
        </StackPanel>

        <!-- Testing Indicator -->
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTestingConnection}"
                     HorizontalAlignment="Center" Width="100"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Server Delete Confirmation Overlay -->
    <Panel Background="#80000000" IsVisible="{Binding ShowServerDeleteConfirmation}">
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
              CornerRadius="8" Padding="24" MaxWidth="400"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding ConfirmDeleteServer, Source={x:Static res:Loc.Instance}}" 
                     FontSize="18" FontWeight="Bold"/>
          
          <TextBlock TextWrapping="Wrap">
            <Run Text="There are "/>
            <Run Text="{Binding LinkedComicsCount}" FontWeight="Bold"/>
            <Run Text=" comics linked to this server. If you delete it, their reading progress will no longer be synchronized. Do you want to proceed?"/>
          </TextBlock>

          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="{Binding Cancel, Source={x:Static res:Loc.Instance}}" 
                    Command="{Binding CancelDeleteServerCommand}"/>
            <Button Content="{Binding Delete, Source={x:Static res:Loc.Instance}}" 
                    Command="{Binding ConfirmDeleteServerCommand}" Classes="accent"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
