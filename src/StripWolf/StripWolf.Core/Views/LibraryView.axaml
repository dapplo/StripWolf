<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StripWolf.Core.ViewModels"
             xmlns:views="using:StripWolf.Core.Views"
             xmlns:controls="using:StripWolf.Core.Controls"
             xmlns:repeater="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:models="using:StripWolf.Core.Models"
             xmlns:converters="using:StripWolf.Core.Converters"
             xmlns:res="using:StripWolf.Core.Resources"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="StripWolf.Core.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             x:Name="Root">
  
  <UserControl.Styles>
    <Style Selector="Button.icon-btn">
      <Setter Property="Padding" Value="4"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.icon-btn:pointerover">
      <Setter Property="Background" Value="#15000000"/>
    </Style>
    
    <!-- Comic card hover transition styles -->
    <Style Selector="Border.comic-card">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="SineEaseOut"/>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="SineEaseOut"/>
        </Transitions>
      </Setter>
      <Setter Property="RenderTransform" Value="scale(1.0)"/>
      <Setter Property="BoxShadow" Value="0 2 6 0 #15000000"/>
    </Style>
    <Style Selector="Border.comic-card:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.04)"/>
      <Setter Property="BoxShadow" Value="0 8 20 0 #30000000"/>
      <Setter Property="ZIndex" Value="10"/>
    </Style>
  </UserControl.Styles>
  
  <UserControl.Resources>
    <DataTemplate x:Key="ComicTemplate" x:DataType="models:Comic">
      <Border Classes="comic-card" CornerRadius="8" ClipToBounds="True" Width="150"
               Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <Grid RowDefinitions="200,Auto,Auto,Auto">
          <!-- Cover with click handler -->
          <Button Grid.Row="0" Padding="0" Background="Transparent" Height="200"
                  IsEnabled="{Binding CanOpen}"
                  Command="{Binding OpenComicCommand, ElementName=Root}"
                  CommandParameter="{Binding}">
            <Border Background="Black" CornerRadius="8,8,0,0">
              <Panel>
                <controls:AsyncImage SourceUrl="{Binding CoverPath}" Stretch="Uniform"
                                     RenderOptions.BitmapInterpolationMode="LowQuality"
                                     IsHitTestVisible="False"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <!-- Deleting overlay -->
                <Border Background="#80000000" IsVisible="{Binding IsDeleting}" IsHitTestVisible="False">
                  <TextBlock Text="{Binding Deleting, Source={x:Static res:Loc.Instance}}" Foreground="White" FontWeight="Bold" 
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Panel>
            </Border>
          </Button>
          <Border Grid.Row="1" Height="36" Margin="8,4">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding SeriesName}" FontSize="10" Foreground="Gray" 
                         IsVisible="{Binding SeriesName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                         TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap"
                         ToolTip.Tip="{Binding Title}"/>
            </StackPanel>
          </Border>
          
          <StackPanel Grid.Row="2" Height="28" Margin="8,0,8,4" Spacing="3">
             <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReadingProgress}"
                          Height="4"
                          IsVisible="{Binding HasReadingProgress}"/>

             <TextBlock Text="{Binding ReadingProgressDisplay}"
                        FontSize="10" Foreground="Gray"
                        TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <!-- Actions Grid (2x2) -->
          <Panel Grid.Row="3" Margin="4,4,4,6" Height="80">
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" IsVisible="{Binding !IsDeleting}">
              <!-- Info -->
              <Button Grid.Column="0" Grid.Row="0" Classes="icon-btn"
                      Command="{Binding ShowComicInfoCommand, ElementName=Root}"
                      CommandParameter="{Binding}" ToolTip.Tip="{Binding ComicInformation, Source={x:Static res:Loc.Instance}}">
                <TextBlock Text="ⓘ" FontSize="18" VerticalAlignment="Center"/>
              </Button>
              <!-- Favorite -->
              <Button Grid.Column="1" Grid.Row="0" Classes="icon-btn"
                      Command="{Binding ToggleFavoriteCommand, ElementName=Root}"
                      CommandParameter="{Binding}" ToolTip.Tip="{Binding Favorite, Source={x:Static res:Loc.Instance}}">
                <Panel>
                  <TextBlock Text="☆" IsVisible="{Binding !IsFavorite}" FontSize="18" VerticalAlignment="Center"/>
                  <TextBlock Text="★" IsVisible="{Binding IsFavorite}" Foreground="Gold" FontSize="18" VerticalAlignment="Center"/>
                </Panel>
              </Button>
              <!-- Mark Read -->
              <Button Grid.Column="0" Grid.Row="1" Classes="icon-btn" 
                      Command="{Binding ToggleReadStatusCommand, ElementName=Root}"
                      CommandParameter="{Binding}" ToolTip.Tip="{Binding MarkRead, Source={x:Static res:Loc.Instance}}">
                 <Panel>
                    <TextBlock Text="✓" IsVisible="{Binding !IsCompleted}" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="☑" IsVisible="{Binding IsCompleted}" Foreground="{DynamicResource SystemAccentColor}" FontSize="18" VerticalAlignment="Center"/>
                 </Panel>
              </Button>
              <!-- Delete -->
              <Button Grid.Column="1" Grid.Row="1" Classes="icon-btn"
                      Command="{Binding DeleteComicCommand, ElementName=Root}"
                      CommandParameter="{Binding}" ToolTip.Tip="{Binding DeleteComic, Source={x:Static res:Loc.Instance}}">
                <TextBlock Text="✕" FontSize="18" VerticalAlignment="Center"/>
              </Button>
            </Grid>
            
            <!-- Undo Button with Timer -->
            <Button FontSize="10" Padding="8,4" Background="#FFF3E0" Foreground="Black"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    IsVisible="{Binding IsDeleting}"
                    Command="{Binding UndoComicDeleteCommand, ElementName=Root}"
                    CommandParameter="{Binding}">
              <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Undo, Source={x:Static res:Loc.Instance}, StringFormat='{}↩ {0}'}" FontWeight="Bold"/>
                <TextBlock Text="{Binding DeletionSecondsRemaining, StringFormat='{}{0}s'}" FontSize="9"/>
              </StackPanel>
            </Button>
          </Panel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="SeriesGroupTemplate" x:DataType="models:ComicSeriesGroup">
      <Expander IsExpanded="{Binding IsExpanded}" ContentTransition="{x:Null}" Margin="0,0,0,16" Padding="0" HorizontalAlignment="Stretch">
        <Expander.Header>
          <Border CornerRadius="8" Padding="12" HorizontalAlignment="Stretch"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
              <!-- 3D stacked cover visual for series -->
              <Grid Width="88" Height="104" Margin="0,0,8,0">
                <!-- Third cover (back, rotated left) -->
                <Border Width="72" Height="96" CornerRadius="6" ClipToBounds="True" Background="Black"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding HasThirdCover}" Opacity="0.7">
                  <Border.RenderTransform>
                    <TransformOperations>translate(-8px, -4px) rotate(-6deg)</TransformOperations>
                  </Border.RenderTransform>
                  <controls:AsyncImage SourceUrl="{Binding CoverPath3}" Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="LowQuality"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                </Border>

                <!-- Second cover (middle, rotated right) -->
                <Border Width="72" Height="96" CornerRadius="6" ClipToBounds="True" Background="Black"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding HasSecondCover}" Opacity="0.85">
                  <Border.RenderTransform>
                    <TransformOperations>translate(8px, -2px) rotate(6deg)</TransformOperations>
                  </Border.RenderTransform>
                  <controls:AsyncImage SourceUrl="{Binding CoverPath2}" Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="LowQuality"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                </Border>

                <!-- First cover (front, straight) -->
                <Border Width="72" Height="96" CornerRadius="6" ClipToBounds="True" Background="Black"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BoxShadow="0 4 8 0 #35000000">
                  <controls:AsyncImage SourceUrl="{Binding CoverPath1}" Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="LowQuality"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                </Border>
              </Grid>

              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding RepresentativeComic.Title}" FontSize="12" Foreground="Gray"
                           TextTrimming="CharacterEllipsis" MaxLines="1"
                           IsVisible="{Binding !HasDeletingComics}"/>
                <TextBlock Text="{Binding DeleteStatusText}" FontSize="12" Foreground="#D32F2F"
                           TextTrimming="CharacterEllipsis" MaxLines="1"
                           IsVisible="{Binding HasDeletingComics}"/>
                <TextBlock Text="{Binding ReadCountDisplay}" FontSize="12" Foreground="Gray"/>
              </StackPanel>

              <Border Grid.Column="2" Background="{DynamicResource SystemAccentColor}" CornerRadius="999" Padding="10,4"
                      VerticalAlignment="Top">
                <TextBlock Text="{Binding ComicCountDisplay}" Foreground="White" FontSize="12"/>
              </Border>

              <Button Grid.Column="3"
                      Command="{Binding DeleteSeriesCommand, ElementName=Root}"
                      CommandParameter="{Binding}"
                      Background="#D32F2F"
                      Foreground="White"
                      Padding="10,4"
                      VerticalAlignment="Top"
                      ToolTip.Tip="{Binding DeleteComic, Source={x:Static res:Loc.Instance}}">
                <TextBlock Text="{Binding DeleteActionLabel}" FontSize="12"/>
              </Button>
            </Grid>
          </Border>
        </Expander.Header>

        <repeater:ItemsRepeater ItemsSource="{Binding Comics}" ItemTemplate="{StaticResource ComicTemplate}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
          <repeater:ItemsRepeater.Layout>
            <layout:UniformGridLayout Orientation="Horizontal"
                                      MinItemWidth="162"
                                      MinItemHeight="356"
                                      MinColumnSpacing="12"
                                      MinRowSpacing="12"/>
          </repeater:ItemsRepeater.Layout>
        </repeater:ItemsRepeater>
      </Expander>
    </DataTemplate>
  </UserControl.Resources>
  
  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="{Binding Library, Source={x:Static res:Loc.Instance}}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="{Binding OpenFolder, Source={x:Static res:Loc.Instance}, StringFormat='{}📁 {0}'}" Command="{Binding OpenComicsDirectoryCommand}" 
                Padding="16,8" Margin="0,0,8,0" IsVisible="{Binding IsDesktop}"/>
        <Button Grid.Column="2" Content="{Binding ImportFolder, Source={x:Static res:Loc.Instance}}" Click="OnImportFolderClicked" Padding="16,8" Margin="0,0,8,0" IsVisible="{Binding IsDesktop}"/>
        <Button Grid.Column="3" Content="{Binding ImportComic, Source={x:Static res:Loc.Instance}}" Click="OnImportClicked" Padding="16,8"/>
      </Grid>
    </Border>
    
    <!-- Content -->
    <ScrollViewer Grid.Row="1" Padding="16"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  IsScrollInertiaEnabled="True"
                  IsScrollChainingEnabled="True">
      <StackPanel Spacing="24" Margin="0,0,0,76">
        
        <!-- Search Box -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="{Binding SearchPlaceholder, Source={x:Static res:Loc.Instance}}"
                   VerticalContentAlignment="Center"/>
          <Button Grid.Column="1" Content="✕" Command="{Binding ClearSearchCommand}" 
                  Padding="8,6" Margin="4,0,0,0"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>

        <!-- Search Results Section -->
        <StackPanel Spacing="8" IsVisible="{Binding IsSearching}">
          <TextBlock Text="{Binding SearchResults, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="{Binding NoComicsFound, Source={x:Static res:Loc.Instance}}" Foreground="Gray" IsVisible="{Binding !SearchResults.Count}" Margin="0,8"/>
          
          <repeater:ItemsRepeater ItemsSource="{Binding SearchResults}" IsVisible="{Binding SearchResults.Count}"
                                  ItemTemplate="{StaticResource ComicTemplate}">
            <repeater:ItemsRepeater.Layout>
              <layout:UniformGridLayout Orientation="Horizontal"
                                        MinItemWidth="162"
                                        MinItemHeight="356"
                                        MinColumnSpacing="12"
                                        MinRowSpacing="12"/>
            </repeater:ItemsRepeater.Layout>
          </repeater:ItemsRepeater>
        </StackPanel>
        
        <!-- Error Message -->
        <Border Background="#FFEBEE" CornerRadius="8" Padding="12"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"/>
        </Border>

        <!-- Pending Imports Section -->
        <StackPanel Spacing="8" IsVisible="{Binding PendingImports.Count}">
          <TextBlock Text="{Binding Importing, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
          <ItemsControl ItemsSource="{Binding PendingImports}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PendingImport">
                <Border CornerRadius="8" Padding="12"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Border Grid.Column="0" Grid.RowSpan="3" Width="48" Height="48" 
                            CornerRadius="8" Background="Black" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                      <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Status}" FontSize="12" Foreground="Gray"/>
                    <ProgressBar Grid.Column="1" Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" Margin="0,4,0,0" IsVisible="{Binding IsProcessing}"/>
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding ErrorMessage}" FontSize="10" Foreground="#C62828" Margin="0,4,0,0" IsVisible="{Binding IsFailed}" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Grid.RowSpan="3" Content="✕" FontSize="12" Padding="8,4" VerticalAlignment="Center" IsVisible="{Binding IsFailed}" Command="{Binding RemovePendingImportCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                    <TextBlock Grid.Column="2" Grid.RowSpan="3" Text="✓" FontSize="20" Foreground="Green" VerticalAlignment="Center" IsVisible="{Binding IsCompleted}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Main Content (hidden when searching) -->
        <Grid IsVisible="{Binding !IsSearching}" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="24">

          <!-- Continue Reading Section -->
          <Expander Grid.Row="{Binding ContinueReadingSection.Order}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowContinueReadingSection}"
                    IsExpanded="{Binding ContinueReadingSection.IsExpanded}">
            <Expander.Header>
              <TextBlock Text="{Binding SectionContinueReading, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <repeater:ItemsRepeater ItemsSource="{Binding InProgressComics}" ItemTemplate="{StaticResource ComicTemplate}" Margin="0,8,0,0">
              <repeater:ItemsRepeater.Layout>
                <layout:UniformGridLayout Orientation="Horizontal"
                                          MinItemWidth="162"
                                          MinItemHeight="356"
                                          MinColumnSpacing="12"
                                          MinRowSpacing="12"/>
              </repeater:ItemsRepeater.Layout>
            </repeater:ItemsRepeater>
          </Expander>

          <!-- New Comics Section -->
          <Expander Grid.Row="{Binding NewComicsSection.Order}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowNewComicsSection}"
                    IsExpanded="{Binding NewComicsSection.IsExpanded}">
            <Expander.Header>
              <TextBlock Text="{Binding SectionNewComics, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <StackPanel Spacing="8" Margin="0,8,0,0" HorizontalAlignment="Stretch">
              <StackPanel Spacing="16" HorizontalAlignment="Center" Margin="32" IsVisible="{Binding !NewComics.Count}">
                <TextBlock Text="▤" FontSize="56" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding NoNewComics, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding NoNewComicsHint, Source={x:Static res:Loc.Instance}}" Foreground="Gray" HorizontalAlignment="Center" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <Button Content="{Binding ImportComic, Source={x:Static res:Loc.Instance}}" Click="OnImportClicked" HorizontalAlignment="Center"/>
                  <Button Content="{Binding ImportFolder, Source={x:Static res:Loc.Instance}}" Click="OnImportFolderClicked" HorizontalAlignment="Center" IsVisible="{Binding IsDesktop}"/>
                </StackPanel>
              </StackPanel>

              <repeater:ItemsRepeater ItemsSource="{Binding NewComics}" IsVisible="{Binding NewComics.Count}"
                                      ItemTemplate="{StaticResource ComicTemplate}">
                <repeater:ItemsRepeater.Layout>
                  <layout:UniformGridLayout Orientation="Horizontal"
                                            MinItemWidth="162"
                                            MinItemHeight="356"
                                            MinColumnSpacing="12"
                                            MinRowSpacing="12"/>
                </repeater:ItemsRepeater.Layout>
              </repeater:ItemsRepeater>
            </StackPanel>
          </Expander>

          <!-- Favorites Section -->
          <Expander Grid.Row="{Binding FavoritesSection.Order}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowFavoritesSection}"
                    IsExpanded="{Binding FavoritesSection.IsExpanded}">
            <Expander.Header>
              <TextBlock Text="{Binding SectionFavorites, Source={x:Static res:Loc.Instance}, StringFormat='{}⭐ {0}'}" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <repeater:ItemsRepeater ItemsSource="{Binding FavoriteComics}" ItemTemplate="{StaticResource ComicTemplate}" Margin="0,8,0,0">
              <repeater:ItemsRepeater.Layout>
                <layout:UniformGridLayout Orientation="Horizontal"
                                          MinItemWidth="162"
                                          MinItemHeight="356"
                                          MinColumnSpacing="12"
                                          MinRowSpacing="12"/>
              </repeater:ItemsRepeater.Layout>
            </repeater:ItemsRepeater>
          </Expander>

          <!-- Series Section -->
          <Expander Grid.Row="{Binding SeriesSection.Order}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowSeriesSection}"
                    IsExpanded="{Binding SeriesSection.IsExpanded}">
            <Expander.Header>
              <TextBlock Text="{Binding SectionSeries, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <StackPanel Spacing="8" Margin="0,8,0,0" HorizontalAlignment="Stretch">
              <TextBlock Text="{Binding SeriesDescription, Source={x:Static res:Loc.Instance}}" Foreground="Gray"/>
              <ItemsControl ItemsSource="{Binding SeriesGroups}" ItemTemplate="{StaticResource SeriesGroupTemplate}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="16"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Expander>

          <!-- Read Section -->
          <Expander Grid.Row="{Binding ReadSection.Order}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowReadSection}"
                    IsExpanded="{Binding ReadSection.IsExpanded}">
            <Expander.Header>
              <TextBlock Text="{Binding SectionRead, Source={x:Static res:Loc.Instance}}" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <repeater:ItemsRepeater ItemsSource="{Binding CompletedComics}" ItemTemplate="{StaticResource ComicTemplate}" Margin="0,8,0,0">
              <repeater:ItemsRepeater.Layout>
                <layout:UniformGridLayout Orientation="Horizontal"
                                          MinItemWidth="162"
                                          MinItemHeight="356"
                                          MinColumnSpacing="12"
                                          MinRowSpacing="12"/>
              </repeater:ItemsRepeater.Layout>
            </repeater:ItemsRepeater>
          </Expander>

        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- Delete Confirmation Overlay -->
    <Border Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding ShowDeleteConfirmation}">
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
              CornerRadius="8" Padding="24" Width="400"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 4 20 0 #40000000">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding ConfirmExternalDelete, Source={x:Static res:Loc.Instance}}" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="{Binding ConfirmExternalDeleteMessage, Source={x:Static res:Loc.Instance}}" TextWrapping="Wrap"/>
          <Border Background="#F5F5F5" Padding="12" CornerRadius="4">
            <TextBlock Text="{Binding DeleteConfirmationPath}" FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
          </Border>
          <StackPanel Orientation="Vertical" Spacing="8">
            <Button Content="{Binding RemoveFromLibraryKeepFile, Source={x:Static res:Loc.Instance}}" Command="{Binding RemoveFromLibraryCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Grid ColumnDefinitions="*,*">
              <Button Grid.Column="0" Content="{Binding Cancel, Source={x:Static res:Loc.Instance}}" Command="{Binding CancelDeleteCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" HorizontalContentAlignment="Center"/>
              <Button Grid.Column="1" Content="{Binding DeletePermanently, Source={x:Static res:Loc.Instance}}" Command="{Binding ConfirmDeleteCommand}" Background="#D32F2F" Foreground="White" HorizontalAlignment="Stretch" Margin="4,0,0,0" HorizontalContentAlignment="Center"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Comic Info Overlay -->
    <Panel Grid.RowSpan="2" IsVisible="{Binding SelectedInfoComic, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}">
      <!-- Click background to close -->
      <Border Background="#80000000"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              PointerPressed="OnComicInfoBackdropPressed"/>
      
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
              CornerRadius="8" Padding="0" MaxWidth="500" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 4 20 0 #40000000">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource SystemAccentColor}" Padding="16" CornerRadius="8,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding ComicInformation, Source={x:Static res:Loc.Instance}}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="✕" Command="{Binding CloseComicInfoCommand, ElementName=Root}" Background="Transparent" Foreground="White" FontSize="18" Padding="8,4"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" MaxHeight="600">
            <Border Padding="24">
              <!-- Content area inherits LibraryViewModel DataContext -->
              <StackPanel Spacing="16">
                
                <!-- View Mode Metadata -->
                <StackPanel IsVisible="{Binding !IsEditingMetadata, ElementName=Root, FallbackValue=True}">
                  <Grid x:DataType="models:Comic" DataContext="{Binding SelectedInfoComic, ElementName=Root}"
                        ColumnDefinitions="150,*">
                     <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Background="Black" Height="200">
                       <controls:AsyncImage SourceUrl="{Binding CoverPath}" Stretch="Uniform"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                     </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="8">
                      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                      <StackPanel IsVisible="{Binding SeriesName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Series, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray"/>
                        <TextBlock Text="{Binding SeriesName}" FontSize="16"/>
                      </StackPanel>
                      <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0">
                           <TextBlock Text="{Binding Number, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray"/>
                           <TextBlock Text="{Binding Number}" FontSize="16"/>
                        </StackPanel>
                         <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Pages, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding LibraryPageStatusDisplay}" FontSize="16"/>
                         </StackPanel>
                       </Grid>
                       <StackPanel>
                         <TextBlock Text="{Binding Format, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray"/>
                         <TextBlock Text="{Binding FormatDisplay}" FontSize="16"/>
                       </StackPanel>
                       <Button Content="{Binding ViewSeriesOnKomga, Source={x:Static res:Loc.Instance}, StringFormat='{}🌐 {0}'}" Click="OnViewSeriesOnKomgaClicked" HorizontalAlignment="Stretch" Padding="12,8" Margin="0,8,0,0">
                        <Button.IsVisible>
                           <Binding Path="KomgaSeriesId" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                        </Button.IsVisible>
                      </Button>
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <!-- Edit Mode Metadata -->
                <StackPanel IsVisible="{Binding IsEditingMetadata, ElementName=Root, FallbackValue=False}">
                  <StackPanel x:DataType="models:ComicInfo" DataContext="{Binding EditingComicInfo, ElementName=Root}"
                              Spacing="12">
                     <StackPanel>
                       <TextBlock Text="{Binding Title, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                       <TextBox Text="{Binding Title}" PlaceholderText="{Binding Title, Source={x:Static res:Loc.Instance}}"/>
                     </StackPanel>
                     <StackPanel>
                       <TextBlock Text="{Binding Series, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                       <TextBox Text="{Binding Series}" PlaceholderText="{Binding Series, Source={x:Static res:Loc.Instance}}"/>
                     </StackPanel>

                     <StackPanel>
                       <TextBlock Text="{Binding Number, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                       <TextBox Text="{Binding Number}" PlaceholderText="{Binding Number, Source={x:Static res:Loc.Instance}}"/>
                     </StackPanel>
                     <StackPanel>
                       <TextBlock Text="{Binding Summary, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                       <TextBox Text="{Binding Summary}" PlaceholderText="{Binding SummaryPlaceholder, Source={x:Static res:Loc.Instance}}" TextWrapping="Wrap" AcceptsReturn="True" Height="100"/>
                     </StackPanel>
                     <StackPanel>
                       <TextBlock Text="{Binding Writer, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                       <TextBox Text="{Binding Writer}" PlaceholderText="{Binding Writer, Source={x:Static res:Loc.Instance}}"/>
                     </StackPanel>
                  </StackPanel>
                </StackPanel>

                <Separator Background="Gray" Opacity="0.3"/>
                
                <!-- Summary (View Mode) -->
                <StackPanel IsVisible="{Binding !IsEditingMetadata, ElementName=Root, FallbackValue=True}">
                  <StackPanel DataContext="{Binding SelectedInfoComic, ElementName=Root}" x:DataType="models:Comic"
                              IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Summary, Source={x:Static res:Loc.Instance}}" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="14" Opacity="0.9"/>
                  </StackPanel>
                </StackPanel>

                <!-- Action Buttons (View Mode) -->
                <StackPanel Spacing="8" Margin="0,8,0,0" 
                            DataContext="{Binding SelectedInfoComic, ElementName=Root}"
                            x:DataType="models:Comic"
                            IsVisible="{Binding !IsEditingMetadata, ElementName=Root, FallbackValue=True}">
                  <Button Content="{Binding ReadNow, Source={x:Static res:Loc.Instance}, StringFormat='{}📖 {0}'}" Command="{Binding OpenComicCommand, ElementName=Root}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="16,12" HorizontalContentAlignment="Center" IsEnabled="{Binding CanOpen, FallbackValue=False}"/>
                  <Button Content="{Binding ConvertNow, Source={x:Static res:Loc.Instance}, StringFormat='{}⚙ {0}'}" Command="{Binding ConvertComicNowCommand, ElementName=Root}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="12,8" HorizontalContentAlignment="Center" IsVisible="{Binding CanConvertNow, FallbackValue=False}"/>
                  <TextBlock Text="{Binding Converting, Source={x:Static res:Loc.Instance}}" Foreground="Gray" HorizontalAlignment="Center" IsVisible="{Binding IsConverting, FallbackValue=False}"/>
                  <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ToggleFavoriteCommand, ElementName=Root}" CommandParameter="{Binding}">
                       <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="⭐" IsVisible="{Binding IsFavorite, FallbackValue=False}"/>
                          <TextBlock Text="☆" IsVisible="{Binding !IsFavorite, FallbackValue=True}"/>
                          <TextBlock Text="{Binding Favorite, Source={x:Static res:Loc.Instance}}" />
                       </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Margin="4,0,0,0" Content="{Binding MarkRead, Source={x:Static res:Loc.Instance}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ToggleReadStatusCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Content="{Binding EditMetadata, Source={x:Static res:Loc.Instance}, StringFormat='{}✏️ {0}'}" Margin="0,0,4,0" Command="{Binding EditMetadataCommand, ElementName=Root}" HorizontalAlignment="Stretch" Padding="12,8" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="{Binding DeleteComic, Source={x:Static res:Loc.Instance}, StringFormat='{}🗑️ {0}'}" Margin="4,0,0,0" Background="#D32F2F" Foreground="White" Command="{Binding DeleteComicCommand, ElementName=Root}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="12,8" HorizontalContentAlignment="Center"/>
                  </Grid>
                </StackPanel>

                <!-- Action Buttons (Edit Mode) -->
                <StackPanel Spacing="8" Margin="0,8,0,0" 
                            IsVisible="{Binding IsEditingMetadata, ElementName=Root, FallbackValue=False}">
                   <Button Content="{Binding SaveChanges, Source={x:Static res:Loc.Instance}, StringFormat='{}💾 {0}'}" Background="{DynamicResource SystemAccentColor}" Foreground="White"
                           Command="{Binding SaveMetadataCommand, ElementName=Root}"
                           HorizontalAlignment="Stretch" Padding="16,12" HorizontalContentAlignment="Center"/>
                   <Button Content="{Binding Cancel, Source={x:Static res:Loc.Instance}}" Command="{Binding CancelMetadataEditCommand, ElementName=Root}"
                           HorizontalAlignment="Stretch" Padding="12,8" HorizontalContentAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </Border>
    </Panel>
  </Grid>
</UserControl>
