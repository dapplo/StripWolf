<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StripWolf.Core.ViewModels"
             xmlns:views="using:StripWolf.Core.Views"
             xmlns:res="using:StripWolf.Core.Resources"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="StripWolf.Core.Views.MainView"
             x:DataType="vm:MainViewModel">
  
  <Grid RowDefinitions="*,Auto">
    <!-- Content Area -->
    <TransitioningContentControl Grid.Row="0" Content="{Binding CurrentView}">
      <TransitioningContentControl.PageTransition>
        <CrossFade Duration="0:0:0.25"/>
      </TransitioningContentControl.PageTransition>
      <TransitioningContentControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
          <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KomgaViewModel}">
          <views:KomgaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
          <views:ActivityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
          <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReaderViewModel}">
          <views:ReaderView />
        </DataTemplate>
      </TransitioningContentControl.DataTemplates>
    </TransitioningContentControl>

    <!-- Tab Bar - Hidden when in reader -->
    <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            IsVisible="{Binding !IsInReader}">
      <Grid ColumnDefinitions="*,*,*,*" Height="60">
        <Button Grid.Column="0" Command="{Binding NavigateToLibraryCommand}" 
                Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <StackPanel Spacing="4">
            <TextBlock Text="▤" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="Library" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Command="{Binding NavigateToKomgaCommand}"
                Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <StackPanel Spacing="4">
            <TextBlock Text="K" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Komga" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Command="{Binding NavigateToActivityCommand}"
                Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <StackPanel Spacing="4">
            <TextBlock Text="↻" FontSize="20" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="Activity" FontSize="12" VerticalAlignment="Center"/>
              <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="8" Padding="4,1"
                      VerticalAlignment="Center" IsVisible="{Binding HasActivityItems}">
                <TextBlock Text="{Binding ActivityItemsCount}" FontSize="10" Foreground="White"/>
              </Border>
            </StackPanel>
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Command="{Binding NavigateToSettingsCommand}"
                Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <StackPanel Spacing="4">
            <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="Settings" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Update Notification Overlay -->
    <Panel Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding ShowUpdateNotification}">
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
              CornerRadius="8" Padding="24" MaxWidth="400"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding UpdateAvailable, Source={x:Static res:Loc.Instance}}" 
                     FontSize="18" FontWeight="Bold"/>
          
          <TextBlock Text="{Binding UpdateNotificationMessage}" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="{Binding Ok, Source={x:Static res:Loc.Instance}}" 
                    Command="{Binding CloseUpdateNotificationCommand}"/>
            <Button Content="{Binding BringMeThere, Source={x:Static res:Loc.Instance}}" 
                    Command="{Binding GoToUpdateCommand}" 
                    Classes="accent"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
