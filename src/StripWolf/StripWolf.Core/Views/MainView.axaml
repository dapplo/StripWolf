<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StripWolf.Core.ViewModels"
             xmlns:views="using:StripWolf.Core.Views"
             xmlns:res="using:StripWolf.Core.Resources"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="StripWolf.Core.Views.MainView"
             x:DataType="vm:MainViewModel">
  
  <Grid RowDefinitions="*,Auto">
    <!-- Content Area -->
    <TransitioningContentControl Grid.Row="0" Content="{Binding CurrentView}" Opacity="{Binding WelcomeBackgroundContentOpacity}">
      <TransitioningContentControl.PageTransition>
        <CrossFade Duration="0:0:0.25"/>
      </TransitioningContentControl.PageTransition>
      <TransitioningContentControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
          <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KomgaViewModel}">
          <views:KomgaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
          <views:ActivityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
          <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReaderViewModel}">
          <views:ReaderView />
        </DataTemplate>
      </TransitioningContentControl.DataTemplates>
    </TransitioningContentControl>

    <!-- Tab Bar - Hidden when in reader -->
    <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            IsVisible="{Binding !IsInReader}"
            Opacity="{Binding WelcomeBackgroundContentOpacity}">
      <Grid ColumnDefinitions="*,*,*,*" Height="60">
        <Border Grid.Column="0" Margin="6" CornerRadius="10"
                BorderThickness="3" BorderBrush="White"
                Background="#AA1A73E8" IsHitTestVisible="False"
                IsVisible="{Binding IsWelcomeLibraryStep}"/>
        <Button Grid.Column="0" Command="{Binding NavigateToLibraryCommand}" 
                Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <StackPanel Spacing="4">
            <TextBlock Text="▤" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Library, Source={x:Static res:Loc.Instance}}" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Border Grid.Column="1" Margin="6" CornerRadius="10"
                BorderThickness="3" BorderBrush="White"
                Background="#AA1A73E8" IsHitTestVisible="False"
                IsVisible="{Binding IsWelcomeKomgaStep}"/>
        <Button Grid.Column="1" Command="{Binding NavigateToKomgaCommand}"
                Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <StackPanel Spacing="4">
            <TextBlock Text="K" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Komga, Source={x:Static res:Loc.Instance}}" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Border Grid.Column="2" Margin="6" CornerRadius="10"
                BorderThickness="3" BorderBrush="White"
                Background="#AA1A73E8" IsHitTestVisible="False"
                IsVisible="{Binding IsWelcomeActivityStep}"/>
        <Button Grid.Column="2" Command="{Binding NavigateToActivityCommand}"
                Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <StackPanel Spacing="4">
            <TextBlock Text="↻" FontSize="20" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Activity, Source={x:Static res:Loc.Instance}}" FontSize="12" VerticalAlignment="Center"/>
              <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="8" Padding="4,1"
                      VerticalAlignment="Center" IsVisible="{Binding HasActivityItems}">
                <TextBlock Text="{Binding ActivityItemsCount}" FontSize="10" Foreground="White"/>
              </Border>
            </StackPanel>
          </StackPanel>
        </Button>
        <Border Grid.Column="3" Margin="6" CornerRadius="10"
                BorderThickness="3" BorderBrush="White"
                Background="#AA1A73E8" IsHitTestVisible="False"
                IsVisible="{Binding IsWelcomeSettingsStep}"/>
        <Button Grid.Column="3" Command="{Binding NavigateToSettingsCommand}"
                Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <StackPanel Spacing="4">
            <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Settings, Source={x:Static res:Loc.Instance}}" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Update Notification Overlay -->
    <Panel Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding ShowUpdateNotification}">
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
              CornerRadius="8" Padding="24" MaxWidth="400"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding UpdateAvailable, Source={x:Static res:Loc.Instance}}" 
                     FontSize="18" FontWeight="Bold"/>
          
          <TextBlock Text="{Binding UpdateNotificationMessage}" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="{Binding Ok, Source={x:Static res:Loc.Instance}}" 
                    Command="{Binding CloseUpdateNotificationCommand}"/>
            <Button Content="{Binding BringMeThere, Source={x:Static res:Loc.Instance}}" 
                    Command="{Binding GoToUpdateCommand}" 
                    Classes="accent"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- Welcome Experience Overlay -->
    <Panel Grid.RowSpan="2" Background="#B3000000" IsVisible="{Binding ShowWelcomeExperience}">
      <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="10" Padding="12,8"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,140,16,0"
              IsVisible="{Binding IsWelcomeLibraryImportStep}">
        <TextBlock Text="{Binding WelcomeExperienceImportPointer, Source={x:Static res:Loc.Instance}}"
                   Foreground="White" FontWeight="Bold"/>
      </Border>
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              CornerRadius="12"
              Padding="24"
              Width="560"
              MinHeight="560"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1">
        <Grid RowDefinitions="*,Auto" RowSpacing="16">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16">
          <TextBlock Text="{Binding WelcomeExperience, Source={x:Static res:Loc.Instance}}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding WelcomeExperienceProgress}" Foreground="Gray" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding WelcomeExperienceStepTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding WelcomeExperienceStepDescription}" TextWrapping="Wrap"/>

          <StackPanel Spacing="10" IsVisible="{Binding IsWelcomeFirstStep}">
            <TextBlock Text="{Binding WelcomeExperienceQuickSetup, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Language, Source={x:Static res:Loc.Instance}}" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding WelcomeAvailableLanguages}"
                        SelectedItem="{Binding WelcomeSelectedLanguage}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AppTheme, Source={x:Static res:Loc.Instance}}" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="1" Grid.Column="1"
                        ItemsSource="{Binding WelcomeThemeOptions}"
                        SelectedItem="{Binding WelcomeSelectedThemeOption}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:WelcomeThemeOption">
                    <TextBlock Text="{Binding DisplayName}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <TextBlock Text="{Binding WelcomeExperienceQuickSetupHint, Source={x:Static res:Loc.Instance}}"
                       Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>

            <Border Background="#26222222" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding WelcomeExperienceLicenseRequired, Source={x:Static res:Loc.Instance}}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding WelcomeExperienceReviewLicense, Source={x:Static res:Loc.Instance}}"
                          Command="{Binding OpenWelcomeLicenseDialogCommand}"/>
                  <TextBlock Text="{Binding WelcomeExperienceLicenseAccepted, Source={x:Static res:Loc.Instance}}"
                             IsVisible="{Binding HasAcceptedWelcomeLicense}"
                             Foreground="Green" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding IsWelcomeSupportStep}">
            <TextBlock Text="{Binding WelcomeExperienceSupportCta, Source={x:Static res:Loc.Instance}}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="{Binding DonateWithPayPal, Source={x:Static res:Loc.Instance}}"
                      Command="{Binding OpenWelcomePayPalCommand}"/>
              <Button Content="{Binding DonateWithKoFi, Source={x:Static res:Loc.Instance}}"
                      Command="{Binding OpenWelcomeKoFiCommand}"/>
            </StackPanel>
          </StackPanel>

          <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="8" Padding="10,6"
                  IsVisible="{Binding HasWelcomeExperienceTargetHint}">
            <TextBlock Text="{Binding WelcomeExperienceTargetHint}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </Border>
          </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <Button Grid.Column="0"
                    MinWidth="120"
                    Content="{Binding WelcomeExperienceSkip, Source={x:Static res:Loc.Instance}}"
                    Command="{Binding SkipWelcomeExperienceCommand}"
                    IsEnabled="{Binding CanSkipWelcome}"/>
            <Button Grid.Column="2"
                    MinWidth="120"
                    Content="{Binding WelcomeExperienceBack, Source={x:Static res:Loc.Instance}}"
                    Command="{Binding PreviousWelcomeExperienceStepCommand}"
                    IsEnabled="{Binding !IsWelcomeFirstStep}"/>
            <Button Grid.Column="3"
                    MinWidth="120"
                    Classes="accent"
                    Content="{Binding WelcomeExperienceNextButtonLabel}"
                    Command="{Binding NextWelcomeExperienceStepCommand}"
                    IsEnabled="{Binding CanContinueWelcomeStep}"/>
          </Grid>
        </Grid>
      </Border>

      <Panel Background="#A0000000" IsVisible="{Binding ShowWelcomeLicenseDialog}">
        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="12" Padding="18" MaxWidth="620"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding WelcomeExperienceLicenseTitle, Source={x:Static res:Loc.Instance}}"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding WelcomeExperienceLicenseSummary, Source={x:Static res:Loc.Instance}}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding WelcomeExperienceLicenseAsIs, Source={x:Static res:Loc.Instance}}"
                       TextWrapping="Wrap" Foreground="Gray"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{Binding WelcomeExperienceOpenGplLink, Source={x:Static res:Loc.Instance}}"
                      Command="{Binding OpenGplLicenseCommand}"/>
              <Button Content="{Binding WelcomeExperienceDecline, Source={x:Static res:Loc.Instance}}"
                      Command="{Binding CloseWelcomeLicenseDialogCommand}"/>
              <Button Content="{Binding WelcomeExperienceAcceptLicense, Source={x:Static res:Loc.Instance}}"
                      Classes="accent"
                      Command="{Binding AcceptWelcomeLicenseCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Panel>

    <!-- Premium Unlock Overlay -->
    <Panel Grid.RowSpan="2" Background="#B3000000" IsVisible="{Binding ShowPremiumUnlockDialog}">
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              CornerRadius="12" Padding="28" MaxWidth="500"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1">
        <StackPanel Spacing="20">
          <TextBlock Text="Unlock Premium Features" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
          
          <TextBlock Text="You have reached some limits of the trial in the free version. To read, download, and import unlimited comics, support the app by purchasing the premium unlock!" 
                     TextWrapping="Wrap" FontSize="14" TextAlignment="Center" Foreground="Gray"/>
          
          <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="✔" Foreground="Green" FontWeight="Bold"/>
                <TextBlock Text="Unlimited local library imports"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="✔" Foreground="Green" FontWeight="Bold"/>
                <TextBlock Text="Unlimited Komga server downloads &amp; viewing"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="✔" Foreground="Green" FontWeight="Bold"/>
                <TextBlock Text="Personal reading statistics dashboard"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="✔" Foreground="Green" FontWeight="Bold"/>
                <TextBlock Text="Supports ongoing development &amp; updates"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Spacing="10">
            <Button Content="Unlock Premium (One-Time Purchase)" 
                    Command="{Binding PurchasePremiumUnlockCommand}" 
                    Classes="accent"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
            
            <Button Content="Keep Testing Free Version" 
                    Command="{Binding ClosePremiumUnlockDialogCommand}" 
                    Background="Transparent"
                    Height="36"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
