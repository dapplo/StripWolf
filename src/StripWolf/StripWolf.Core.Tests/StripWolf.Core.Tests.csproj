<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are executables -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>StripWolf.Core.Tests</RootNamespace>
    <AssemblyName>StripWolf.Core.Tests</AssemblyName>
    <!--
      The OpenCV native runtime isn't available on the Linux CI runners and no test needs the panel detection,
      so StripWolf.Core is built without it (PanelDetectionService.NoOp.cs). Pass -p:UseOpenCvPanelDetection=true to
      build it with OpenCV, e.g. to share the StripWolf.Core build with StripWolf.Desktop on Windows.
    -->
    <UseOpenCvPanelDetection Condition="'$(UseOpenCvPanelDetection)' == ''">false</UseOpenCvPanelDetection>
  </PropertyGroup>

  <!--
    SixLabors.ImageSharp 4 checks for a license at build time, but only for projects referencing it directly.
    The tests use ImageSharp transitively via StripWolf.Core (like StripWolf.Desktop does), the license file of
    StripWolf.Core is passed anyway in case ImageSharp is ever referenced directly.
  -->
  <PropertyGroup Condition="'$(SixLaborsLicenseFile)' == '' and '$(SixLaborsLicenseKey)' == '' and Exists('$(MSBuildThisFileDirectory)..\StripWolf.Core\sixlabors.lic')">
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory)..\StripWolf.Core\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StripWolf.Core\StripWolf.Core.csproj" AdditionalProperties="UseOpenCvPanelDetection=$(UseOpenCvPanelDetection);UseEpubSupport=true" UndefineProperties="RuntimeIdentifier" />
  </ItemGroup>

  <ItemGroup>
    <!-- Synthetic comic fixtures, see TestData/generate_fixtures.py -->
    <None Remove="TestData\**\*" />
    <None Include="TestData\**\*.py" />
    <Content Include="TestData\**\*" Exclude="TestData\**\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
