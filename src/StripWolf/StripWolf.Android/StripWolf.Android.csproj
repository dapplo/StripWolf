<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.dapplo.StripWolf</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Exclude PDFium from Android build to reduce APK size -->
    <ExcludePdfium>true</ExcludePdfium>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- Release signing configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <StripWolfSigningKeyStore Condition="'$(STRIPWOLF_KEYSTORE_PATH)' != ''">$(STRIPWOLF_KEYSTORE_PATH)</StripWolfSigningKeyStore>
    <StripWolfSigningKeyStore Condition="'$(StripWolfSigningKeyStore)' == ''">$(MSBuildProjectDirectory)\StripWolf.keystore</StripWolfSigningKeyStore>
    <AndroidKeyStore Condition="Exists('$(StripWolfSigningKeyStore)')">true</AndroidKeyStore>
    <AndroidSigningKeyStore Condition="Exists('$(StripWolfSigningKeyStore)')">$(StripWolfSigningKeyStore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="Exists('$(StripWolfSigningKeyStore)')">StripWolf</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass Condition="Exists('$(StripWolfSigningKeyStore)')">$(ANDROID_SIGNING_KEY_PASS)</AndroidSigningKeyPass>
    <AndroidSigningStorePass Condition="Exists('$(StripWolfSigningKeyStore)')">$(ANDROID_SIGNING_STORE_PASS)</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.android-arm64" />
    <PackageReference Include="Sdcb.OpenCvSharp4.mini.runtime.android-x64" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StripWolf\StripWolf.csproj" />
  </ItemGroup>
</Project>
