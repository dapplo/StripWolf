<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only backup the settings. Exclude DB and Covers.
         The credentials (credentials.dat) and their key (.key) are not backed up: with both in the same backup,
         anyone with access to it could decrypt the passwords. After a restore, server passwords are entered again. -->
    <cloud-backup>
        <include domain="file" path=".local/share/StripWolf/settings.json" />
    </cloud-backup>
    <device-to-device-backup>
        <include domain="file" path=".local/share/StripWolf/settings.json" />
    </device-to-device-backup>
</data-extraction-rules>
