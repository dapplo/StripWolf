<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <UseOpenCvPanelDetection Condition="'$(UseOpenCvPanelDetection)' == ''">true</UseOpenCvPanelDetection>
    <UseEpubSupport Condition="'$(UseEpubSupport)' == ''">true</UseEpubSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseEpubSupport)' == 'false'">
    <DefineConstants>$(DefineConstants);DISABLE_EPUB_SUPPORT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseOpenCvPanelDetection)' == 'false'">
    <DefineConstants>$(DefineConstants);DISABLE_GUIDED_READING</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="VersOne.Epub" />
    <!-- For SQLite local storage -->
    <PackageReference Include="sqlite-net-pcl" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" />
    <!-- For CBR (RAR) file support -->
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="GitVersion.MsBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseOpenCvPanelDetection)' == 'true'">
    <!-- For Panel Detection -->
    <PackageReference Include="OpenCvSharp4" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseOpenCvPanelDetection)' == 'false'">
    <Compile Remove="Services\PanelDetectionService.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseOpenCvPanelDetection)' != 'false'">
    <Compile Remove="Services\PanelDetectionService.NoOp.cs" />
  </ItemGroup>

</Project>
