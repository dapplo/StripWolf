<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StripWolf.ViewModels"
             xmlns:views="using:StripWolf.Views"
             xmlns:converters="using:StripWolf.Converters"
             x:Class="StripWolf.Views.ReaderView"
             x:DataType="vm:ReaderViewModel"
             Background="Black"
             Focusable="True">
  
  <UserControl.Styles>
    <Style Selector="Button.reading-mode">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.reading-mode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#44FFFFFF"/>
    </Style>
    <Style Selector="Button.reading-mode.active">
      <Setter Property="Background" Value="Red"/>
    </Style>
    <Style Selector="Button.reading-mode.active /template/ ContentPresenter">
      <Setter Property="Background" Value="Red"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Content Area: Swaps based on ReadingMode -->
    <Panel>
      <views:NormalReadingView IsVisible="{Binding IsNormalMode}"/>
      <views:ZoomedReadingView IsVisible="{Binding IsZoomedMode}"/>
      <views:GuidedReadingView IsVisible="{Binding IsGuidedMode}"/>
    </Panel>

    <!-- Shared UI Overlays -->
    
    <!-- Loading Indicator -->
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"/>

    <!-- Top Controls -->
    <Border VerticalAlignment="Top" Background="#E0000000" Padding="16"
            IsVisible="{Binding IsControlsVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <Button Grid.Column="0" Content="← Back" Command="{Binding GoBackCommand}" 
                Background="Transparent" Foreground="White"/>
        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="18" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="16,0"/>
        
        <!-- Save Page Button (Debug Only) -->
        <Button Grid.Column="2" Command="{Binding SaveCurrentPageCommand}"
                IsVisible="{Binding IsDebug}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Save Original Page (Debug)">
          <TextBlock Text="💾" FontSize="24"/>
        </Button>
        
        <Button Grid.Column="3" Command="{Binding ToggleInfoPanelCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Info (I)">
          <TextBlock Text="ⓘ" FontSize="24"/>
        </Button>
        
        <!-- Reading Modes -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
          <Button Classes="reading-mode" 
                  Classes.active="{Binding IsNormalMode}"
                  Command="{Binding SetNormalModeCommand}"
                  ToolTip.Tip="Normal Mode">
            <TextBlock Text="▯" FontSize="20"/>
          </Button>
          <Button Classes="reading-mode" 
                  Classes.active="{Binding IsZoomedMode}"
                  Command="{Binding SetZoomedModeCommand}"
                  ToolTip.Tip="Zoomed Mode">
            <TextBlock Text="🔍" FontSize="20"/>
          </Button>
          <Button Classes="reading-mode" 
                  Classes.active="{Binding IsGuidedMode}"
                  Command="{Binding SetGuidedModeCommand}"
                  ToolTip.Tip="Guided Mode">
            <TextBlock Text="⊞" FontSize="20"/>
          </Button>
        </StackPanel>
        
        <Button Grid.Column="5" Command="{Binding ToggleHandednessCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Handedness"
                IsEnabled="{Binding !IsNormalMode}">
          <TextBlock Text="🤚" FontSize="24"/>
        </Button>
        
        <Button Grid.Column="6" Command="{Binding ToggleTwoPageModeCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Two-Page (2)"
                IsEnabled="{Binding CanUseTwoPageMode}">
          <TextBlock Text="{Binding TwoPageModeIcon}" FontSize="24"/>
        </Button>
        
        <Button Grid.Column="7" Command="{Binding CycleStretchModeCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Fit Mode"
                IsEnabled="{Binding IsNormalMode}">
          <TextBlock Text="{Binding StretchModeIcon}" FontSize="24"/>
        </Button>
        
        <Button Grid.Column="8" Command="{Binding ToggleFullScreenCommand}"
                Background="Transparent" Foreground="White" Margin="8,0" ToolTip.Tip="Full Screen (F)">
          <TextBlock Text="⛶" FontSize="24"/>
        </Button>
      </Grid>
    </Border>

    <!-- Bottom Controls -->
    <Border VerticalAlignment="Bottom" Background="#E0000000" Padding="16,8"
            IsVisible="{Binding IsControlsVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Command="{Binding GoToPreviousPageCommand}"
                Background="Transparent" Foreground="White" IsEnabled="{Binding HasPreviousPage}">
          <TextBlock Text="◀" FontSize="28"/>
        </Button>
        
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="16,0">
          <Slider Grid.Column="0" Minimum="0" Maximum="{Binding MaxSliderValue}" 
                  Value="{Binding CurrentPage}" 
                  Foreground="Red"/>
          <TextBlock Grid.Column="1" Text="{Binding PageDisplay}" Foreground="White" 
                     VerticalAlignment="Center" Margin="12,0,0,0" Width="100" TextAlignment="Right"
                     FontSize="16"/>
        </Grid>
        
        <Button Grid.Column="2" Command="{Binding GoToNextPageCommand}"
                Background="Transparent" Foreground="White" IsEnabled="{Binding HasNextPage}">
          <TextBlock Text="▶" FontSize="28"/>
        </Button>
      </Grid>
    </Border>

    <!-- Info Panel Overlay -->
    <Border IsVisible="{Binding IsInfoPanelVisible}" Background="#F0000000" Padding="32"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="100">
      <Grid RowDefinitions="Auto,*" MaxWidth="600" HorizontalAlignment="Center">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <TextBlock Text="Comic Information" FontSize="24" FontWeight="Bold" Foreground="White"/>
          <Button Grid.Column="1" Command="{Binding ToggleInfoPanelCommand}"
                  Background="Transparent" Foreground="White">
            <TextBlock Text="✕" FontSize="24"/>
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="16">
            <!-- Basic Info -->
            <StackPanel Spacing="4">
              <TextBlock Text="Title" Foreground="#888" FontSize="12"/>
              <TextBlock Text="{Binding Comic.Title}" Foreground="White" FontSize="18" TextWrapping="Wrap"/>
              
              <TextBlock Foreground="#888" FontSize="12" Margin="0,8,0,0" Text="Series">
                <TextBlock.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="ComicInfo.Series" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                    <Binding Path="Comic.SeriesName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                  </MultiBinding>
                </TextBlock.IsVisible>
              </TextBlock>
              <TextBlock Foreground="White" FontSize="16">
                <TextBlock.Text>
                  <MultiBinding Converter="{x:Static converters:FilePathToBitmapConverter.FirstNonNullStringConverter}">
                    <Binding Path="ComicInfo.Series"/>
                    <Binding Path="Comic.SeriesName"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>              
              <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                <StackPanel Grid.Column="0" IsVisible="{Binding ComicInfo.Number, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Issue" Foreground="#888" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.Number}" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1" IsVisible="{Binding ComicInfo.Volume.HasValue}">
                  <TextBlock Text="Volume" Foreground="#888" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.Volume}" Foreground="White"/>
                </StackPanel>
              </Grid>
            </StackPanel>

            <Separator Background="#333"/>

            <!-- Metadata from ComicInfo -->
            <StackPanel Spacing="8" IsVisible="{Binding ComicInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel IsVisible="{Binding AuthorsDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="Creators" Foreground="#888" FontSize="12"/>
                <TextBlock Text="{Binding AuthorsDisplay}" Foreground="White" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding ComicInfo.Publisher, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="Publisher" Foreground="#888" FontSize="12"/>
                <TextBlock Text="{Binding ComicInfo.Publisher}" Foreground="White"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding ComicInfo.Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="Summary" Foreground="#888" FontSize="12"/>
                <TextBlock Text="{Binding ComicInfo.Summary}" Foreground="White" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding ComicInfo.StoryArc, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="Story Arc" Foreground="#888" FontSize="12"/>
                <TextBlock Text="{Binding ComicInfo.StoryArc}" Foreground="White" TextWrapping="Wrap"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                <StackPanel Grid.Column="0" IsVisible="{Binding ComicInfo.Genre, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Genre" Foreground="#888" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.Genre}" Foreground="White" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" IsVisible="{Binding ComicInfo.LanguageISO, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Language" Foreground="#888" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.LanguageISO}" Foreground="White"/>
                </StackPanel>
              </Grid>

              <StackPanel IsVisible="{Binding ComicInfo.Tags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="Tags" Foreground="#888" FontSize="12"/>
                <TextBlock Text="{Binding ComicInfo.Tags}" Foreground="White" TextWrapping="Wrap"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                <StackPanel Grid.Column="0" IsVisible="{Binding ComicInfo.Format, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Format" Foreground="#888" FontSize="12"/>
                  <TextBlock Text="{Binding ComicInfo.Format}" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1" IsVisible="{Binding Comic.ReleaseDate.HasValue}">
                  <TextBlock Text="Release Date" Foreground="#888" FontSize="12"/>
                  <TextBlock Text="{Binding Comic.ReleaseDate, StringFormat=\{0:yyyy-MM-dd\}}" Foreground="White"/>
                </StackPanel>
              </Grid>

              <StackPanel IsVisible="{Binding ComicInfo.Characters, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="Characters" Foreground="#888" FontSize="12"/>
                <TextBlock Text="{Binding ComicInfo.Characters}" Foreground="White" TextWrapping="Wrap" FontSize="13"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding ComicInfo.Teams, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="Teams" Foreground="#888" FontSize="12"/>
                <TextBlock Text="{Binding ComicInfo.Teams}" Foreground="White" TextWrapping="Wrap" FontSize="13"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,8,0,0">
                <StackPanel IsVisible="{Binding ComicInfo.Manga, Converter={x:Static ObjectConverters.IsNotNull}}" Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Manga" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ComicInfo.Manga}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel IsVisible="{Binding ComicInfo.BlackAndWhite, Converter={x:Static ObjectConverters.IsNotNull}}" Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="B&amp;W" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ComicInfo.BlackAndWhite}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel IsVisible="{Binding ComicInfo.AgeRating, Converter={x:Static ObjectConverters.IsNotNull}}" Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Rating" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ComicInfo.AgeRating}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>

              <StackPanel IsVisible="{Binding ComicInfo.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="Notes" Foreground="#888" FontSize="12"/>
                <TextBlock Text="{Binding ComicInfo.Notes}" Foreground="White" TextWrapping="Wrap" FontSize="12" FontStyle="Italic"/>
              </StackPanel>
            </StackPanel>

            <Separator Background="#333"/>

            <!-- File / Library Info -->
            <StackPanel Spacing="8">
              <StackPanel>
                <TextBlock Text="Location" Foreground="#888" FontSize="12"/>
                <TextBlock Text="{Binding Location}" Foreground="White" TextWrapping="Wrap" FontSize="14"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Source" Foreground="#888" FontSize="12"/>
                  <TextBlock Text="{Binding SourceDisplayName}" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Size" Foreground="#888" FontSize="12"/>
                  <TextBlock Text="{Binding FormattedFileSize}" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Pages" Foreground="#888" FontSize="12"/>
                  <TextBlock Text="{Binding Comic.PageCount}" Foreground="White"/>
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                <StackPanel IsVisible="{Binding IsFromKomga}" Orientation="Horizontal" Spacing="4">
                   <TextBlock Text="🔗" Foreground="White"/>
                   <TextBlock Text="Komga Linked" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
