<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StripWolf.Views.DirectoryImportSeriesPromptWindow"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Import folder">
  <Border Padding="20">
    <StackPanel Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="Import folder" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="DirectoryNameTextBlock" Foreground="Gray" TextWrapping="Wrap"/>
      </StackPanel>

      <CheckBox x:Name="UseSeriesNameCheckBox"
                Content="Apply a series name to all imported comics"
                IsChecked="True"
                IsCheckedChanged="OnUseSeriesNameChanged"/>

      <StackPanel Spacing="8">
        <TextBlock Text="Series name"/>
        <TextBox x:Name="SeriesNameTextBox"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Reset to folder name"
                  Click="OnResetSeriesNameClicked"/>
        </StackPanel>
      </StackPanel>

      <TextBlock Foreground="Gray"
                 TextWrapping="Wrap"
                 Text="The suggested value uses the selected folder name only. You can disable it, reset to the original folder name, or edit it manually."/>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <Button Grid.Column="0"
                Content="Cancel"
                Click="OnCancelClicked"
                HorizontalAlignment="Stretch"/>
        <Button Grid.Column="1"
                Content="Import"
                Click="OnImportClicked"
                HorizontalAlignment="Stretch"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
