<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StripWolf.ViewModels"
             xmlns:views="using:StripWolf.Views"
             xmlns:controls="using:StripWolf.Controls"
             xmlns:repeater="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:models="using:StripWolf.Models"
             xmlns:converters="using:StripWolf.Converters"
             xmlns:res="using:StripWolf.Resources"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="StripWolf.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             x:Name="Root">
  
  <UserControl.Styles>
    <Style Selector="Button.icon-btn">
      <Setter Property="Padding" Value="4"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>
  
  <UserControl.Resources>
    <DataTemplate x:Key="ComicTemplate" x:DataType="models:Comic">
      <Border CornerRadius="8" ClipToBounds="True" Width="150"
               Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <Grid RowDefinitions="200,Auto,Auto,Auto">
          <!-- Cover with click handler -->
          <Button Grid.Row="0" Padding="0" Background="Transparent" Height="200"
                  IsEnabled="{Binding !IsDeleting}"
                  Command="{Binding ((vm:LibraryViewModel)DataContext).OpenComicCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}"
                  CommandParameter="{Binding}">
            <Border Background="Black" CornerRadius="8,8,0,0">
              <Panel>
                <controls:AsyncImage SourceUrl="{Binding CoverPath}" Stretch="Uniform"
                                     RenderOptions.BitmapInterpolationMode="LowQuality"
                                     IsHitTestVisible="False"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <!-- Deleting overlay -->
                <Border Background="#80000000" IsVisible="{Binding IsDeleting}" IsHitTestVisible="False">
                  <TextBlock Text="DELETING..." Foreground="White" FontWeight="Bold" 
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Panel>
            </Border>
          </Button>
          <Border Grid.Row="1" Height="36" Margin="8,4">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding SeriesName}" FontSize="10" Foreground="Gray" 
                         IsVisible="{Binding SeriesName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                         TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap"
                         ToolTip.Tip="{Binding Title}"/>
            </StackPanel>
          </Border>
          
          <StackPanel Grid.Row="2" Height="28" Margin="8,0,8,4" Spacing="3">
             <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReadingProgress}"
                          Height="4"
                          IsVisible="{Binding HasReadingProgress}"/>

             <TextBlock Text="{Binding ReadingProgressDisplay}"
                        FontSize="10" Foreground="Gray"
                        TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <!-- Actions Grid (2x2) -->
          <Panel Grid.Row="3" Margin="4,4,4,6" Height="80">
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" IsVisible="{Binding !IsDeleting}">
              <!-- Info -->
              <Button Grid.Column="0" Grid.Row="0" Classes="icon-btn"
                      Command="{Binding ((vm:LibraryViewModel)DataContext).ShowComicInfoCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}"
                      CommandParameter="{Binding}" ToolTip.Tip="Information">
                <TextBlock Text="ⓘ" FontSize="18" VerticalAlignment="Center"/>
              </Button>
              <!-- Favorite -->
              <Button Grid.Column="1" Grid.Row="0" Classes="icon-btn"
                      Command="{Binding ((vm:LibraryViewModel)DataContext).ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}"
                      CommandParameter="{Binding}" ToolTip.Tip="Favorite">
                <Panel>
                  <TextBlock Text="☆" IsVisible="{Binding !IsFavorite}" FontSize="18" VerticalAlignment="Center"/>
                  <TextBlock Text="★" IsVisible="{Binding IsFavorite}" Foreground="Gold" FontSize="18" VerticalAlignment="Center"/>
                </Panel>
              </Button>
              <!-- Mark Read -->
              <Button Grid.Column="0" Grid.Row="1" Classes="icon-btn" 
                      Command="{Binding ((vm:LibraryViewModel)DataContext).ToggleReadStatusCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}"
                      CommandParameter="{Binding}" ToolTip.Tip="Mark Read/Unread">
                 <Panel>
                    <TextBlock Text="✓" IsVisible="{Binding !IsCompleted}" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="☑" IsVisible="{Binding IsCompleted}" Foreground="{DynamicResource SystemAccentColor}" FontSize="18" VerticalAlignment="Center"/>
                 </Panel>
              </Button>
              <!-- Delete -->
              <Button Grid.Column="1" Grid.Row="1" Classes="icon-btn"
                      Command="{Binding ((vm:LibraryViewModel)DataContext).DeleteComicCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}"
                      CommandParameter="{Binding}" ToolTip.Tip="Delete">
                <TextBlock Text="✕" FontSize="18" VerticalAlignment="Center"/>
              </Button>
            </Grid>
            
            <!-- Undo Button with Timer -->
            <Button FontSize="10" Padding="8,4" Background="#FFF3E0" Foreground="Black"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    IsVisible="{Binding IsDeleting}"
                    Command="{Binding ((vm:LibraryViewModel)DataContext).UndoComicDeleteCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}"
                    CommandParameter="{Binding}">
              <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="↩ Undo" FontWeight="Bold"/>
                <TextBlock Text="{Binding DeletionSecondsRemaining, StringFormat='{}{0}s'}" FontSize="9"/>
              </StackPanel>
            </Button>
          </Panel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="SeriesGroupTemplate" x:DataType="models:ComicSeriesGroup">
      <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,16" Padding="0" HorizontalAlignment="Stretch">
        <Expander.Header>
          <Border CornerRadius="8" Padding="12" HorizontalAlignment="Stretch"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
              <Border Width="72" Height="96" CornerRadius="8" ClipToBounds="True" Background="Black">
                <controls:AsyncImage SourceUrl="{Binding RepresentativeComic.CoverPath}" Stretch="Uniform"
                                     RenderOptions.BitmapInterpolationMode="LowQuality"
                                     IsHitTestVisible="False"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
              </Border>

              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding RepresentativeComic.Title}" FontSize="12" Foreground="Gray"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <TextBlock Text="{Binding ReadCount, StringFormat='{}{0} read'}" FontSize="12" Foreground="Gray"/>
              </StackPanel>

              <Border Grid.Column="2" Background="{DynamicResource SystemAccentColor}" CornerRadius="999" Padding="10,4"
                      VerticalAlignment="Top">
                <TextBlock Text="{Binding ComicCount, StringFormat='{}{0} comics'}" Foreground="White" FontSize="12"/>
              </Border>

              <Button Grid.Column="3"
                      Command="{Binding ((vm:LibraryViewModel)DataContext).DeleteSeriesCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}"
                      CommandParameter="{Binding}"
                      Background="#D32F2F"
                      Foreground="White"
                      Padding="10,4"
                      VerticalAlignment="Top"
                      ToolTip.Tip="Delete series from library">
                <TextBlock Text="Delete" FontSize="12"/>
              </Button>
            </Grid>
          </Border>
        </Expander.Header>

        <repeater:ItemsRepeater ItemsSource="{Binding Comics}" ItemTemplate="{StaticResource ComicTemplate}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
          <repeater:ItemsRepeater.Layout>
            <layout:UniformGridLayout Orientation="Horizontal"
                                      MinItemWidth="162"
                                      MinItemHeight="356"
                                      MinColumnSpacing="12"
                                      MinRowSpacing="12"/>
          </repeater:ItemsRepeater.Layout>
        </repeater:ItemsRepeater>
      </Expander>
    </DataTemplate>
  </UserControl.Resources>
  
  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="16">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="{Binding Library, Source={x:Static res:Loc.Instance}}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="📁 Open Folder" Command="{Binding OpenComicsDirectoryCommand}" 
                Padding="16,8" Margin="0,0,8,0" IsVisible="{Binding IsDesktop}"/>
        <Button Grid.Column="2" Content="{Binding ImportFolder, Source={x:Static res:Loc.Instance}}" Click="OnImportFolderClicked" Padding="16,8" Margin="0,0,8,0" IsVisible="{Binding IsDesktop}"/>
        <Button Grid.Column="3" Content="{Binding ImportComic, Source={x:Static res:Loc.Instance}}" Click="OnImportClicked" Padding="16,8"/>
      </Grid>
    </Border>
    
    <!-- Content -->
    <ScrollViewer Grid.Row="1" Padding="16"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  IsScrollInertiaEnabled="True"
                  IsScrollChainingEnabled="True">
      <StackPanel Spacing="24" Margin="0,0,0,76">
        
        <!-- Search Box -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="🔍 Search comics..."
                   VerticalContentAlignment="Center"/>
          <Button Grid.Column="1" Content="✕" Command="{Binding ClearSearchCommand}" 
                  Padding="8,6" Margin="4,0,0,0"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>

        <!-- Search Results Section -->
        <StackPanel Spacing="8" IsVisible="{Binding IsSearching}">
          <TextBlock Text="Search Results" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="No comics found" Foreground="Gray" IsVisible="{Binding !SearchResults.Count}" Margin="0,8"/>
          
          <repeater:ItemsRepeater ItemsSource="{Binding SearchResults}" IsVisible="{Binding SearchResults.Count}"
                                  ItemTemplate="{StaticResource ComicTemplate}">
            <repeater:ItemsRepeater.Layout>
              <layout:UniformGridLayout Orientation="Horizontal"
                                        MinItemWidth="162"
                                        MinItemHeight="356"
                                        MinColumnSpacing="12"
                                        MinRowSpacing="12"/>
            </repeater:ItemsRepeater.Layout>
          </repeater:ItemsRepeater>
        </StackPanel>
        
        <!-- Error Message -->
        <Border Background="#FFEBEE" CornerRadius="8" Padding="12"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828"/>
        </Border>

        <!-- Pending Imports Section -->
        <StackPanel Spacing="8" IsVisible="{Binding PendingImports.Count}">
          <TextBlock Text="Importing..." FontSize="18" FontWeight="Bold"/>
          <ItemsControl ItemsSource="{Binding PendingImports}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PendingImport">
                <Border CornerRadius="8" Padding="12"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Border Grid.Column="0" Grid.RowSpan="3" Width="48" Height="48" 
                            CornerRadius="8" Background="Black" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                      <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Status}" FontSize="12" Foreground="Gray"/>
                    <ProgressBar Grid.Column="1" Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" Margin="0,4,0,0" IsVisible="{Binding IsProcessing}"/>
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding ErrorMessage}" FontSize="10" Foreground="#C62828" Margin="0,4,0,0" IsVisible="{Binding IsFailed}" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Grid.RowSpan="3" Content="✕" FontSize="12" Padding="8,4" VerticalAlignment="Center" IsVisible="{Binding IsFailed}" Command="{Binding ((vm:LibraryViewModel)DataContext).RemovePendingImportCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}" CommandParameter="{Binding}"/>
                    <TextBlock Grid.Column="2" Grid.RowSpan="3" Text="✓" FontSize="20" Foreground="Green" VerticalAlignment="Center" IsVisible="{Binding IsCompleted}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Main Content (hidden when searching) -->
        <Grid IsVisible="{Binding !IsSearching}" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="24">

          <!-- Continue Reading Section -->
          <Expander Grid.Row="{Binding ContinueReadingSectionOrder}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowContinueReadingSection}"
                    IsExpanded="{Binding IsContinueReadingSectionExpanded}">
            <Expander.Header>
              <TextBlock Text="Continue Reading" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <repeater:ItemsRepeater ItemsSource="{Binding InProgressComics}" ItemTemplate="{StaticResource ComicTemplate}" Margin="0,8,0,0">
              <repeater:ItemsRepeater.Layout>
                <layout:UniformGridLayout Orientation="Horizontal"
                                          MinItemWidth="162"
                                          MinItemHeight="356"
                                          MinColumnSpacing="12"
                                          MinRowSpacing="12"/>
              </repeater:ItemsRepeater.Layout>
            </repeater:ItemsRepeater>
          </Expander>

          <!-- New Comics Section -->
          <Expander Grid.Row="{Binding NewComicsSectionOrder}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowNewComicsSection}"
                    IsExpanded="{Binding IsNewComicsSectionExpanded}">
            <Expander.Header>
              <TextBlock Text="New Comics" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <StackPanel Spacing="8" Margin="0,8,0,0" HorizontalAlignment="Stretch">
              <StackPanel Spacing="16" HorizontalAlignment="Center" Margin="32" IsVisible="{Binding !NewComics.Count}">
                <TextBlock Text="▤" FontSize="56" HorizontalAlignment="Center"/>
                <TextBlock Text="No new comics" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Import a comic file or download from Komga to get started" Foreground="Gray" HorizontalAlignment="Center" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <Button Content="{Binding ImportComic, Source={x:Static res:Loc.Instance}}" Click="OnImportClicked" HorizontalAlignment="Center"/>
                  <Button Content="{Binding ImportFolder, Source={x:Static res:Loc.Instance}}" Click="OnImportFolderClicked" HorizontalAlignment="Center" IsVisible="{Binding IsDesktop}"/>
                </StackPanel>
              </StackPanel>

              <repeater:ItemsRepeater ItemsSource="{Binding NewComics}" IsVisible="{Binding NewComics.Count}"
                                      ItemTemplate="{StaticResource ComicTemplate}">
                <repeater:ItemsRepeater.Layout>
                  <layout:UniformGridLayout Orientation="Horizontal"
                                            MinItemWidth="162"
                                            MinItemHeight="356"
                                            MinColumnSpacing="12"
                                            MinRowSpacing="12"/>
                </repeater:ItemsRepeater.Layout>
              </repeater:ItemsRepeater>
            </StackPanel>
          </Expander>

          <!-- Favorites Section -->
          <Expander Grid.Row="{Binding FavoritesSectionOrder}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowFavoritesSection}"
                    IsExpanded="{Binding IsFavoritesSectionExpanded}">
            <Expander.Header>
              <TextBlock Text="⭐ Favorites" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <repeater:ItemsRepeater ItemsSource="{Binding FavoriteComics}" ItemTemplate="{StaticResource ComicTemplate}" Margin="0,8,0,0">
              <repeater:ItemsRepeater.Layout>
                <layout:UniformGridLayout Orientation="Horizontal"
                                          MinItemWidth="162"
                                          MinItemHeight="356"
                                          MinColumnSpacing="12"
                                          MinRowSpacing="12"/>
              </repeater:ItemsRepeater.Layout>
            </repeater:ItemsRepeater>
          </Expander>

          <!-- Series Section -->
          <Expander Grid.Row="{Binding SeriesSectionOrder}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowSeriesSection}"
                    IsExpanded="{Binding IsSeriesSectionExpanded}">
            <Expander.Header>
              <TextBlock Text="Series" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <StackPanel Spacing="8" Margin="0,8,0,0" HorizontalAlignment="Stretch">
              <TextBlock Text="Series with multiple comics in your library" Foreground="Gray"/>
              <ItemsControl ItemsSource="{Binding SeriesGroups}" ItemTemplate="{StaticResource SeriesGroupTemplate}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="16"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Expander>

          <!-- Read Section -->
          <Expander Grid.Row="{Binding ReadSectionOrder}"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowReadSection}"
                    IsExpanded="{Binding IsReadSectionExpanded}">
            <Expander.Header>
              <TextBlock Text="Read" FontSize="18" FontWeight="Bold"/>
            </Expander.Header>
            <repeater:ItemsRepeater ItemsSource="{Binding CompletedComics}" ItemTemplate="{StaticResource ComicTemplate}" Margin="0,8,0,0">
              <repeater:ItemsRepeater.Layout>
                <layout:UniformGridLayout Orientation="Horizontal"
                                          MinItemWidth="162"
                                          MinItemHeight="356"
                                          MinColumnSpacing="12"
                                          MinRowSpacing="12"/>
              </repeater:ItemsRepeater.Layout>
            </repeater:ItemsRepeater>
          </Expander>

        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- Delete Confirmation Overlay -->
    <Border Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding ShowDeleteConfirmation}">
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
              CornerRadius="8" Padding="24" Width="400"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 4 20 0 #40000000">
        <StackPanel Spacing="16">
          <TextBlock Text="Confirm External File Deletion" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="This comic is located outside of the application's internal directory. Are you sure you want to delete it from its original location?" TextWrapping="Wrap"/>
          <Border Background="#F5F5F5" Padding="12" CornerRadius="4">
            <TextBlock Text="{Binding DeleteConfirmationPath}" FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
          </Border>
          <StackPanel Orientation="Vertical" Spacing="8">
            <Button Content="Remove from Library (Keep File)" Command="{Binding RemoveFromLibraryCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Grid ColumnDefinitions="*,*">
              <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelDeleteCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" HorizontalContentAlignment="Center"/>
              <Button Grid.Column="1" Content="Delete Permanently" Command="{Binding ConfirmDeleteCommand}" Background="#D32F2F" Foreground="White" HorizontalAlignment="Stretch" Margin="4,0,0,0" HorizontalContentAlignment="Center"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Comic Info Overlay -->
    <Panel Grid.RowSpan="2" IsVisible="{Binding SelectedInfoComic, Converter={x:Static ObjectConverters.IsNotNull}}">
      <!-- Click background to close -->
      <Border Background="#80000000"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              PointerPressed="OnComicInfoBackdropPressed"/>
      
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
              CornerRadius="8" Padding="0" MaxWidth="500" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 4 20 0 #40000000">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource SystemAccentColor}" Padding="16" CornerRadius="8,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Comic Information" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="✕" Command="{Binding CloseComicInfoCommand}" Background="Transparent" Foreground="White" FontSize="18" Padding="8,4"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" MaxHeight="600">
            <Border Padding="24">
              <StackPanel Spacing="16" x:DataType="models:Comic" DataContext="{Binding ((vm:LibraryViewModel)DataContext).SelectedInfoComic, RelativeSource={RelativeSource AncestorType=views:LibraryView}}">
                <Grid ColumnDefinitions="150,*">
                   <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Background="Black" Height="200">
                     <controls:AsyncImage SourceUrl="{Binding CoverPath}" Stretch="Uniform"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                   </Border>
                  <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="8">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                    <StackPanel IsVisible="{Binding SeriesName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="Series" FontSize="12" Foreground="Gray"/>
                      <TextBlock Text="{Binding SeriesName}" FontSize="16"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Grid.Column="0">
                         <TextBlock Text="Number" FontSize="12" Foreground="Gray"/>
                         <TextBlock Text="{Binding Number}" FontSize="16"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                         <TextBlock Text="Pages" FontSize="12" Foreground="Gray"/>
                         <TextBlock Text="{Binding PageCount}" FontSize="16"/>
                      </StackPanel>
                    </Grid>
                    <Button Content="🌐 View Series on Komga" Click="OnViewSeriesOnKomgaClicked" HorizontalAlignment="Stretch" Padding="12,8" Margin="0,8,0,0">
                      <Button.IsVisible>
                         <Binding Path="KomgaSeriesId" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                      </Button.IsVisible>
                    </Button>
                  </StackPanel>
                </Grid>
                <Separator Background="Gray" Opacity="0.3"/>
                <StackPanel IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="Summary" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="14" Opacity="0.9"/>
                </StackPanel>
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <Button Content="📖 Read Now" Command="{Binding ((vm:LibraryViewModel)DataContext).OpenComicCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="16,12" HorizontalContentAlignment="Center"/>
                  <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ((vm:LibraryViewModel)DataContext).ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}" CommandParameter="{Binding}">
                       <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="⭐" IsVisible="{Binding IsFavorite}"/>
                          <TextBlock Text="☆" IsVisible="{Binding !IsFavorite}"/>
                          <TextBlock Text="Favorite" />
                       </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Margin="4,0,0,0" Content="Mark Read" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ((vm:LibraryViewModel)DataContext).ToggleReadStatusCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}" CommandParameter="{Binding}"/>
                  </Grid>
                  <Button Content="🗑️ Delete Comic" Background="#D32F2F" Foreground="White" Command="{Binding ((vm:LibraryViewModel)DataContext).DeleteComicCommand, RelativeSource={RelativeSource AncestorType=views:LibraryView}}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="12,8" HorizontalContentAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </Border>
    </Panel>
  </Grid>
</UserControl>
